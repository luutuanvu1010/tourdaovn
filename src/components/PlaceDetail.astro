---
import type { PlaceResult, Lang } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy, typeLabel as lookupLabel, PLACE_TYPE_LABELS } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import Section from './Section.astro'
import Body from './Body.astro'
import FAQ from './FAQ.astro'
import MapView from './MapView.astro'
import Card from './Card.astro'
import { entityPageGraphToLd, placeToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import { entityHref } from '../lib/homepage'

export interface Props {
  data: PlaceResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
}

const { data, lang, nearby = [] } = Astro.props

const t = uiCopy(lang)

const typeLabel = lookupLabel(PLACE_TYPE_LABELS, lang, data.placeType)

// Phù hiệu hero: loại địa danh (§3 "Nhãn loại entity", `placeType`).
const heroBadges = [typeLabel].filter((x): x is string => !!x)

// Neo chỉ trỏ tới mục thật sự render — khối vắng mà vẫn để neo là link chết.
const jumpLinks = [
  { id: 'highlights', label: t('highlights'), on: !!data.highlights?.length },
  { id: 'details', label: t('details'), on: !!data.body?.length },
  { id: 'access', label: t('howToGetThere'), on: !!data.accessInfo?.length },
  { id: 'experiences', label: t('experiencesHere'), on: !!data.experiences?.length },
  { id: 'faq', label: t('faqHeading'), on: !!data.faq?.length },
].filter(x => x.on).map(x => ({ href: `#${x.id}`, label: x.label }))

function hasPtContent(blocks: unknown[] | undefined | null): boolean {
  if (!blocks || blocks.length === 0) return false
  return blocks.some((b: any) => b._type === 'block' && b.children?.some((c: any) => (c.text || '').trim()))
}

// Một field một vùng (06 §6 Luật 1). Template khai DỮ LIỆU, không chọn vùng.
// containedInPlace KHÔNG vào đây: 06 §3 nói cha chỉ hiện ở breadcrumb — trước
// đây in ở cả InfoBar lẫn InfoCard, vi phạm đang chạy thật. placeType cũng
// không vào đây: huy hiệu hero, và chỉ ở đó (§3.1) — cũng đang lặp hai vùng.
const facts = [
  { field: 'openingHours', icon: '🕐', label: t('hours'), value: data.openingHours ? [data.openingHours.open, data.openingHours.close].filter(Boolean).join(' - ') : '', visible: !!data.openingHours },
  { field: 'address', icon: '📍', label: t('address'), value: data.address ? [data.address.street, data.address.ward].filter(Boolean).join(', ') : '', visible: !!data.address },
  { field: 'isAccessibleForFree', icon: '🎫', label: t('admission'), value: t('free'), visible: data.isAccessibleForFree === true },
]

const siteBase = siteBaseUrl(Astro.site)
const jsonLd = entityPageGraphToLd(placeToJsonLd(data, siteBase, lang), data, siteBase, lang)
---

<DetailLayout
  badges={heroBadges}
  summary={data.summary}
  jumpLinks={jumpLinks}
  title={data.title}
  lang={lang}
  entityType="place"
  image={data.mainImage}
  gallery={data.gallery}
  containedInPlace={data.containedInPlace}
  sameAs={data.sameAs}
  facts={facts}
  sidebarSlots={[
    // 06 §3 hàng "Bản đồ (sidebar)": "chỉ có hasMap thì hiện một link" — thẻ bản
    // đồ phải hiện khi có geo VẼ ĐƯỢC hoặc chỉ có hasMap (không geo). Trước đây
    // chỉ xét geo nên trang chỉ có hasMap (không geo hợp lệ) không có chỗ hiện
    // link — hasMap bị bỏ rơi hoàn toàn, không render ở đâu.
    { name: 'map', component: 'Map', visible: !!(data.geo) || !!(data.hasMap), props: { geo: data.geo, title: data.title } },
  ]}
  nearbyTitle={t('nearby')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <Fragment slot="content">

    {data.highlights && data.highlights.length > 0 && (
      <Section heading={t('highlights')} contained={false} id="highlights">
        <ul class="hl-list">
          {data.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </Section>
    )}

    {hasPtContent(data.body) && (
      <Section heading={t('details')} contained={false} id="details">
        <Body blocks={data.body} />
      </Section>
    )}

    {hasPtContent(data.accessInfo) && (
      <Section heading={t('howToGetThere')} contained={false} id="access">
        <div class="info-callout">
          {data.accessInfo!.map((block: any) => {
            if (block._type === 'block' && block.children) {
              const text = block.children.map((c: any) => c.text || '').join('')
              if (text.trim()) {
                if (block.style === 'normal') return <p>{text}</p>
                return <p><strong>{text}</strong></p>
              }
            }
            return null
          })}
        </div>
      </Section>
    )}

    {data.faq && data.faq.length > 0 && <FAQ faq={data.faq} lang={lang} contained={false} id="faq" />}

    {data.experiences && data.experiences.length > 0 && (
      <Section heading={t('experiencesHere')} contained={false} id="experiences">
        <div class="card-grid">
          {data.experiences.map(exp => (
            <Card
              title={exp.title}
              summary={exp.summary}
              href={entityHref('experience', exp.slug, lang)!}
              image={exp.mainImage?.asset?.url}
              imageAlt={exp.mainImage?.alt || exp.title}
              badge={exp.experienceType}
            />
          ))}
        </div>
      </Section>
    )}
  </Fragment>

  {(data.geo || data.hasMap) && (
    <Fragment slot="map">
      {data.geo && <MapView geo={data.geo} title={data.title} height={240} />}
      {data.hasMap && (
        <a class="map-card-link" data-region="map-card" data-field="hasMap" href={data.hasMap} target="_blank" rel="noopener">
          <span aria-hidden="true">🗺️</span> {t('openMap')}
        </a>
      )}
    </Fragment>
  )}
</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)}></script>

<style>
  .summary-block {
    font-size: var(--fs-h5);
    max-width: 70ch;
    line-height: var(--lh-body);
    font-weight: var(--fw-500);
    font-family: var(--font-ui);
    margin-bottom: var(--s6);
  }

  /* "Cách tới nơi" — với đảo, "đi bằng gì" là câu hỏi đầu tiên của khách, nên
     khối này không được là cỡ chữ nhỏ nhất trang. Nền cát giữ nguyên. */
  .info-callout {
    background: var(--c-sand-soft);
    border: 1px solid var(--c-sand-border);
    border-radius: var(--radius-lg);
    padding: var(--s4) var(--s5);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--c-sand-text);
  }

  .info-callout strong { color: var(--c-sand-text-strong); }
  .info-callout p { margin-bottom: var(--s2); }

  .hl-list { list-style: none; display: flex; flex-direction: column; gap: var(--s2); }
  .hl-list li { font-size: var(--fs-base); color: var(--c-text-muted); padding-left: var(--s5); position: relative; }
  .hl-list li::before { content: "✦"; position: absolute; left: 0; color: var(--c-primary); font-size: var(--fs-xs); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s5);
  }

  @media (max-width: 1023px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
