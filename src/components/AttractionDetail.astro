---
import type { AttractionResult, Lang, SiteContact } from '../lib/types'
import { siteBaseUrl, hostLabel } from '../lib/siteUrl'
import { uiCopy, typeLabel as lookupLabel, ATTRACTION_TYPE_LABELS } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import Section from './Section.astro'

import FAQ from './FAQ.astro'
import BookingCTA from './BookingCTA.astro'
import Body from './Body.astro'
import MapView from './MapView.astro'
import Card from './Card.astro'
import { applyPriceToJsonLd, attractionToJsonLd, entityPageGraphToLd, jsonLdScriptContent } from '../lib/serialize'
import { loadPrices } from '../lib/prices'
import { resolvePrice } from '../lib/resolver'
import { entityHref } from '../lib/homepage'

export interface Props {
  data: AttractionResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
  contact?: SiteContact | null
}

const { data, lang, nearby = [], contact = null } = Astro.props

const t = uiCopy(lang)

const typeLabel = lookupLabel(ATTRACTION_TYPE_LABELS, lang, data.attractionType)

// Phù hiệu hero: loại điểm tham quan (§3 "Nhãn loại entity", `attractionType`).
// Trước đây nhãn này nằm trong thân bài dưới dạng `.cat-row`, còn hero trống —
// khác hẳn trang địa danh dù hai trang dùng chung khung.
const heroBadges = [typeLabel].filter((x): x is string => !!x)

function hasPtContent(blocks: unknown[] | undefined | null): boolean {
  if (!blocks || blocks.length === 0) return false
  return blocks.some((b: any) => b._type === 'block' && b.children?.some((c: any) => (c.text || '').trim()))
}

const prices = loadPrices('data/prices.yaml')
const priceView = resolvePrice(data.bookingRef?.key, 'attraction', data.isAccessibleForFree, prices, lang)
const siteBase = siteBaseUrl(Astro.site)
const entityJsonLd = applyPriceToJsonLd(
  attractionToJsonLd(data, siteBase, lang),
  priceView, data.bookingRef?.key,
)
const jsonLd = entityPageGraphToLd(entityJsonLd, data, siteBase, lang)

// Neo chỉ trỏ tới mục thật sự render — khối vắng mà vẫn để neo là link chết.
const jumpLinks = [
  { id: 'highlights', label: t('highlights'), on: !!data.highlights?.length },
  { id: 'overview', label: t('overview'), on: hasPtContent(data.body) },
  { id: 'access', label: t('howToGetThere'), on: hasPtContent(data.accessInfo) },
  { id: 'experiences', label: t('experiencesHere'), on: !!data.experiences?.length },
  { id: 'faq', label: t('faqHeading'), on: !!data.faq?.length },
].filter(x => x.on).map(x => ({ href: `#${x.id}`, label: x.label }))

// Đặt vé đi qua Zalo — kênh đặt chỗ duy nhất của site (00 §3, R6). Trước đây
// nút này trỏ `#booking-<key>`, một neo tới phần tử không tồn tại trên trang:
// đúng là "CTA giả" mà R4 cấm. Không có zaloUrl thì không render nút.
const bookingHref = contact?.zaloUrl || ''

// Một field một vùng (06 §6 Luật 1). Template khai DỮ LIỆU, không chọn vùng —
// trước đây cùng bộ field này đi vào cả InfoBar lẫn InfoCard, đó là DR-032.
// Giá KHÔNG ở đây: 06 §3.1 khai giá → thanh dính + khối hành động.
const facts = [
  { field: 'openingHours', icon: '🕐', label: t('hours'), value: data.openingHours ? [data.openingHours.open, data.openingHours.close].filter(Boolean).join(' - ') : '', visible: !!data.openingHours },
  { field: 'address', icon: '📍', label: t('address'), value: data.address ? [data.address.street, data.address.ward].filter(Boolean).join(', ') : '', visible: !!data.address },
  { field: 'telephone', icon: '📞', label: t('phone'), value: data.telephone || '', visible: !!data.telephone },
  { field: 'isAccessibleForFree', icon: '🎫', label: t('admission'), value: t('free'), visible: data.isAccessibleForFree === true },
  { field: 'officialSource', icon: '🔗', label: t('officialWebsite'), value: hostLabel(data.officialSource), href: data.officialSource || undefined, visible: !!data.officialSource },
]
---

<DetailLayout
  title={data.title}
  lang={lang}
  entityType="attraction"
  image={data.mainImage}
  gallery={data.gallery}
  containedInPlace={data.containedInPlace}
  sameAs={data.sameAs}
  badges={heroBadges}
  summary={data.summary}
  jumpLinks={jumpLinks}
  priceLabel={priceView?.label ?? null}
  ctaHref={bookingHref || null}
  ctaLabel={bookingHref ? t('contactZalo') : null}
  facts={facts}
  sidebarSlots={[
    { name: 'booking', component: 'BookingCTA', visible: !!priceView?.label, props: { priceText: priceView?.label || '', ctaLabel: t('bookTicket'), ctaUrl: bookingHref || undefined } },
    { name: 'map', component: 'Map', visible: !!(data.geo), props: { geo: data.geo, title: data.title } },
  ]}
  nearbyTitle={t('nearby')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <Fragment slot="content">
    {/* Nhãn loại và `summary` đã lên hero qua DetailLayout — không lặp lại. */}
    {data.highlights && data.highlights.length > 0 && (
      <Section heading={t('highlights')} contained={false} id="highlights">
        <ul class="hl-list">
          {data.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </Section>
    )}

    {hasPtContent(data.body) && (
      <Section heading={t('overview')} contained={false} id="overview">
        <Body blocks={data.body} />
      </Section>
    )}

    {hasPtContent(data.accessInfo) && (
      <Section heading={t('howToGetThere')} contained={false} id="access">
        <div class="info-callout">
          {data.accessInfo!.map((block: any) => {
            if (block._type === 'block' && block.children) {
              const text = block.children.map((c: any) => c.text || '').join('')
              if (text.trim()) {
                if (block.style === 'normal') return <p>{text}</p>
                return <p><strong>{text}</strong></p>
              }
            }
            return null
          })}
        </div>
      </Section>
    )}

    {data.faq && data.faq.length > 0 && <FAQ faq={data.faq} lang={lang} contained={false} id="faq" />}

    {data.experiences && data.experiences.length > 0 && (
      <Section heading={t('experiencesHere')} contained={false} id="experiences">
        <div class="card-grid">
          {data.experiences.map(exp => (
            <Card
              title={exp.title}
              summary={exp.summary}
              href={entityHref('experience', exp.slug, lang)!}
              image={exp.mainImage?.asset?.url}
              imageAlt={exp.mainImage?.alt || exp.title}
              badge={exp.experienceType}
            />
          ))}
        </div>
      </Section>
    )}
  </Fragment>

  {priceView?.label && (
    <BookingCTA slot="booking" priceText={priceView.label} ctaLabel={t('bookTicket')} ctaUrl={bookingHref || undefined} />
  )}
  {data.geo && <MapView slot="map" geo={data.geo} title={data.title} height={240} />}
</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)}></script>

<style>
  /* "Cách tới nơi" — với đảo và công viên trên đảo, "đi bằng gì" là câu hỏi
     đầu tiên của khách, nên khối này không được là cỡ chữ nhỏ nhất trang.
     Nền cát giữ nguyên: cát là màu của ghi chú. */
  .info-callout {
    background: var(--c-sand-soft);
    border: 1px solid var(--c-sand-border);
    border-radius: var(--radius-lg);
    padding: var(--s4) var(--s5);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--c-sand-text);
  }
  .info-callout strong { color: var(--c-sand-text-strong); }
  .info-callout p { margin-bottom: var(--s2); }

  .hl-list { list-style: none; display: flex; flex-direction: column; gap: var(--s2); }
  .hl-list li { font-size: var(--fs-base); color: var(--c-text-muted); padding-left: var(--s5); position: relative; }
  .hl-list li::before { content: "✦"; position: absolute; left: 0; color: var(--c-primary); font-size: var(--fs-xs); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s5);
  }

  @media (max-width: 1023px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
