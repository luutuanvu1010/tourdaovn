---
import Card from './Card.astro'
import Section from './Section.astro'
import { entityHref } from '../lib/homepage'
import { imageUrl } from '../lib/sanity-image'
import type { EntityRef, HomepageArticleCard, HomepagePlaceCard, Lang } from '../lib/types'

type HomeCard = EntityRef | HomepagePlaceCard | HomepageArticleCard

export interface Props {
  heading: string
  items?: HomeCard[]
  lang: Lang
  viewAllLabel: string
  viewAllHref?: string
  badgeLabel?: string
}

const {
  heading,
  lang,
  viewAllLabel,
  viewAllHref,
  badgeLabel,
} = Astro.props
const items = Array.isArray(Astro.props.items) ? Astro.props.items : []

const cards = items
  .map(item => ({
    item,
    href: entityHref(item._type, item.slug, lang),
    image: imageUrl(item.mainImage, { width: 520 }),
  }))
  .filter(card => card.href && card.item.title && card.item.summary)
---

{cards.length > 0 && (
  <Section heading={heading}>
    <div class="home-card-grid">
      {cards.map(({ item, href, image }) => (
        <Card
          title={item.title}
          summary={item.summary || ''}
          href={href!}
          image={image}
          imageAlt={item.mainImage?.alt || item.title}
          badge={badgeLabel}
          authorLabel={'author' in item && item.author?.title ? item.author.title : undefined}
        />
      ))}
    </div>
    {viewAllHref && (
      <a class="home-view-all" href={viewAllHref}>{viewAllLabel}</a>
    )}
  </Section>
)}

<style>
  .home-card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* Lưới này chạy KHÔNG CÓ RÃNH cho tới 2026-08-25. Dòng `gap` duy nhất của
       file nằm TRẦN trong `@media (max-width: 767px)` — không thuộc bộ chọn nào
       — nên trình duyệt vứt nguyên khai báo. Kiểm trên CSS đã dựng: 11 luật của
       `.home-card-grid`, không luật nào có `gap`. Thẻ có viền 1px và đổ bóng nên
       chúng dán sát vào nhau thành một mảng liền. Xem DR-062. */
    gap: var(--s5);
  }

  /* ── Lưới thích ứng theo SỐ MỤC THẬT (bàn giao bước 7) ──
     Dataset đang rất mỏng: nhiều khối chỉ có 1 mục. Lưới 4 cột cứng để một thẻ
     dọc nằm lẻ loi bên trái, trông như trang lỗi. Ba luật dưới đây sửa việc đó
     bằng :has(), không cần JS và không cần biết trước số mục. */

  /* 1 mục → thẻ nằm ngang chiếm trọn chiều rộng */
  .home-card-grid:has(> :last-child:nth-child(1)) {
    grid-template-columns: 1fr;
  }

  .home-card-grid:has(> :last-child:nth-child(1)) :global(.card) {
    display: grid;
    grid-template-columns: minmax(0, 42%) 1fr;
    align-items: stretch;
  }

  .home-card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
    height: 100%;
    min-height: 240px;
  }

  /* 2 mục → 2 cột, 3 mục → 3 cột. Không để hàng cuối lẻ một thẻ. */
  .home-card-grid:has(> :last-child:nth-child(2)) {
    grid-template-columns: repeat(2, 1fr);
  }

  .home-card-grid:has(> :last-child:nth-child(3)) {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 767px) {
    .home-card-grid:has(> :last-child:nth-child(1)) :global(.card) {
      grid-template-columns: 1fr;
    }
    .home-card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
      min-height: 0;
    }

    /* Rãnh hẹp lại ở khổ nhỏ. Trước đây khai báo này đứng TRẦN ngay đây, ngoài
       mọi bộ chọn, nên bị vứt — đó là lý do lưới chạy không rãnh suốt. */
    .home-card-grid {
      gap: var(--s4);
    }
  }

  .home-view-all {
    display: inline-flex;
    margin-top: var(--s5);
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-primary);
    transition: color var(--m-fast) var(--m-ease);
  }

  .home-view-all:hover {
    color: var(--c-primary-strong);
  }

  /* ── Thu hẹp theo bề ngang ──
     Ba khối dưới phải nhắc LẠI các bộ chọn `:has()` ở trên, không được để
     `.home-card-grid` trần. Lý do là độ đặc hiệu, không phải thứ tự:
     `.home-card-grid:has(> :last-child:nth-child(3))` là (0,3,0) vì `:has()`
     lấy độ đặc hiệu của đối số bên trong, còn `.home-card-grid` trần chỉ (0,1,0).
     Đặc hiệu cao thắng bất kể đứng trước hay sau, nên bản cũ để khối **đúng 2
     hoặc 3 mục** giữ nguyên số cột xuống tới màn hình nhỏ nhất — đo được trên
     trang chủ production ngày 2026-08-25: 3 cột, mỗi ô 119px ở khung 390px.
     Khối 4 mục thì không luật `:has()` nào khớp nên vẫn thu đúng — đó là vì sao
     hai lưới cạnh nhau cho hai kết quả khác hẳn, và vì sao lỗi sống lâu.
     Số cột thật = nhỏ hơn giữa (số mục) và (mức bề ngang cho phép). Xem DR-062. */

  @media (max-width: 1024px) {
    /* --bp-lg · trần 3 cột. Khối 1-2-3 mục đã ≤ 3 nên không cần nhắc lại. */
    .home-card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    /* --bp-md · trần 2 cột. Phải hạ khối 3 mục xuống theo. */
    .home-card-grid,
    .home-card-grid:has(> :last-child:nth-child(3)) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    /* --bp-sm · Luật 5 (06 §6): mọi lưới thành hàng trải hết bề ngang. */
    .home-card-grid,
    .home-card-grid:has(> :last-child:nth-child(2)),
    .home-card-grid:has(> :last-child:nth-child(3)) {
      grid-template-columns: 1fr;
    }

    /* R1 chỉ thắng ở đây nếu nhắc lại NGUYÊN bộ chọn :has(). Để `.card` trần là
       thua đặc hiệu — (0,2,0) so với (0,5,0) — đúng lỗi DR-062.
       height PHẢI là 88px tường minh, KHÔNG dùng `auto`: align-items:stretch nằm ở
       luật gốc ngoài mọi media query (:83) nên vẫn sống ở đây, và một grid item
       đang stretch mà height:auto thì giãn hết chiều cao hàng, aspect-ratio bị bỏ
       qua — ra đúng cột ảnh 88px cao hết thẻ, y hệt lỗi height:100%. */
    .home-card-grid:has(> :last-child:nth-child(1)) :global(.card) {
      grid-template-columns: 88px 1fr;
      align-items: start;
    }

    .home-card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
      height: 88px;
      min-height: 0;
    }
  }
</style>
