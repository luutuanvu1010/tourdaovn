---
export interface Props {
  heading?: string
  id?: string
  contained?: boolean
}

const { heading, id, contained = true } = Astro.props

// Mục có tiêu đề thì luôn neo được: không truyền id thì sinh từ tiêu đề (bỏ dấu
// tiếng Việt, chữ thường, gạch nối). Trước đây mục nào quên id là thanh dính không
// trỏ tới được — trang tour mất neo "Chi tiết" và "Mùa nào nên đi" (kế hoạch vòng 4, A6).
function slugify(s: string): string {
  return s
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd').replace(/Đ/g, 'D')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
}
const sectionId = id ?? (heading ? slugify(heading) : undefined)
---

<section class="section" {...(sectionId ? { id: sectionId } : {})}>
  <div class:list={{ container: contained }}>
    {heading && (
      <div class="section-head">
        <h2 class="section-title">{heading}</h2>
        <span class="section-underline" aria-hidden="true"></span>
      </div>
    )}
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--s7) 0;
  }

  .section-head {
    margin-bottom: var(--s6);
  }

  /* Tiêu đề mục màu --c-primary để phân biệt với tiêu đề bài (--c-text). */
  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-section);
    font-weight: var(--fw-800);
    color: var(--c-primary);
    line-height: var(--lh-heading);
    letter-spacing: -0.015em;
    margin-bottom: var(--s3);
  }

  /* Gạch chân đặc màu cát theo đúng token. Bản cũ dùng 34px (không có trong
     thang khoảng cách) và gradient pha --c-sand sang --c-green (không phải
     token nào), cộng một đường kẻ mờ ở đầu mỗi mục — cả ba đều là giá trị
     nằm ngoài nguồn token, tức nguồn sự thật thứ hai. */
  .section-underline {
    display: block;
    width: var(--underline-width);
    height: var(--underline-height);
    background: var(--c-sand);
    border-radius: 2px;
  }

  /* Cỡ chữ tiêu đề mục giữ ở ≤768 — đây là luật về CHỮ, không phải về nhịp. */
  @media (max-width: 768px) {
    .section-title {
      font-size: var(--fs-h4);
    }
  }

  /* Nhịp dọc về một mốc duy nhất ≤640 (SPEC-2026-08-29 R3) — CHỈ ở ≤640, không
     phải cả dải máy tính bảng nhỏ. Trước đây ba mốc lẫn nhau (768/767/640) khiến
     các khối rút nhịp ở các viewport khác nhau trong dải 641-768px.
     Bản sửa này KHÔNG thống nhất dải 641–767px: đo trên `/` ở 700px sau khi sửa
     vẫn còn năm cặp đệm phân biệt giữa các khối trang chủ (48/48, 96/96, 48/64,
     64/48, 64/64) — `.section` đã lên var(--s7)=48px (trước là var(--s5)=24px)
     nhưng `.why-section` (HomeTrustBar.astro) vẫn var(--s9)=96px vì nó chỉ hạ ở
     ≤640. Đọc bản này đừng suy ra dải 641–767px đã thống nhất — chỉ ≤640 mới có
     một nhịp chung. */
  @media (max-width: 640px) {
    .section {
      padding: var(--s6) 0;
    }
  }
</style>
