---
export interface Props {
  heading?: string
  id?: string
  contained?: boolean
}

const { heading, id, contained = true } = Astro.props
---

<section class="section" {...(id ? { id } : {})}>
  <div class:list={{ container: contained }}>
    {heading && (
      <div class="section-head">
        <h2 class="section-title">{heading}</h2>
        <span class="section-underline" aria-hidden="true"></span>
      </div>
    )}
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--s7) 0;
  }

  .section::before {
    content: "";
    position: absolute;
    inset: var(--s4) 0 auto;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c-sand) 24%, transparent), transparent);
    opacity: .72;
  }

  .section-head {
    margin-bottom: var(--s6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-800);
    color: var(--c-text);
    line-height: var(--lh-heading);
    letter-spacing: 0;
    margin-bottom: var(--s3);
  }

  .section-underline {
    display: block;
    width: 34px;
    height: 3px;
    background: linear-gradient(90deg, var(--c-sand), color-mix(in srgb, var(--c-green) 38%, var(--c-sand)));
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .section {
      padding: var(--s5) 0;
    }

    .section-title {
      font-size: var(--fs-h4);
    }
  }
</style>
