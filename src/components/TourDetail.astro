---
import type { TourResult, Lang, SiteContact } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy, typeLabel as lookupLabel, TOUR_FORMAT_LABELS } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import FAQ from './FAQ.astro'
import Section from './Section.astro'
import BookingCTA from './BookingCTA.astro'
import ContactChannels from './ContactChannels.astro'
import Body from './Body.astro'
import { applyPriceToJsonLd, entityPageGraphToLd, tourToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import { loadPrices } from '../lib/prices'
import { resolvePrice } from '../lib/resolver'
import { site } from '../site.config'

export interface Props {
  data: TourResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
  contact?: SiteContact | null
}

const { data, lang, nearby = [], contact = null } = Astro.props

const t = uiCopy(lang)

const formatLabel = lookupLabel(TOUR_FORMAT_LABELS, lang, data.tourFormat)

function hasPtContent(blocks: unknown[] | undefined | null): boolean {
  if (!blocks || blocks.length === 0) return false
  return blocks.some((b: any) => b._type === 'block' && b.children?.some((c: any) => (c.text || '').trim()))
}

const prices = loadPrices('data/prices.yaml')
const priceView = resolvePrice(data.bookingRef?.key, 'tour', undefined, prices, lang)

// CTA fallback khi tour chưa có giá (nợ PY8): trỏ website chính thức của operator.
// url là website chính thức, officialSource là bằng chứng đăng ký (§2.9) — ưu tiên url.
// Không có URL nào thì không render nút (cấm nút không hoạt động).
// Bỏ qua URL cùng host với chính site: đơn vị vận hành của mọi tour là Tour Đảo, `url`
// là tourdao.vn, nên trước đây 11/11 trang tour có nút "Website chính thức" trỏ về
// trang chủ của chính nó — nút không hành động, R4 cấm (DR-036).
const siteHost = new URL(site.url).host
function isExternal(u: string | null | undefined): u is string {
  if (!u) return false
  try { return new URL(u).host !== siteHost } catch { return false }
}
const operatorUrl = [data.operator?.url, data.operator?.officialSource].find(isExternal) || ''
const showFallbackCta = !priceView?.label && !!operatorUrl
const hasContactChannel = !!(contact?.zaloUrl || contact?.hotline || contact?.whatsapp)

// Phù hiệu trong hero: CHỈ hình thức tour (§4.8 `tourFormat`) — 06 §3.1 khai
// `duration` → Thông tin nhanh một mình. `data.duration` từng vào đây cùng
// formatLabel nên thời lượng hiện cả hero-badge lẫn fact-strip, hai vùng cho
// một field; huy hiệu hero không mang data-region/data-field nên Luật 1 tầng
// A/B đều không thấy cặp này.
const heroBadges = [formatLabel].filter((x): x is string => !!x)

// Thanh dính: neo tới đúng những mục THẬT SỰ render, nên phải tính sau khi biết
// khối nào có dữ liệu. Khối vắng mà vẫn để neo là link chết.
const jumpLinks = [
  { id: 'itinerary', label: t('itinerary'), on: !!data.itinerary?.length },
  { id: 'includes', label: t('includesExcludes'), on: !!(data.includes?.length || data.excludes?.length) },
  { id: 'highlights', label: t('highlights'), on: !!data.highlights?.length },
  // "Chi tiết" là mục dài nhất trang (978 từ ở tour Deluxe) mà trước đây không có neo;
  // "Mùa nào nên đi" cũng vậy (kế hoạch vòng 4, A6).
  { id: 'details', label: t('details'), on: hasPtContent(data.body) },
  { id: 'season', label: t('bestSeason'), on: !!data.seasonNote },
  { id: 'faq', label: t('faqHeading'), on: !!data.faq?.length },
].filter(x => x.on).map(x => ({ href: `#${x.id}`, label: x.label }))

// CTA trên thanh dính là Zalo — kênh đặt chỗ duy nhất của site (00 §3).
const zaloHref = contact?.zaloUrl || ''

const siteBase = siteBaseUrl(Astro.site)
const entityJsonLd = applyPriceToJsonLd(
  tourToJsonLd(data, siteBase, lang),
  priceView, data.bookingRef?.key,
)
const jsonLd = entityPageGraphToLd(entityJsonLd, data, siteBase, lang)

// Vùng "Thông tin nhanh" — 06 §3.1 Tour: đúng 3 ô (`duration`, `touristType`,
// `tripOrigin` gắn nhãn "Khởi hành"). `tourFormat` đã là huy hiệu hero (chỉ ở
// đó); `seasonNote` đã có mục "Mùa nào nên đi" riêng trong thân bài; giá
// không vào đây (thanh dính + khối hành động).
const facts = [
  { field: 'duration', icon: '⏱️', label: t('duration'), value: data.duration || '', visible: !!data.duration },
  { field: 'touristType', icon: '👤', label: t('suitableFor'), value: data.touristType?.join(', ') || '', visible: !!(data.touristType && data.touristType.length > 0) },
  { field: 'tripOrigin', icon: '📍', label: t('tripOrigin'), value: data.tripOrigin?.title || '', visible: !!data.tripOrigin?.title },
]

// `operator`, `licenseInfo` (06 §3.1: khối hành động) và `departureNote`
// (06 §3.1: ghi chú trong khối hành động) — ba field khác nhau, không gộp.
// `departureNote` và `tripOrigin` (ở trên) cũng là hai field khác nhau dù
// đều nói về nơi/cách khởi hành — gộp là mất thông tin thật (task-7-brief
// "chỗ dễ sai"). Cả ba render trong khối hành động (slot booking), không vào
// `facts`, nên không lặp vùng với giá cũng đang ở đó.
const hasActionMeta = !!(data.operator?.title || data.operator?.licenseInfo || data.departureNote)
---

<DetailLayout
  title={data.title}
  lang={lang}
  entityType="tour"
  image={data.mainImage}
  gallery={data.gallery}
  badges={heroBadges}
  summary={data.summary}
  jumpLinks={jumpLinks}
  priceLabel={priceView?.label ?? null}
  ctaHref={zaloHref || null}
  ctaLabel={zaloHref ? t('contactZalo') : null}
  facts={facts}
  sidebarSlots={[
    { name: 'booking', component: 'BookingCTA', visible: !!priceView?.label || showFallbackCta || hasContactChannel || hasActionMeta, props: {} },
  ]}
  nearbyTitle={t('similarTours')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <div slot="content">
    {data.itinerary && data.itinerary.length > 0 && (
      <Section heading={t('itinerary')} contained={false} id="itinerary">
        <div class="timeline">
          {data.itinerary.map((stop) => (
            <div class="tl-stop">
              <div class="tl-dot"></div>
              <div class="tl-line"></div>
              <div class="tl-content">
                <strong>{stop.place?.title || stop.externalStop?.name || ''}</strong>
                {stop.note && <p>{stop.note}</p>}
                {stop.durationAtStop && <span class="tl-dur">{stop.durationAtStop}</span>}
              </div>
            </div>
          ))}
        </div>
      </Section>
    )}

    {((data.includes && data.includes.length > 0) || (data.excludes && data.excludes.length > 0)) && (
      <Section heading={t('includesExcludes')} contained={false} id="includes">
        <div class="inc-ex-grid">
          {data.includes && data.includes.length > 0 && (
            <div class="inc-ex-card inc-ex-card--in">
              <h5>{t('includes')}</h5>
              <ul class="check-list">
                {data.includes.map((item) => <li><span class="check-icon">&#10003;</span> {item}</li>)}
              </ul>
            </div>
          )}
          {data.excludes && data.excludes.length > 0 && (
            <div class="inc-ex-card">
              <h5>{t('excludes')}</h5>
              <ul class="cross-list">
                {data.excludes.map((item) => <li><span class="cross-icon">&#10007;</span> {item}</li>)}
              </ul>
            </div>
          )}
        </div>
      </Section>
    )}

    {data.highlights && data.highlights.length > 0 && (
      <Section heading={t('highlights')} contained={false} id="highlights">
        <ul class="hl-list">
          {data.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </Section>
    )}

    {hasPtContent(data.body) && (
      <Section heading={t('details')} contained={false} id="details">
        <Body blocks={data.body} headingOffset={1} />
      </Section>
    )}

    {data.seasonNote && (
      <Section heading={t('bestSeason')} contained={false} id="season">
        <div class="info-callout">{data.seasonNote}</div>
      </Section>
    )}

    {data.faq && data.faq.length > 0 && <FAQ faq={data.faq} lang={lang} contained={false} id="faq" />}
  </div>

  {priceView?.label && <BookingCTA slot="booking" priceText={priceView.label} ctaLabel={t('bookTour')} />}
  {showFallbackCta && <BookingCTA slot="booking" ctaUrl={operatorUrl} ctaLabel={t('officialWebsite')} />}
  {hasContactChannel && <ContactChannels slot="booking" contact={contact} lang={lang} />}
  {hasActionMeta && (
    <div class="action-meta" data-region="action-block" slot="booking">
      {data.operator?.title && <p data-field="operator"><strong>{t('operator')}:</strong> {data.operator.title}</p>}
      {data.operator?.licenseInfo && <p data-field="licenseInfo"><strong>{t('license')}:</strong> {data.operator.licenseInfo}</p>}
      {data.departureNote && <p data-field="departureNote">{data.departureNote}</p>}
    </div>
  )}
</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)}></script>

<style>
  .summary-block {
    font-size: var(--fs-h5);
    max-width: 70ch;
    line-height: var(--lh-body);
    font-weight: var(--fw-500);
    font-family: var(--font-ui);
    margin-bottom: var(--s6);
  }

  .timeline { position: relative; padding-left: var(--s5); }
  .tl-stop { position: relative; padding-bottom: var(--s5); }
  .tl-stop:last-child { padding-bottom: 0; }
  .tl-dot { position: absolute; left: calc(-1 * var(--s5) + 4px); top: 4px; width: 10px; height: 10px; border-radius: 50%; background: var(--c-primary); border: 2px solid var(--c-card); z-index: 1; }
  .tl-line { position: absolute; left: calc(-1 * var(--s5) + 8px); top: 18px; bottom: 0; width: 2px; background: var(--c-border); }
  .tl-stop:last-child .tl-line { display: none; }
  .tl-content strong { display: block; font-size: var(--fs-base); font-weight: var(--fw-700); color: var(--c-text); }
  .tl-content p { font-size: var(--fs-sm); color: var(--c-text-muted); margin: var(--s1) 0; }
  .tl-dur { font-size: var(--fs-badge); color: var(--c-text-muted); background: var(--c-surface-alt); padding: 2px 8px; border-radius: var(--radius-pill); }

  /* Đây là "chỗ phát sinh hiểu lầm nhiều nhất" (§2.8), nên hai danh sách cần
     trọng lượng thị giác của một thẻ chứ không phải hai cột chữ trần. Thẻ nào
     không có dữ liệu thì không render, thẻ còn lại chiếm trọn chiều rộng. */
  .inc-ex-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s5); }
  .inc-ex-card {
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--s5);
  }
  .inc-ex-card--in { background: var(--c-primary-soft); border-color: var(--c-primary-soft); }
  .inc-ex-grid h5 { font-family: var(--font-display); font-size: var(--fs-card-title); font-weight: var(--fw-700); margin-bottom: var(--s4); color: var(--c-text); }
  .check-list, .cross-list { list-style: none; display: flex; flex-direction: column; gap: var(--s3); }
  .check-list li { display: flex; gap: var(--s3); align-items: center; font-size: var(--fs-base); }
  .cross-list li { display: flex; gap: var(--s3); align-items: center; font-size: var(--fs-sm); color: var(--c-text-muted); }
  .check-icon { color: var(--c-green); font-weight: var(--fw-700); }
  .cross-icon { color: var(--c-text-muted); font-weight: var(--fw-700); }

  .info-callout { background: var(--c-sand-soft); border: 1px solid var(--c-sand-border); border-radius: var(--radius-lg); padding: var(--s4) var(--s5); font-size: var(--fs-sm); color: var(--c-sand-text); }

  /* Khối hành động: operator/licenseInfo/departureNote — 06 §3.1 đặt cả ba ở
     đây, không ở Thông tin nhanh. Đứng cạnh BookingCTA trong cùng slot
     "booking", không phải một biến thể mới của BookingCTA. */
  .action-meta { display: flex; flex-direction: column; gap: var(--s2); font-size: var(--fs-sm); color: var(--c-text-muted); }
  .action-meta p { margin: 0; }
  .action-meta strong { color: var(--c-text); font-weight: var(--fw-600); }

  .hl-list { list-style: none; display: flex; flex-direction: column; gap: var(--s2); }
  .hl-list li { font-size: var(--fs-sm); color: var(--c-text-muted); padding-left: var(--s5); position: relative; }
  .hl-list li::before { content: "✦"; position: absolute; left: 0; color: var(--c-primary); font-size: var(--fs-xs); }

  @media (max-width: 1023px) {
    .inc-ex-grid { grid-template-columns: 1fr; }
  }
</style>
