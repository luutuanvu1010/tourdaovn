---
import type { HotelResult, Lang, SiteContact } from '../lib/types'
import LodgingDetail from './LodgingDetail.astro'

export interface Props {
  data: HotelResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
  contact?: SiteContact | null
}

const { data, lang, nearby, contact } = Astro.props
---

<LodgingDetail data={data} entityType="hotel" lang={lang} nearby={nearby} contact={contact} />
