---
import type { Lang, EntityRef, ImageAsset, NearbyEntity } from '../lib/types'
import { uiCopy } from '../lib/uiCopy'
import { formatDate } from '../lib/dates'
import Breadcrumb from './Breadcrumb.astro'
import Hero from './Hero.astro'
import InfoBar from './InfoBar.astro'
import type { InfoBarItem } from './InfoBar.astro'
import Sidebar from './Sidebar.astro'
import type { Slot } from './Sidebar.astro'
import NearbySection from './NearbySection.astro'

export interface Props {
  title: string
  lang: Lang
  entityType: string
  image?: string | ImageAsset
  gallery?: ImageAsset[] | null
  containedInPlace?: EntityRef
  infoBarItems?: InfoBarItem[]
  sidebarSlots: Slot[]
  nearbyTitle: string
  nearby: NearbyEntity[]
  updatedAt: string
  /** Phù hiệu ngắn cạnh tiêu đề trong hero — 06-BINDING_MAP §3 "Nhãn loại entity". */
  badges?: string[] | null
  /** Đoạn mở trong hero — §3 "Đoạn mở", `summary`. */
  summary?: string | null
  /** Gắn `data-speakable` lên đoạn mở. Chỉ trang cẩm nang bật, vì chỉ Article
   *  khai `speakable` với cssSelector `[data-speakable]` trong JSON-LD. */
  speakable?: boolean
  /** Mục neo cho thanh dính. Rỗng thì không render thanh. */
  jumpLinks?: { href: string; label: string }[] | null
  /** Nhãn giá đã render sẵn (I16) — null thì thanh dính không hiện vùng giá. */
  priceLabel?: string | null
  /** CTA chính trên thanh dính, thường là Zalo. Thiếu thì không render nút. */
  ctaHref?: string | null
  ctaLabel?: string | null
}

const {
  title, lang, entityType, image, gallery, containedInPlace, infoBarItems,
  sidebarSlots, nearbyTitle, nearby, updatedAt,
  badges, summary, speakable = false, jumpLinks, priceLabel, ctaHref, ctaLabel,
} = Astro.props

const badgeList = badges ?? []
const jumps = jumpLinks ?? []
// Thanh dính chỉ có nghĩa khi có ít nhất một thứ để hiện. Không có thì không
// render — vùng rỗng ẩn hẳn, 06-BINDING_MAP quyết định nền 2.
const showStickyBar = jumps.length > 0 || !!priceLabel || !!(ctaHref && ctaLabel)

// CTA là neo trong trang (#dat-tour) thì không mở tab mới; link ngoài (Zalo) mới mở tab.
const ctaExternal = !!ctaHref && !ctaHref.startsWith('#')

const t = uiCopy(lang)
---

<Hero image={image} gallery={gallery} fullBleed>
  <Breadcrumb slot="overlay" containedInPlace={containedInPlace} entityType={entityType} lang={lang} currentTitle={title} inverse />
  {badgeList.length > 0 && (
    <div slot="overlay" class="detail-badges">
      {badgeList.map(b => <span class="detail-badge">{b}</span>)}
    </div>
  )}
  <h1 slot="overlay" class="detail-title">{title}</h1>
  {summary && <p slot="overlay" class="detail-summary" {...(speakable ? { 'data-speakable': true } : {})}>{summary}</p>}
</Hero>

{showStickyBar && (
  <div class="sticky-bar">
    <div class="container sticky-bar__inner">
      <nav class="sticky-bar__jump" aria-label={title}>
        {jumps.map(j => <a href={j.href}>{j.label}</a>)}
      </nav>
      <div class="sticky-bar__action">
        {priceLabel && <span class="sticky-bar__price">{priceLabel}</span>}
        {ctaHref && ctaLabel && (
          <a class="sticky-bar__cta" href={ctaHref} {...(ctaExternal ? { target: '_blank', rel: 'noopener' } : {})}>{ctaLabel}</a>
        )}
      </div>
    </div>
  </div>
)}

{infoBarItems && infoBarItems.length > 0 && <InfoBar items={infoBarItems} />}

<div class="container two-col">
  <div class="content-main">
    <slot name="content" />

    <div class="updated-section">
      <div class="updated">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {t('updated')} {formatDate(updatedAt, lang)}
      </div>
    </div>
  </div>

  {/* stickyBar: Sidebar cộng chiều cao thanh dính vào chỗ dính của nó (DR-033). */}
  <Sidebar slots={sidebarSlots} stickyBar={showStickyBar}>
    <slot name="booking" slot="booking" />
    <slot name="info" slot="info" />
    <slot name="map" slot="map" />
    <slot name="about" slot="about" />
  </Sidebar>
</div>

{nearby.length > 0 && <NearbySection title={nearbyTitle} entities={nearby} lang={lang} />}

<style>
  .detail-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .detail-badge {
    padding: var(--badge-py) var(--badge-px);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text-inverse) 22%, transparent);
    color: var(--c-text-inverse);
    font-size: var(--fs-label);
    font-weight: var(--fw-600);
    backdrop-filter: blur(4px);
  }

  .detail-summary {
    max-width: 62ch;
    color: var(--c-text-inverse);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    opacity: 0.92;
  }

  /* Thanh dính: neo mục + giá + CTA. Bám dưới header nên dùng --header-h. */
  .sticky-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 90;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  /* Cao cố định theo token để Sidebar tính được chỗ dính (DR-033); trước đây cao
     theo nội dung nên không ai cộng được. */
  .sticky-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    height: var(--sticky-bar-h);
  }

  .sticky-bar__jump {
    display: flex;
    gap: var(--s5);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sticky-bar__jump::-webkit-scrollbar { display: none; }

  .sticky-bar__jump {
    align-self: stretch;
  }

  .sticky-bar__jump a {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--m-fast) var(--m-ease), border-color var(--m-fast) var(--m-ease);
  }

  .sticky-bar__jump a:hover {
    color: var(--c-primary);
    border-bottom-color: var(--c-primary);
  }

  .sticky-bar__action {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-shrink: 0;
  }

  .sticky-bar__price {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: var(--fw-800);
    color: var(--c-primary-strong);
    white-space: nowrap;
  }

  .sticky-bar__cta {
    padding: var(--s3) var(--s5);
    border-radius: var(--radius-pill);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-size: var(--fs-sm);
    font-weight: var(--fw-700);
    white-space: nowrap;
    transition: background var(--m-fast) var(--m-ease);
  }

  .sticky-bar__cta:hover { background: var(--c-accent-strong); }

  @media (max-width: 767px) {
    .sticky-bar__jump { display: none; }
    .sticky-bar__inner { justify-content: flex-end; }
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(var(--fs-h3), 4.2vw, var(--fs-hero));
    font-weight: var(--fw-800);
    color: var(--c-text-inverse);
    /* 1.06 là giá trị cứng ngoài token và ở cỡ hero nó làm dấu ngã dòng dưới
       chạm dấu nặng dòng trên — đúng lỗi Design nêu. --lh-display là bậc riêng
       cho chữ hiển thị lớn, duyệt 2026-08-06. */
    line-height: var(--lh-display);
    text-wrap: balance;
    padding-bottom: var(--s2);
    margin: 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
    padding-bottom: var(--s7);
  }

  .updated-section {
    padding-top: var(--s4);
  }

  .updated {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    padding: var(--s4) 0;
    border-top: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .updated svg {
    color: var(--c-primary);
  }

  @media (max-width: 1023px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
