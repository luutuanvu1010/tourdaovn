---
import type { Lang, EntityRef, ImageAsset, NearbyEntity } from '../lib/types'
import { uiCopy } from '../lib/uiCopy'
import { formatDate } from '../lib/dates'
import { hostLabel } from '../lib/siteUrl'
import Breadcrumb from './Breadcrumb.astro'
import Hero from './Hero.astro'
import FactStrip from './FactStrip.astro'
import type { Fact } from './FactStrip.astro'
import Sidebar from './Sidebar.astro'
import type { Slot } from './Sidebar.astro'
import NearbySection from './NearbySection.astro'

export interface Props {
  title: string
  lang: Lang
  entityType: string
  image?: string | ImageAsset
  gallery?: ImageAsset[] | null
  containedInPlace?: EntityRef
  /** Dòng "Nguồn tham khảo" cạnh Cập nhật — 06 §3.1: `sameAs` chỉ render Ở ĐÂY,
   *  KHÔNG vào Thông tin nhanh, KHÔNG vào sidebar. Chỉ mục đầu mảng; rỗng thì
   *  ẩn cả dòng. */
  sameAs?: string[] | null
  /** Vùng "Thông tin nhanh" — 06 §3.1. Nơi DUY NHẤT của các field ngắn. */
  facts?: Fact[]
  /** Trần số ô hiển thị ở `FactStrip`. Không truyền = mặc định 6 (hợp đồng 06
   *  §3.1 cho bốn entity có hàng trong ma trận). Entity không có hàng ở §3.1
   *  (vd khách sạn — chỉ ràng buộc bởi Luật 1, không ràng buộc trần 6) truyền
   *  cao hơn qua đây. Task 7 fix round, 2026-08-23. */
  factsMax?: number
  /** @deprecated Không còn render gì — `InfoBar` đã gỡ (Task 7 fix round,
   *  2026-08-23, LodgingDetail là template cuối chuyển sang `facts`). Giữ
   *  prop này (kiểu lỏng, không còn phụ thuộc `InfoBar.astro`) chỉ để
   *  `ArticleDetail`/`OrganizationDetail`/`PersonDetail` — ba template ngoài
   *  phạm vi việc đóng Luật 1, vẫn dùng `InfoCard` trực tiếp qua slot `info`,
   *  xem DRIFT_LOG DR-046 — khỏi vỡ kiểu vì vẫn truyền `infoBarItems={[]}`.
   *  Xoá hẳn khi ba template đó cũng dọn theo. */
  infoBarItems?: unknown[]
  sidebarSlots: Slot[]
  nearbyTitle: string
  nearby: NearbyEntity[]
  updatedAt: string
  /** Phù hiệu ngắn cạnh tiêu đề trong hero — 06-BINDING_MAP §3 "Nhãn loại entity". */
  badges?: string[] | null
  /** Đoạn mở trong hero — §3 "Đoạn mở", `summary`. */
  summary?: string | null
  /** Gắn `data-speakable` lên đoạn mở. Chỉ trang cẩm nang bật, vì chỉ Article
   *  khai `speakable` với cssSelector `[data-speakable]` trong JSON-LD. */
  speakable?: boolean
  /** Mục neo cho thanh dính. Rỗng thì không render thanh. */
  jumpLinks?: { href: string; label: string }[] | null
  /** Nhãn giá đã render sẵn (I16) — null thì thanh dính không hiện vùng giá. */
  priceLabel?: string | null
  /** CTA chính trên thanh dính, thường là Zalo. Thiếu thì không render nút. */
  ctaHref?: string | null
  ctaLabel?: string | null
}

const {
  title, lang, entityType, image, gallery, containedInPlace, sameAs, facts, factsMax,
  sidebarSlots, nearbyTitle, nearby, updatedAt,
  badges, summary, speakable = false, jumpLinks, priceLabel, ctaHref, ctaLabel,
} = Astro.props

const badgeList = badges ?? []
const jumps = jumpLinks ?? []
// Thanh dính chỉ có nghĩa khi có ít nhất một thứ để hiện. Không có thì không
// render — vùng rỗng ẩn hẳn, 06-BINDING_MAP quyết định nền 2.
const showStickyBar = jumps.length > 0 || !!priceLabel || !!(ctaHref && ctaLabel)

// Hợp đồng 06: "≤ 2 ô thì không trải dải" — gộp vào sidebar cạnh bản đồ.
const factsVisible = (facts ?? []).filter(f => f.visible)
const factsInline = factsVisible.length > 0 && factsVisible.length <= 2

// Sidebar chỉ dựng một slot khi mảng `slots` có mục cùng tên VÀ visible. Truyền
// <FactStrip slot="info"> mà không thêm mục thì slot câm — nên DetailLayout tự
// chèn mục đó, chứ không bắt sáu template mỗi cái tự nhớ.
const effectiveSlots = factsInline
  ? (() => {
      const i = sidebarSlots.findIndex(s => s.name === 'map')
      const row = { name: 'info', component: 'custom' as const, visible: true, props: {} }
      const out = [...sidebarSlots]
      out.splice(i >= 0 ? i : out.length, 0, row)   // đứng ngay TRƯỚC bản đồ
      return out
    })()
  : sidebarSlots

// "Nguồn tham khảo" — 06 §3.1: hàng riêng cạnh Cập nhật ở cuối nội dung, KHÔNG
// vào Thông tin nhanh (đã tách khỏi `facts` ở AttractionDetail/PlaceDetail),
// KHÔNG vào sidebar. Giá trị là nhãn theo host, y hệt InfoCard cũ đã làm.
const sameAsHref = sameAs && sameAs.length > 0 ? sameAs[0] : null
const sameAsLabel = sameAsHref ? hostLabel(sameAsHref) : ''

const t = uiCopy(lang)
---

<Hero image={image} gallery={gallery} fullBleed>
  <Breadcrumb slot="overlay" containedInPlace={containedInPlace} entityType={entityType} lang={lang} currentTitle={title} inverse />
  {badgeList.length > 0 && (
    <div slot="overlay" class="detail-badges">
      {badgeList.map(b => <span class="detail-badge">{b}</span>)}
    </div>
  )}
  <h1 slot="overlay" class="detail-title">{title}</h1>
  {summary && <p slot="overlay" class="detail-summary" {...(speakable ? { 'data-speakable': true } : {})}>{summary}</p>}
</Hero>

{showStickyBar && (
  <div class="sticky-bar">
    <div class="container sticky-bar__inner">
      <nav class="sticky-bar__jump" aria-label={title}>
        {jumps.map(j => <a href={j.href}>{j.label}</a>)}
      </nav>
      <div class="sticky-bar__action">
        {priceLabel && <span class="sticky-bar__price" data-region="sticky-bar" data-field="gia">{priceLabel}</span>}
        {ctaHref && ctaLabel && (
          <a class="sticky-bar__cta" href={ctaHref} target="_blank" rel="noopener">{ctaLabel}</a>
        )}
      </div>
    </div>
  </div>
)}

{!factsInline && factsVisible.length > 0 && <FactStrip facts={facts!} max={factsMax} />}

<div class="container two-col">
  <div class="content-main">
    <slot name="content" />

    <div class="updated-section">
      <div class="updated-row">
        <div class="updated">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {t('updated')} {formatDate(updatedAt, lang)}
        </div>
        {sameAsHref && (
          <div class="reference-source" data-region="section" data-field="sameAs">
            <span aria-hidden="true">🔗</span>
            {t('referenceSource')}: <a href={sameAsHref} target="_blank" rel="noopener">{sameAsLabel}</a>
          </div>
        )}
      </div>
    </div>
  </div>

  {/* stickyBar: Sidebar cộng chiều cao thanh dính vào chỗ dính của nó (DR-033). */}
  <Sidebar slots={effectiveSlots} stickyBar={showStickyBar}>
    <slot name="booking" slot="booking" />
    {/* Forward cho InfoCard — VẪN CẦN, không phải hàng chết. Ba template
       ngoài phạm vi việc đóng Luật 1 (ArticleDetail, OrganizationDetail,
       PersonDetail — không có hàng ở 06 §3.1, không dùng FactStrip) vẫn
       truyền <InfoCard slot="info"> qua đây. Mọi template có hàng ở §3.1 đã
       chuyển sang `facts` không truyền gì vào slot này nên nhánh trống, không
       render thừa. Xem DRIFT_LOG DR-046 — không xoá tới khi ba template đó
       cũng chuyển hoặc có quyết định khác. */}
    <slot name="info" slot="info" />
    {factsInline && <FactStrip facts={facts!} inline max={factsMax} slot="info" />}
    <slot name="map" slot="map" />
    <slot name="about" slot="about" />
  </Sidebar>
</div>

{nearby.length > 0 && <NearbySection title={nearbyTitle} entities={nearby} lang={lang} />}

<style>
  .detail-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .detail-badge {
    padding: var(--badge-py) var(--badge-px);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text-inverse) 22%, transparent);
    color: var(--c-text-inverse);
    font-size: var(--fs-label);
    font-weight: var(--fw-600);
    backdrop-filter: blur(4px);
  }

  .detail-summary {
    max-width: 62ch;
    color: var(--c-text-inverse);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    opacity: 0.92;
  }

  /* Thanh dính: neo mục + giá + CTA. Bám dưới header nên dùng --header-h. */
  .sticky-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 90;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  /* Cao cố định theo token để Sidebar tính được chỗ dính (DR-033); trước đây cao
     theo nội dung nên không ai cộng được. */
  .sticky-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    height: var(--sticky-bar-h);
  }

  .sticky-bar__jump {
    display: flex;
    gap: var(--s5);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sticky-bar__jump::-webkit-scrollbar { display: none; }

  .sticky-bar__jump {
    align-self: stretch;
  }

  .sticky-bar__jump a {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--m-fast) var(--m-ease), border-color var(--m-fast) var(--m-ease);
  }

  .sticky-bar__jump a:hover {
    color: var(--c-primary);
    border-bottom-color: var(--c-primary);
  }

  .sticky-bar__action {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-shrink: 0;
  }

  .sticky-bar__price {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: var(--fw-800);
    color: var(--c-primary-strong);
    white-space: nowrap;
  }

  .sticky-bar__cta {
    padding: var(--s3) var(--s5);
    border-radius: var(--radius-pill);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-size: var(--fs-sm);
    font-weight: var(--fw-700);
    white-space: nowrap;
    transition: background var(--m-fast) var(--m-ease);
  }

  .sticky-bar__cta:hover { background: var(--c-accent-strong); }

  @media (max-width: 767px) {
    .sticky-bar__jump { display: none; }
    .sticky-bar__inner { justify-content: flex-end; }
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(var(--fs-h3), 4.2vw, var(--fs-hero));
    font-weight: var(--fw-800);
    color: var(--c-text-inverse);
    /* 1.06 là giá trị cứng ngoài token và ở cỡ hero nó làm dấu ngã dòng dưới
       chạm dấu nặng dòng trên — đúng lỗi Design nêu. --lh-display là bậc riêng
       cho chữ hiển thị lớn, duyệt 2026-08-06. */
    line-height: var(--lh-display);
    text-wrap: balance;
    padding-bottom: var(--s2);
    margin: 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
    padding-bottom: var(--s7);
  }

  .updated-section {
    padding-top: var(--s4);
  }

  /* Một hàng chung border-top cho cả "Cập nhật" và "Nguồn tham khảo" — 06 §3.1
     đặt hai dòng này cạnh nhau ở cuối nội dung. */
  .updated-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-top: 1px solid var(--c-border);
  }

  .updated,
  .reference-source {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .updated svg {
    color: var(--c-primary);
  }

  .reference-source a {
    color: var(--c-primary);
    text-decoration: none;
    font-weight: var(--fw-600);
  }

  .reference-source a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
