---
import type { Lang, EntityRef, ImageAsset, NearbyEntity } from '../lib/types'
import { uiCopy } from '../lib/uiCopy'
import { formatDate } from '../lib/dates'
import { hostLabel } from '../lib/siteUrl'
import PageHead from './PageHead.astro'
import Hero from './Hero.astro'
import FactStrip from './FactStrip.astro'
import type { Fact } from './FactStrip.astro'
import Sidebar from './Sidebar.astro'
import type { Slot } from './Sidebar.astro'
import NearbySection from './NearbySection.astro'

export interface Props {
  title: string
  lang: Lang
  entityType: string
  image?: string | ImageAsset
  gallery?: ImageAsset[] | null
  containedInPlace?: EntityRef
  /** Dòng "Nguồn tham khảo" cạnh Cập nhật — 06 §3.1: `sameAs` chỉ render Ở ĐÂY,
   *  KHÔNG vào Thông tin nhanh, KHÔNG vào sidebar. Chỉ mục đầu mảng; rỗng thì
   *  ẩn cả dòng. */
  sameAs?: string[] | null
  /** Vùng "Thông tin nhanh" — 06 §3.1. Nơi DUY NHẤT của các field ngắn. */
  facts?: Fact[]
  /** Trần số ô hiển thị ở `FactStrip`. Không truyền = mặc định 6 (hợp đồng 06
   *  §3.1 cho bốn entity có hàng trong ma trận). Entity không có hàng ở §3.1
   *  (vd khách sạn — chỉ ràng buộc bởi Luật 1, không ràng buộc trần 6) truyền
   *  cao hơn qua đây. Task 7 fix round, 2026-08-23. */
  factsMax?: number
  sidebarSlots: Slot[]
  nearbyTitle: string
  nearby: NearbyEntity[]
  updatedAt: string
  /** Huy hiệu loại, nay là thứ DUY NHẤT còn nằm trên ảnh hero (06 v2.5) — §3 "Nhãn loại entity". */
  badges?: string[] | null
  /** Đoạn mở — 06 v2.3 chuyển khỏi hero xuống dải sáng SAU thanh dính (`.summary-band`); §3 "Đoạn mở". */
  summary?: string | null
  /** Gắn `data-speakable` lên đoạn mở. Chỉ trang cẩm nang bật, vì chỉ Article
   *  khai `speakable` với cssSelector `[data-speakable]` trong JSON-LD. */
  speakable?: boolean
  /** Mục neo cho thanh dính. Rỗng thì không render thanh. */
  jumpLinks?: { href: string; label: string }[] | null
  /** Nhãn giá đã render sẵn (I16) — null thì thanh dính không hiện vùng giá. */
  priceLabel?: string | null
  /** CTA chính trên thanh dính, thường là Zalo. Thiếu thì không render nút. */
  ctaHref?: string | null
  ctaLabel?: string | null
}

const {
  title, lang, entityType, image, gallery, containedInPlace, sameAs, facts, factsMax,
  sidebarSlots, nearbyTitle, nearby, updatedAt,
  badges, summary, speakable = false, jumpLinks, priceLabel, ctaHref, ctaLabel,
} = Astro.props

const badgeList = badges ?? []
const jumps = jumpLinks ?? []
// Thanh dính chỉ có nghĩa khi có ít nhất một thứ để hiện. Không có thì không
// render — vùng rỗng ẩn hẳn, 06-BINDING_MAP quyết định nền 2.
const showStickyBar = jumps.length > 0 || !!priceLabel || !!(ctaHref && ctaLabel)

// Cột phụ có gì để hiện hay không. PHẢI soi cùng điều kiện mà `Sidebar.astro`
// dùng (`slots.some(s => s.visible)`), nếu không hai bên lệch nhau.
//
// Vì sao cần: `Sidebar` tự ẩn khi rỗng, nhưng `.two-col` vẫn giữ rãnh `340px`
// cộng `gap` — tức 436px BỎ TRỐNG trên khung 1200, và cột chữ bị ép còn 764px
// dù không có gì bên cạnh. Đúng thứ R7 cấm ("vùng rỗng ẩn hẳn").
// ĐÃ ĐO trên bản dựng 2026-08-29: **18** trang có `.two-col` mà không có
// `.sidebar` — cẩm nang 16/24 (mới, sau khi QĐ-2026-08-29-02 đưa Thông tin
// nhanh của Bài viết ra khỏi cột phụ), địa danh 1 và tác giả 1 (lỗi CÓ SẴN).
// Lần đếm đầu ra 31 vì gộp nhầm cả trang term — trang term dùng `TermIndex`,
// không có `.two-col`, nên không thuộc ca này. Đếm đúng là "có two-col mà
// không có sidebar", không phải "thiếu sidebar".
const showSidebar = sidebarSlots.some(s => s.visible)

// QĐ-2026-08-25-02: BỎ luật "≤ 2 ô thì không trải dải".
//
// Luật cũ cắt theo SỐ LƯỢNG DỮ LIỆU, không theo loại trang — nên cùng một loại
// entity, trang 2 ô đẩy Thông tin nhanh vào cột phụ còn trang 3 ô trải dải hết
// bề ngang. Đo được: `trai-nghiem/cano-keo-du-bay` và `phao-chuoi` đều 2 ô nên
// vào cột phụ; `diem-tham-quan/chua-long-son` 5 ô và `tour/ve-vin-harbour` 3 ô
// thì trải dải. Cùng một wireframe mà ra hai hình dạng, tuỳ dữ liệu.
// Nay Thông tin nhanh LUÔN trải dải, mọi trang, mọi số ô.
const factsVisible = (facts ?? []).filter(f => f.visible)

// Lịch sử vùng Thông tin nhanh, giữ vì nó giải thích vì sao slot 'info' của
// Sidebar nay hẹp thế:
//   • Trước 2026-08-23: bản gộp (≤2 ô) đi qua một slot 'info' giả lập của
//     Sidebar, nên trong HTML tĩnh nó nằm SAU `.content-main` — sai thứ tự di
//     động mà 06 §3 đòi ("ngay dưới tiêu đề").
//   • I4 fix 2026-08-23: đưa bản gộp thành con trực tiếp của `.two-col`, nhận
//     vùng lưới `facts`.
//   • QĐ-2026-08-25-02: BỎ hẳn khái niệm "bản gộp". Thông tin nhanh nay LUÔN là
//     dải riêng phía trên `.two-col`; `factsInline` và vùng lưới `facts` đều đã
//     gỡ. Ba câu của bản I4 mô tả cơ chế nay không còn — viết lại ở đây thay vì
//     để chú thích khai một thứ đã xoá.
// Slot 'info' của Sidebar vì vậy chỉ còn InfoCard hợp lệ của
// Article/Organization/Person (DR-046).

// "Nguồn tham khảo" — 06 §3.1: hàng riêng cạnh Cập nhật ở cuối nội dung, KHÔNG
// vào Thông tin nhanh (đã tách khỏi `facts` ở AttractionDetail/PlaceDetail),
// KHÔNG vào sidebar. Giá trị là nhãn theo host, y hệt InfoCard cũ đã làm.
const sameAsHref = sameAs && sameAs.length > 0 ? sameAs[0] : null
const sameAsLabel = sameAsHref ? hostLabel(sameAsHref) : ''

const t = uiCopy(lang)

// Hero có ảnh THẬT hay không. Không kiểm bằng `Boolean(image)`: GROQ trả về
// object `{_type:'image', alt:''}` KHÔNG có `asset` cho entity chưa gắn ảnh —
// object đó truthy, trong khi `imageUrl()` trả undefined. Hai trang tác giả đã
// lộ đúng bẫy này (cổng BM-EMPTY-REGION).
const hasHeroImage = typeof image === 'string' ? Boolean(image) : Boolean(image?.asset?.url)
---

{/* Đầu trang đi qua `PageHead` — QĐ-2026-08-29-04. Ba dải breadcrumb / tiêu đề /
    đoạn mở trước đây dựng thẳng ở đây và bị `TouristDestinationHub` chép lại y
    hệt; nay một bản dùng chung, thêm `EntityIndex`/`TourIndex`/`TermIndex`/
    `EventIndex`/`HubIndex` cùng dùng.

    Hero VÀ thanh dính đi vào slot mặc định của `PageHead`, đúng thứ tự 06 §6:
    breadcrumb → tiêu đề → hero → thanh dính → đoạn mở. Đoạn mở phải đứng SAU
    thanh dính, không phải trước: spec vòng 5 §3.6 bác cách chen giữa hero và
    thanh dính vì nó đẩy thanh giá xuống sâu thêm ~152px, tức giá rơi khỏi màn
    đầu trên laptop 1366×768 — Luật 3 "giá trước, chữ sau". */}
<PageHead
  title={title}
  lang={lang}
  breadcrumb={{ entityType, containedInPlace, currentTitle: title }}
  description={summary}
  speakable={speakable}
  tagRegion
>
  <slot name="head-meta" slot="meta" />

  {/* Không ảnh VÀ không huy hiệu thì bỏ hẳn hero, không dựng khung rỗng — R7.
      Cổng BM-EMPTY-REGION bắt được ca này trên hai trang tác giả. */}
  {(hasHeroImage || badgeList.length > 0) && (
    <Hero image={image} gallery={gallery} fullBleed hasOverlay={badgeList.length > 0}>
      {badgeList.length > 0 && (
        <div slot="overlay" class="detail-badges">
          {badgeList.map(b => <span class="detail-badge">{b}</span>)}
        </div>
      )}
    </Hero>
  )}

  {showStickyBar && (
    <div class="sticky-bar">
      <div class="container sticky-bar__inner">
        <nav class="sticky-bar__jump" aria-label={title}>
          {jumps.map(j => <a href={j.href}>{j.label}</a>)}
        </nav>
        <div class="sticky-bar__action">
          {priceLabel && <span class="sticky-bar__price" data-region="sticky-bar" data-field="gia">{priceLabel}</span>}
          {ctaHref && ctaLabel && (
            <a class="sticky-bar__cta" href={ctaHref} target="_blank" rel="noopener">{ctaLabel}</a>
          )}
        </div>
      </div>
    </div>
  )}
</PageHead>

{factsVisible.length > 0 && <FactStrip facts={facts!} max={factsMax} />}

<div class:list={["container", "two-col", { "two-col--solo": !showSidebar }]}>
  <div class="content-main">
    <slot name="content" />

    <div class="updated-section">
      <div class="updated-row">
        <div class="updated">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {t('updated')} {formatDate(updatedAt, lang)}
        </div>
        {sameAsHref && (
          <div class="reference-source" data-region="section" data-field="sameAs">
            <span aria-hidden="true">🔗</span>
            {t('referenceSource')}: <a href={sameAsHref} target="_blank" rel="noopener">{sameAsLabel}</a>
          </div>
        )}
      </div>
    </div>
  </div>

  {/* stickyBar: Sidebar cộng chiều cao thanh dính vào chỗ dính của nó (DR-033). */}
  <Sidebar slots={sidebarSlots} stickyBar={showStickyBar}>
    <slot name="booking" slot="booking" />
    {/* Slot `info` ĐÃ GỠ — QĐ-2026-08-29-03. Đường forward này tồn tại chỉ để
       ba template ArticleDetail/OrganizationDetail/PersonDetail truyền
       `<InfoCard slot="info">` (DR-046). Cả ba nay đã chuyển sang `facts`, và
       `InfoCard.astro` đã xoá, nên giữ lại là hàng chết. */}
    <slot name="map" slot="map" />
    <slot name="about" slot="about" />
  </Sidebar>
</div>

{nearby.length > 0 && <NearbySection title={nearbyTitle} entities={nearby} lang={lang} />}

<style>
  .detail-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .detail-badge {
    padding: var(--badge-py) var(--badge-px);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-text-inverse) 22%, transparent);
    color: var(--c-text-inverse);
    font-size: var(--fs-label);
    font-weight: var(--fw-600);
    backdrop-filter: blur(4px);
  }





  /* Thanh dính: neo mục + giá + CTA. Bám dưới header nên dùng --header-h. */
  .sticky-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 90;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  /* Cao cố định theo token để Sidebar tính được chỗ dính (DR-033); trước đây cao
     theo nội dung nên không ai cộng được. */
  .sticky-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    height: var(--sticky-bar-h);
  }

  .sticky-bar__jump {
    display: flex;
    gap: var(--s5);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sticky-bar__jump::-webkit-scrollbar { display: none; }

  .sticky-bar__jump {
    align-self: stretch;
  }

  .sticky-bar__jump a {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--m-fast) var(--m-ease), border-color var(--m-fast) var(--m-ease);
  }

  .sticky-bar__jump a:hover {
    color: var(--c-primary);
    border-bottom-color: var(--c-primary);
  }

  .sticky-bar__action {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-shrink: 0;
  }

  .sticky-bar__price {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: var(--fw-800);
    color: var(--c-primary-strong);
    white-space: nowrap;
  }

  .sticky-bar__cta {
    padding: var(--s3) var(--s5);
    border-radius: var(--radius-pill);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-size: var(--fs-sm);
    font-weight: var(--fw-700);
    white-space: nowrap;
    transition: background var(--m-fast) var(--m-ease);
  }

  .sticky-bar__cta:hover { background: var(--c-accent-strong); }

  @media (max-width: 767px) {
    .sticky-bar__jump { display: none; }
    .sticky-bar__inner { justify-content: flex-end; }
  }


  .two-col {
    display: grid;
    grid-template-columns: 1fr 340px;
    /* Hai vùng: 'main' (content-main) và 'sidebar' (Sidebar.astro tự khai
       grid-area:sidebar).

       QĐ-2026-08-25-02 gỡ hàng lưới 'facts'. Hàng đó sinh ra ở I4 fix
       (2026-08-23) để đỡ bản gộp Thông tin nhanh ≤2 ô trong cột phụ; nay
       Thông tin nhanh luôn trải dải nên không có gì chiếm nó nữa, và một
       grid-area không ai dùng là chỗ để hiểu nhầm về sau. */
    grid-template-areas: 'main sidebar';
    gap: var(--s7);
    align-items: start;
    padding-top: var(--s6);
    padding-bottom: var(--s7);
  }

  .content-main {
    grid-area: main;
  }

  /* Không có gì ở cột phụ thì trả bề ngang cho cột chữ, không để rãnh 340px
     trống — R7. Xem chú thích `showSidebar` ở phần script. */
  .two-col--solo {
    grid-template-columns: 1fr;
    grid-template-areas: 'main';
  }

  .updated-section {
    padding-top: var(--s4);
  }

  /* Một hàng chung border-top cho cả "Cập nhật" và "Nguồn tham khảo" — 06 §3.1
     đặt hai dòng này cạnh nhau ở cuối nội dung. */
  .updated-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-top: 1px solid var(--c-border);
  }

  .updated,
  .reference-source {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .updated svg {
    color: var(--c-primary);
  }

  .reference-source a {
    color: var(--c-primary);
    text-decoration: none;
    font-weight: var(--fw-600);
  }

  .reference-source a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .two-col {
      grid-template-columns: 1fr;
      /* QĐ-2026-08-25-02 gỡ hàng 'facts' ở đây nữa. Bản sửa đầu chỉ dọn luật
         desktop và bỏ sót luật này, nên track 'facts' vẫn tồn tại kèm
         `gap: var(--s7)` — tức MỘT KHOẢNG TRỐNG 48px cố định trên mọi trang
         chi tiết ở khổ ≤1023px, cho một vùng không gì có thể chiếm.
         Thông tin nhanh nay là dải riêng phía trên `.two-col`, không còn đi
         qua lưới này. */
      grid-template-areas:
        'main'
        'sidebar';
    }
  }
</style>
