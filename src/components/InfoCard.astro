---
import type { Lang } from '../lib/types'
import { uiCopy } from '../lib/uiCopy'

export interface InfoRow {
  icon: string
  label: string
  value: string
  href?: string
  visible: boolean
}

export interface Props {
  rows: InfoRow[]
  lang?: Lang
}

const { rows, lang = 'vi' } = Astro.props
const t = uiCopy(lang)
const visible = rows.filter(r => r.visible)

function displayValue(row: InfoRow): string {
  if (row.href) return row.value || t('view')
  return row.value
}
---

{visible.length > 0 && (
  <dl class="info-card">
    {rows.filter(r => r.visible).map((row) => (
      <div class="info-row">
        <dt class="info-row-label">
          <span class="info-row-icon" aria-hidden="true">{row.icon}</span>
          {row.label}
        </dt>
        <dd class="info-row-value">
          {row.href ? (
            <a href={row.href} {...(row.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{displayValue(row)}</a>
          ) : (
            row.value
          )}
        </dd>
      </div>
    ))}
  </dl>
)}

<style>
  .info-card {
    margin: 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--c-border);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-row-label {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: var(--fw-500);
    color: var(--c-text-muted);
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex-shrink: 0;
  }

  .info-row-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .info-row-value {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text);
    text-align: right;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .info-row-value a {
    color: var(--c-primary);
    text-decoration: none;
  }

  .info-row-value a:hover {
    text-decoration: underline;
  }
</style>
