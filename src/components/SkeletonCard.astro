---
export interface Props {
  count?: number
}

const { count = 3 } = Astro.props
---

<div class="skeleton-grid">
  {Array.from({ length: count }).map(() => (
    <div class="skeleton-card">
      <div class="skeleton skeleton-img" />
      <div class="skeleton-body">
        <div class="skeleton skeleton-bar skeleton-bar--title" />
        <div class="skeleton skeleton-bar skeleton-bar--text" />
      </div>
    </div>
  ))}
</div>

<style>
  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s5);
  }

  .skeleton-card {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .skeleton-img {
    aspect-ratio: 4 / 3;
    width: 100%;
  }

  .skeleton-body {
    padding: var(--s4);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .skeleton-bar {
    border-radius: var(--radius-sm);
    height: 14px;
  }

  .skeleton-bar--title {
    width: 70%;
    height: 18px;
  }

  .skeleton-bar--text {
    width: 90%;
    height: 14px;
  }

  .skeleton {
    background: var(--c-border);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 1023px) {
    .skeleton-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .skeleton-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
