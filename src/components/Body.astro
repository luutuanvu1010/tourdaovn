---
import { imageUrl } from '../lib/sanity-image'
import { planBody } from '../lib/portableText'

export interface Props {
  blocks: any[] | undefined | null
  class?: string
  /**
   * Hạ cấp tiêu đề thân bài — `06` §3 hàng "Thân bài" (N15b, v2.2).
   *
   * Trong trang chi tiết entity, tiêu đề mục của `Section` là `<h2>`. Biên tập
   * vẫn gõ h2 trong Sanity, nhưng render thẳng ra `<h2>` thì thân bài ngang cấp
   * với tiêu đề mục và dàn bài tài liệu gãy. `headingOffset={1}` đẩy h2→h3,
   * h3→h4, h4→h5.
   *
   * `06` khai prop này từ v2.2 nhưng mã CHƯA BAO GIỜ có nó (QĐ-2026-08-25-03).
   * Đo được: một trang điểm tham quan phát 7 thẻ `<h2>` trong thân bài, ngang
   * hàng 3 `<h2>` tiêu đề mục.
   *
   * Trang Article KHÔNG hạ cấp (`06` §4.10): ở đó thân bài là nội dung chính,
   * không nằm dưới một tiêu đề mục nào. Nên mặc định là 0, caller nào cần thì
   * bật — không đảo ngược mặc định để khỏi đổi hành vi Article.
   */
  headingOffset?: 0 | 1
}

const { blocks, class: className, headingOffset = 0 } = Astro.props

/**
 * Phần dịch Portable Text → HTML nằm ở `../lib/portableText.ts`, kèm docblock
 * về link-là-annotation, escape, gỡ rác `cite`, và luật hạ cấp tiêu đề. Tách ra
 * để test được bằng `node:test` — `.astro` không nạp được vào test runner, và
 * chính vì không test được mà lỗi "mất `<ul>`" sống qua 108 document mà không
 * cổng nào thấy (`scripts/audit/__tests__/portable-text.test.ts`).
 *
 * File này chỉ còn quyết định THẺ BỌC và CSS.
 */
const nodes = planBody(blocks, { headingOffset })
---

{nodes.length > 0 && (
  <div class:list={['body-block', className]}>
    {nodes.map((node) => {
      if (node.kind === 'image') {
        const src = imageUrl(node.block, { width: 800 }) || node.block.asset?.url
        if (!src) return null
        return (
          <figure>
            <img src={src} alt={node.block.alt || ''} loading="lazy" />
            {node.block.caption && <figcaption>{node.block.caption}</figcaption>}
          </figure>
        )
      }

      // Danh sách phải vào bằng `Fragment` vì `<ul>` có thể lồng `<ul>` con —
      // cây nhiều tầng, không phải một thẻ bọc. Hệ quả: `ul/ol/li` KHÔNG mang
      // `data-astro-cid-*`, nên luật CSS của chúng dưới đây phải `:global()`.
      if (node.kind === 'list') return <Fragment set:html={node.html} />

      if (node.kind === 'quote') return <blockquote set:html={node.html} />

      if (node.kind === 'heading') {
        const The = node.tag
        return <The set:html={node.html} />
      }

      return <p set:html={node.html} />
    })}
  </div>
)}

<style>
  .body-block {
    max-width: var(--measure, 70ch);
    line-height: var(--lh-body);
    font-size: var(--fs-base);
  }

  .body-block p {
    margin-bottom: var(--s4);
  }

  .body-block h2,
  .body-block h3,
  .body-block h4,
  .body-block h5 {
    margin-top: var(--s6);
    margin-bottom: var(--s3);
    font-family: var(--font-display);
    font-weight: var(--fw-700);
    line-height: var(--lh-heading);
  }

  /* QĐ-2026-08-25-03: bốn cấp này trước đây KHÔNG khai font-size nào, nên rơi
     về mặc định trình duyệt — đo được 25,5px (1.5em) và 19,9px (1.17em). Hai
     giá trị đó không có trong thang chữ của `07` §2 và vi phạm câu mở đầu
     `tokens.css`: "0 hardcoded value bên ngoài file này".

     Thang 26 / 21 / 17, buộc theo THẺ chứ không theo ý định biên tập — CSS chỉ
     thấy thẻ. Hệ quả phải nói rõ, vì nó khác nhau ở hai loại trang:

     • Trang CẨM NANG (headingOffset=0): editor h2 → <h2> 26px, trước 25,5px;
       editor h3 → <h3> 21px, trước 19,9px. Gần như không đổi.
     • Trang ENTITY (headingOffset=1): editor h2 → <h3> 21px, trước 25,5px;
       editor h3 → <h4> 17px, trước 19,9px. NHỎ ĐI MỘT BẬC — và đó đúng là điều
       headingOffset sinh ra để làm: thân bài nằm DƯỚI tiêu đề mục nên phải nhỏ
       hơn nó.

     Bản đầu đặt h2 = --fs-section (32px), tức BẰNG tiêu đề mục — đảo ngược đúng
     thứ vừa sửa, và trên 13 trang cẩm nang thì 72 thẻ h2 thân bài nhảy 25,5→32px.
     Việc chỉnh thang cỡ tiêu đề vẫn là câu hỏi mở của chủ dự án, chưa chốt. */
  .body-block h2 { font-size: var(--fs-h4); }
  .body-block h3 { font-size: var(--fs-card-title); }
  .body-block h4 { font-size: var(--fs-base); }
  .body-block h5 { font-size: var(--fs-base); }

  /* Link trong thân bài — trước đây chưa từng có luật nào, vì chưa từng có link
     nào render ra. Gạch chân để phân biệt được với chữ thường, không chỉ bằng
     màu (WCAG 1.4.1: không dùng riêng màu để truyền thông tin).

     PHẢI dùng :global(). Astro gắn `data-astro-cid-*` vào selector VÀ vào phần
     tử, nhưng thẻ <a> ở đây sinh trong `set:html` nên không mang thuộc tính đó
     — luật scoped không bao giờ khớp. Bản đầu của khối này viết `.body-block a`
     và **không ăn một dòng nào**: `tokens.css` có `a { color: inherit;
     text-decoration: none }` toàn cục, nên 41 link trên 15 trang render y hệt
     chữ thường. Chú thích WCAG ở trên khi đó mô tả một thứ không xảy ra. */
  .body-block :global(a) {
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .body-block :global(a:hover) {
    color: var(--c-primary-strong);
  }

  .body-block :global(strong) { font-weight: var(--fw-700); }
  .body-block :global(em) { font-style: italic; }
  .body-block :global(s) { text-decoration: line-through; }

  /* `code` không khai font-family: `07` chưa có token chữ đơn cách, và bịa một
     họ chữ ở đây là mở nguồn sự thật thứ hai về typography. Mặc định `<code>`
     của trình duyệt đã là đơn cách; ở đây chỉ thêm nền cho tách khỏi chữ chạy. */
  .body-block :global(code) {
    background: var(--c-surface-alt);
    border-radius: var(--radius-sm);
    padding: 0 var(--s1);
    font-size: var(--fs-sm);
  }

  /* Danh sách. `tokens.css` reset `* { padding: 0 }`, nên KHÔNG khai
     padding-left ở đây thì dấu chấm đầu dòng nằm ngoài hộp nội dung và bị cắt
     — có `<ul>` mà vẫn trông như mất gạch đầu dòng. `:global()` vì `ul/ol/li`
     vào bằng `set:html` (xem chú thích ở khối render). */
  .body-block :global(ul),
  .body-block :global(ol) {
    margin-bottom: var(--s4);
    padding-left: var(--s5);
  }

  .body-block :global(ul) { list-style: disc; }
  .body-block :global(ol) { list-style: decimal; }
  .body-block :global(ul ul) { list-style: circle; }

  .body-block :global(li) { margin-bottom: var(--s2); }
  .body-block :global(li:last-child) { margin-bottom: 0; }

  /* List lồng: bám sát mục cha, không ăn khoảng cách của một khối rời. */
  .body-block :global(li > ul),
  .body-block :global(li > ol) {
    margin-top: var(--s2);
    margin-bottom: 0;
  }

  /* Không dùng viền trái: bề dày viền chưa có token nào trong `07`, mà viết
     cứng `3px` ở đây là đúng thứ luật cứng 1 của `CLAUDE.md` §8 cấm, còn mượn
     `--underline-height` (gạch chân tiêu đề mục) là buộc hai thứ không liên
     quan vào nhau. Nền phụ + bo góc đạt cùng mục đích "khối tách khỏi chữ
     chạy" bằng token đã có — `07` khai `surface.alt` đúng cho khối xen kẽ. */
  .body-block blockquote {
    margin: var(--s5) 0;
    padding: var(--s4);
    background: var(--c-surface-alt);
    border-radius: var(--radius-md);
    color: var(--c-text-muted);
    font-style: italic;
  }

  .body-block figure {
    margin: var(--s5) 0;
  }

  .body-block figure img {
    max-width: 100%;
    border-radius: var(--radius-md);
  }

  .body-block figcaption {
    margin-top: var(--s2);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }
</style>
