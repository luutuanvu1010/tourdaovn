---
import PageHead from './PageHead.astro'
import type { Lang, PriceEntry } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy, ATTRACTION_TYPE_LABELS, SPECIALTY_TYPE_LABELS, ARTICLE_TYPE_LABELS, TOUR_FORMAT_LABELS } from '../lib/uiCopy'
import { resolvePrice } from '../lib/resolver'
import { ROUTE_MAP } from '../lib/routes'
import { entityHref as sharedEntityHref } from '../lib/homepage'
import { collectionPageToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import Card from './Card.astro'
import EmptyState from './EmptyState.astro'

const SEGMENT_CACHE: Record<string, string> = {}
function getSegment(entityType: string, lang: Lang): string {
  const key = `${entityType}:${lang}`
  if (SEGMENT_CACHE[key]) return SEGMENT_CACHE[key]
  const entry = ROUTE_MAP.find(r => r.entity === entityType)
  const seg = entry?.segments[lang] ?? entityType
  SEGMENT_CACHE[key] = seg
  return seg
}

interface ListingEntity {
  title: string
  summary: string
  slug: string
  image?: string
  imageAlt?: string
  attractionType?: string
  experienceType?: string
  servesCuisine?: string[]
  specialtyType?: string
  starRating?: number
  tourFormat?: string
  articleType?: string
  bookingRef?: { key?: string }
  author?: { title: string }
}

export interface Props {
  entities: ListingEntity[]
  entityType: string
  lang: Lang
  title: string
  description: string
  terms?: { name: string; slug: string }[]
  totalCount?: number
  prices?: Map<string, PriceEntry>
}

const {
  entities,
  entityType,
  lang,
  title,
  description,
  terms,
  totalCount,
  prices,
} = Astro.props

const t = uiCopy(lang)
const count = totalCount ?? entities.length

// Badge label — nguồn duy nhất uiCopy, đủ 5 ngôn ngữ
const attractionTypeLabel = ATTRACTION_TYPE_LABELS[lang] ?? ATTRACTION_TYPE_LABELS.en
const specialtyTypeLabel = SPECIALTY_TYPE_LABELS[lang] ?? SPECIALTY_TYPE_LABELS.en
const articleTypeLabel = ARTICLE_TYPE_LABELS[lang] ?? ARTICLE_TYPE_LABELS.en
const tourFormatLabel = TOUR_FORMAT_LABELS[lang] ?? TOUR_FORMAT_LABELS.en

function getBadge(entity: ListingEntity): { label: string; variant?: 'default' | 'author' } | null {
  switch (entityType) {
    case 'place':
      return null
    case 'attraction':
      return entity.attractionType
        ? { label: attractionTypeLabel[entity.attractionType] || entity.attractionType }
        : null
    case 'experience':
      return entity.experienceType ? { label: entity.experienceType } : null
    case 'restaurant':
      return entity.servesCuisine?.[0] ? { label: entity.servesCuisine[0] } : null
    case 'specialty':
      return entity.specialtyType
        ? { label: specialtyTypeLabel[entity.specialtyType] || entity.specialtyType }
        : null
    case 'hotel':
    case 'resort':
      return entity.starRating ? { label: '★'.repeat(entity.starRating) } : null
    case 'article':
      return entity.articleType
        ? { label: articleTypeLabel[entity.articleType] || entity.articleType }
        : null
    case 'tour':
      return entity.tourFormat
        ? { label: tourFormatLabel[entity.tourFormat] || entity.tourFormat }
        : null
    default:
      return null
  }
}

function getPriceLabel(entity: ListingEntity): string | undefined {
  if (!entity.bookingRef?.key || !prices) return undefined
  const pv = resolvePrice(entity.bookingRef.key, entityType, undefined, prices, lang)
  return pv?.label
}

// Hỏi `entityHref` dùng chung thay vì tự dựng lại `/{segment}/{slug}/`. Không phải mọi
// entity đều có trang chi tiết nằm dưới segment danh sách của nó: `touristDestination`
// liệt kê ở /diem-den/ nhưng chi tiết ở gốc /{slug}/ (ADR-0028). Bản tự dựng cũ sẽ sinh
// ra một loạt link /diem-den/{slug}/ trỏ vào trang không tồn tại. `sharedEntityHref` là
// nơi DUY NHẤT biết ngoại lệ đó — không chép lại luật ấy ở đây.
function entityHref(slug: string): string {
  return sharedEntityHref(entityType, slug, lang) ?? `${lang === 'vi' ? '' : `/${lang}`}/${getSegment(entityType, lang)}/${slug}/`
}

const hasEntities = entities.length > 0
const hasTerms = terms && terms.length > 0
const termSegment = getSegment(entityType, lang)
const termPrefix = lang === 'vi' ? '' : `/${lang}`
---

{/* 06 §5.2 — Index nhánh entity */}
<div class="entity-index">
  {/* Vùng 2: Tiêu đề nhánh — h1 vì là heading chính của trang */}
  {/* QĐ-2026-08-29-04: header riêng của file này thay bằng `PageHead` biến thể
      `index`. Ba trang danh sách từng có ba bản cùng hình dạng `h1 + gạch chân
      + mô tả`. Không breadcrumb: trang danh sách là mắt gốc của nhánh. */}
  <PageHead title={title} lang={lang} variant="index" description={description} />

  {/* Vùng 3: Lối lọc term */}
  {
    hasTerms && (
      <div class="term-filter">
        <div class="container">
          <div class="term-pills">
            {terms!.map(t => (
              <a
                href={`${termPrefix}/${termSegment}/${t.slug}/`}
                class="term-pill"
              >
                {t.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  {/* Vùng 4+5: Lưới card hoặc EmptyState */}
  <div class="entity-body">
    <div class="container">
      {hasEntities ? (
        <>
          <div class="card-grid">
            {entities.map(entity => {
              const badge = getBadge(entity)
              return (
                <Card
                  title={entity.title}
                  summary={entity.summary}
                  href={entityHref(entity.slug)}
                  image={entity.image}
                  imageAlt={entity.imageAlt}
                  badge={badge?.label}
                  badgeVariant={badge?.variant ?? 'default'}
                  priceLabel={getPriceLabel(entity)}
                  authorLabel={entityType === 'article' ? entity.author?.title : undefined}
                />
              )
            })}
          </div>

          {/* Vùng 6: Tổng số */}
          <p class="entity-count">{count} {t('results')}</p>
        </>
      ) : (
        <EmptyState entityType={entityType} lang={lang} />
      )}
    </div>
  </div>

  {/* Vùng 7: JSON-LD */}
  <script type="application/ld+json" set:html={jsonLdScriptContent(
    collectionPageToJsonLd(
      { title, description, entityType, entities: entities.map(e => ({ ...e, _type: entityType })), lang, pagePath: Astro.url.pathname },
      siteBaseUrl(Astro.site)
    )
  )} />
</div>

<style>

  .entity-header::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 18px;
    pointer-events: none;
    background: var(--c-surface-alt);
    opacity: .52;
  }




  .term-filter {
    padding: var(--s5) 0 0;
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .term-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .term-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--s2) var(--s4);
    background: color-mix(in srgb, var(--c-primary-soft) 82%, var(--c-card));
    color: var(--c-primary);
    border: 1px solid color-mix(in srgb, var(--c-primary) 14%, transparent);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    font-family: var(--font-ui);
    text-decoration: none;
    transition: background var(--m-fast) var(--m-ease),
                color var(--m-fast) var(--m-ease);
  }

  .term-pill:hover {
    background: var(--c-primary);
    color: var(--c-text-inverse);
  }

  .entity-body {
    padding: var(--s7) 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c-card) 28%, transparent), transparent 22%);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s5);
  }

  /* ── Lưới thích ứng theo SỐ MỤC THẬT ──
     /tour/ đang có 1 mục. Lưới ba cột để một thẻ dọc nằm lẻ loi bên trái,
     trông như trang lỗi. Cùng luật đã dùng ở HomeRollupSection. */

  .card-grid:has(> :last-child:nth-child(1)) {
    grid-template-columns: 1fr;
  }

  .card-grid:has(> :last-child:nth-child(1)) :global(.card) {
    display: grid;
    grid-template-columns: minmax(0, 42%) 1fr;
    align-items: stretch;
  }

  .card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
    height: 100%;
    min-height: 240px;
  }

  .card-grid:has(> :last-child:nth-child(2)) {
    grid-template-columns: repeat(2, 1fr);
  }

  .entity-count {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    margin-top: var(--s6);
  }

  @media (max-width: 1023px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .card-grid:has(> :last-child:nth-child(1)) :global(.card) {
      grid-template-columns: 1fr;
    }
    .card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    /* Phải nhắc lại NGUYÊN bộ chọn :has(> :last-child:nth-child(2)) (:276) ở đây —
       để `.card-grid` trần là thua đặc hiệu: (0,2,0) so với (0,4,0) — đúng lỗi
       DR-062. Khuôn chép từ HomeRollupSection.astro:157-163. */
    .card-grid,
    .card-grid:has(> :last-child:nth-child(2)) {
      grid-template-columns: 1fr;
    }

    /* R1 chỉ thắng ở đây nếu nhắc lại NGUYÊN bộ chọn :has(). Để `.card` trần là
       thua đặc hiệu — (0,2,0) so với (0,5,0) — đúng lỗi DR-062.
       height PHẢI là 88px tường minh, KHÔNG dùng `auto`: align-items:stretch nằm ở
       luật gốc ngoài mọi media query (:268) nên vẫn sống ở đây, và một grid item
       đang stretch mà height:auto thì giãn hết chiều cao hàng, aspect-ratio bị bỏ
       qua — ra đúng cột ảnh 88px cao hết thẻ, y hệt lỗi height:100%. */
    .card-grid:has(> :last-child:nth-child(1)) :global(.card) {
      grid-template-columns: 88px 1fr;
      align-items: start;
    }

    .card-grid:has(> :last-child:nth-child(1)) :global(.card-img-wrap) {
      height: 88px;
      min-height: 0;
    }
  }
</style>
