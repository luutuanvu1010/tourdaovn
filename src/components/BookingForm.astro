  /* Dat de LEN o ngay, khop tung padding/border/co chu voi `.bf__input` de chu khong xe dich.
     `pointer-events: none` de moi cu bam van roi xuong o ngay that ben duoi (bam vao lop phu
     ma khong mo duoc lich la loi hay gap nhat cua loi nay). Gia tri deu la token. */
  .bf__date-face {
    position: absolute; inset: 0;
    display: flex; align-items: center;
    /* Chua rieng ben phai cho bieu tuong lich cua `.bf__date-trigger` (--s7 = 48px: bieu
       tuong 20px cong le phai --s4, con du): thieu cho nay thi chuoi ngay chay de len no. */
    padding: var(--s3) var(--s7) var(--s3) var(--s4);
    font-size: var(--fs-base); color: var(--c-text);
    pointer-events: none;
    overflow: hidden; white-space: nowrap;
  }
  /* Chi doi MAU, KHONG doi co chu: go dau ⓘ roi thi le phai tut tu --s9 xuong --s7, cho
     chu noi ra 208px, du cho "Chon ngay khoi hanh" o --fs-base (can 181px). Truoc do phai
     ep xuong --fs-sm vi chi con 160px — rang buoc do khong con. */
  .bf__date-face--empty { color: var(--c-text-muted); }
  /* ── Lich tieng Viet tu ve ──
     Khoi chua la `.bf__date-wrap` (rong bang o ngay), KHONG phai nut mo — dung bai hoc cua
     bang ghi chu dau ⓘ truoc do: cho `<details>` lam khoi chua thi bang bi ep vao be rong
     20px cua no. `top: 100%` de lich do XUONG DUOI o, khong lam o cao them. */
  .bf__cal {
    position: absolute; top: 100%; left: 0; right: 0; z-index: 2;
    margin-top: var(--s1);
    padding: var(--s3);
    background: var(--c-card);
    border: 1px solid var(--c-border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-overlay);
  }
  /* Bien the lat LEN, dung khi duoi o ngay khong con cho. Doi ca le: le cach o phai theo ve
     phia doi dien, neu khong bang dinh sat mat o. */
  .bf__cal--tren { top: auto; bottom: 100%; margin-top: 0; margin-bottom: var(--s1); }
  .bf__cal-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
  .bf__cal-title { font-size: var(--fs-label); font-weight: var(--fw-600); color: var(--c-text); }
  .bf__cal-nav {
    display: flex; align-items: center; justify-content: center;
    width: var(--s5); height: var(--s5); padding: 0;
    background: none; border: 1px solid var(--c-border); border-radius: var(--radius-sm);
    font-size: var(--fs-label); color: var(--c-text); cursor: pointer;
  }
  .bf__cal-nav:disabled { opacity: .4; cursor: default; }
  .bf__cal-nav:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 2px; }
  /* Bay cot bang nhau cho ca hang dau cot lan luoi ngay — khai mot lan, hai noi dung chung,
     khong the lech cot. */
  .bf__cal-dow, .bf__cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--s1); }
  .bf__cal-dow { margin-top: var(--s2); }
  .bf__cal-dow span { text-align: center; font-size: var(--fs-xs); color: var(--c-text-muted); }
  /* `:global()` BAT BUOC o day, khong phai cho tien: cac o ngay do SCRIPT tao ra nen chung
     khong mang thuoc tinh scoped cua Astro, ma Astro lai gan thuoc tinh do vao moi bo chon
     (`.bf__cal-day` thanh `.bf__cal-day[data-astro-cid-…]`) — viet tran thi luat khong khop
     mot o nao. Do duoc luc chua bo `:global`: `aspect-ratio` ra 'auto', `display` ra 'block',
     o ngay thanh 32x20 thay vi vuong. Cung bay da dinh o `.bf__tip-body` dung bang chi tiet
     gia (~L588). Bo chon cha `.bf__cal-grid` VAN mang scope nen luat khong ro ri ra ngoai. */
  .bf__cal-grid :global(.bf__cal-day) {
    /* `aspect-ratio` chu khong chieu cao chep cung: o vuong theo be rong cot, nen lich tu vua
       trong o ngay o moi kho man hinh ma khong can con so nao. */
    aspect-ratio: 1; padding: 0;
    display: flex; align-items: center; justify-content: center;
    background: none; border: 0; border-radius: var(--radius-sm);
    font-size: var(--fs-label); color: var(--c-text); cursor: pointer;
  }
  .bf__cal-grid :global(.bf__cal-day:hover:not(:disabled)) { background: var(--c-primary-soft); }
  .bf__cal-grid :global(.bf__cal-day:disabled) { color: var(--c-text-muted); opacity: .35; cursor: default; }
  .bf__cal-grid :global(.bf__cal-day.is-chon) { background: var(--c-primary); color: var(--c-text-inverse); font-weight: var(--fw-600); }
  .bf__cal-grid :global(.bf__cal-day:focus-visible) { outline: 2px solid var(--c-primary); outline-offset: -2px; }
  .bf__pax { display: flex; align-items: center; justify-content: space-between; gap: var(--s3); padding: var(--s2) 0; }
  .bf__pax-info { display: flex; flex-direction: column; gap: 2px; }
  .bf__pax-name { font-size: var(--fs-base); font-weight: var(--fw-600); color: var(--c-text); }
  .bf__stepper { display: inline-flex; align-items: center; gap: var(--s2); }
  .bf__btn { width: 2.75rem; height: 2.75rem; border-radius: var(--radius-pill); border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-primary); font-size: var(--fs-h5); font-weight: var(--fw-600); cursor: pointer; transition: background var(--m-fast) var(--m-ease), border-color var(--m-fast) var(--m-ease); }
  /* --c-card la nen THUONG cua .bf__btn (dong tren), nen --c-surface-alt tung dung cho
     hover se trung voi nen moi cua .bf sau khi form chuyen xam — xoa mat phan hoi hover
     thay vi sua. Dung token hover that, cung mau voi .bf__secondary:hover ben duoi. */
  .bf__btn:hover:not(:disabled) { background: var(--c-primary-soft); border-color: var(--c-primary); }
  .bf__btn:disabled { opacity: 0.4; cursor: not-allowed; }
  /* Truoc la transparent: an theo nen cha. Tren form xam moi, transparent lo ra thanh
     mot o xam kep giua hai nut tron trang (.bf__btn) — quyet ro sang --c-card de dong
     bo voi hai nut hai ben; border-radius theo de khong con goc vuong lac giua hai nut
     bo tron pill. */
  .bf__count { width: 2.75rem; text-align: center; font: inherit; font-size: var(--fs-base); font-weight: var(--fw-700); border: 0; border-radius: var(--radius-md); background: var(--c-card); color: var(--c-text); -moz-appearance: textfield; }
  .bf__count::-webkit-outer-spin-button, .bf__count::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  /* Lat nguoc: --c-surface-alt tung dung khi .bf trong suot, nay trung mau voi nen
     xam moi cua .bf, bang tam tinh tan vao form. Lat sang --c-card de bang gia noi
     trang tren form xam. */
  .bf__quote { background: var(--c-card); border-radius: var(--radius-md); padding: var(--s4); display: flex; flex-direction: column; gap: var(--s2); }
  /* `:global()` là bắt buộc ở đây, không phải tuỳ chọn. Hai vùng này được JS dựng lại bằng
     `document.createElement` mỗi lần đổi số người (và khi hiện tóm tắt lúc gửi xong), nên node
     mới KHÔNG mang thuộc tính `data-astro-cid-*` mà CSS scoped của Astro nhắm tới. Viết
     `.bf__line { … }` trần thì dòng server dựng đẹp còn dòng JS dựng mất `flex` — số lượng dán
     liền thành tiền, kiểu "Người lớn × 1019.550.000₫" (lỗi thật, chủ dự án báo 2026-08-29).
     Phạm vi vẫn được giữ: phần tử cha còn scoped, `:global` chỉ mở cho lớp con. */
  [data-quote-lines] :global(.bf__line),
  [data-done-summary] :global(.bf__line),
  [data-detail-lines] :global(.bf__line) { display: flex; justify-content: space-between; gap: var(--s3); font-size: var(--fs-sm); color: var(--c-text-muted); }
  .bf__total { display: flex; justify-content: space-between; gap: var(--s3); padding-top: var(--s2); border-top: 1px solid var(--c-border); font-size: var(--fs-base); font-weight: var(--fw-700); color: var(--c-text); }
  .bf__total strong { color: var(--c-accent-strong); }
  /* Task 8 — bảng chi tiết giá (SPEC §4.5). `.bf__detail` là <details> gốc, giữ marker mặc
     định của trình duyệt (▸/▾ theo SPEC mockup) — KHÔNG ẩn như `.bf__tip-mark` (đó là dấu ⓘ
     riêng, mục đích khác). `.bf__detail-body` là vùng do JS dựng lại mỗi lần đổi số khách. */
  .bf__detail-sum { font-size: var(--fs-sm); color: var(--c-primary); cursor: pointer; }
  .bf__detail-body { display: flex; flex-direction: column; gap: var(--s2); margin-top: var(--s2); }
  /* Dòng cuối (Tổng cộng) và ghi chú mùa cũng do JS `createElement` dựng (cùng lý do :global
     ở trên) — DR-102 áp cho MỌI lớp gắn vào node JS dựng, không riêng `.bf__line`. */
  [data-detail-lines] :global(.bf__line--total) {
    padding-top: var(--s2); border-top: 1px solid var(--c-border);
    font-weight: var(--fw-700); color: var(--c-text);
  }
  /* margin: 0, KHÔNG phải var(--s2) 0 0 như .bf__tip-body gốc: .bf__detail-body đã là flex
     column với gap: var(--s2) riêng, nên margin-top ở đây CỘNG THÊM vào gap (flexbox không
     gộp margin dọc như block layout) — đo được 16px giữa dòng Tổng cộng và ghi chú mùa, gấp
     đôi 8px giữa các dòng khác. Để container `.bf__detail-body` một mình lo khoảng cách. */
  [data-detail-lines] :global(.bf__tip-body) { margin: 0; font-size: var(--fs-sm); color: var(--c-text-muted); }
  /* Task 6: hai lựa chọn thanh toán. `<input type="radio">` thật vẫn còn — chỉ tạo dáng
     `<label>`, không thay bằng `<button>`. KHÔNG đoạn nào mang `checked` sẵn (chủ dự án
     chốt) nên cả hai phải nhìn "nghỉ" như nhau lúc tải trang — border 1px đều nhau ở
     trạng thái chưa chọn là bằng chứng đó.
     Vòng sửa 2/5 (Task 7, chạm đúng vùng này vì chính đệm mới của .bf gây hồi quy — xem
     ghi chú ở `.bf` phía trên): đổi từ hàng ngang hai cột sang xếp DỌC full-width. Số đo
     cho thấy khoản tiết kiệm chiều cao của bố cục hai cột trong cột 306px chỉ ~2,4px so
     với xếp dọc — đổi lại ba dòng chữ chen chúc thành một món hời tệ. `flex-direction:
     column` đủ để full-width: `.bf__pay` là flex item của `.bf` (flex column), và
     `align-items` mặc định `stretch` đã kéo `.bf__pay-opt` full-width mà không cần khai
     thêm. Bỏ `flex: 1` (chỉ có tác dụng khi container có dư chiều cao để chia — ở đây
     `.bf__pay` cao theo nội dung, không dư) để tránh đọc nhầm là còn chia đều theo trục
     ngang. */
  .bf__pay { display: flex; flex-direction: column; gap: var(--s2); }
  .bf__pay-opt {
    display: flex; align-items: center; justify-content: center; gap: var(--s2);
    min-height: 2.75rem; font-size: var(--fs-sm);
    border: 1px solid var(--c-border); border-radius: var(--radius-md);
    padding: var(--s2) var(--s3); cursor: pointer;
  }
  /* Dấu hiệu NGOÀI màu cho trạng thái chọn (người mù màu vẫn phân biệt được): thêm
     `box-shadow` viền trong 1px chồng lên border 1px sẵn có — đọc như viền dày 2px
     nhưng KHÔNG đổi kích thước hộp (border-width giữ nguyên 1px), nên hai đoạn không
     lệch cao khi một đoạn được chọn. Nút radio thật bên trong cũng tự có chấm đặc khi
     checked — một lớp dấu hiệu ngoài màu thứ hai, độc lập với CSS này. */
  .bf__pay-opt:has(:checked) {
    border-color: var(--c-primary);
    box-shadow: inset 0 0 0 1px var(--c-primary);
    background: var(--c-primary-soft);
  }
  .bf__pay-opt:has(:focus-visible) { outline: 2px solid var(--c-primary); outline-offset: 2px; }
  .bf__note, .bf__hint, .bf__noscript, .bf__hotline { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }
  .bf__hint { color: var(--c-accent-strong); }
  .bf__err { font-size: var(--fs-sm); color: var(--c-accent-strong); margin: 0; min-height: 0; }
  .bf__err:empty { display: none; }
  .bf__primary { display: inline-flex; align-items: center; justify-content: center; width: 100%; background: var(--c-accent); color: var(--c-text-inverse); font-family: var(--font-ui); font-size: var(--fs-base); font-weight: var(--fw-600); padding: var(--s3) var(--s5); border: 0; border-radius: var(--radius-pill); cursor: pointer; text-decoration: none; transition: background var(--m-fast) var(--m-ease); }
  .bf__primary:hover:not(:disabled) { background: var(--c-accent-strong); }
  .bf__primary:disabled { opacity: 0.6; cursor: not-allowed; }
  .bf__secondary { display: inline-flex; align-items: center; justify-content: center; width: 100%; background: var(--c-card); color: var(--c-primary); font-family: var(--font-ui); font-size: var(--fs-base); font-weight: var(--fw-600); padding: var(--s3) var(--s5); border: 2px solid var(--c-primary); border-radius: var(--radius-pill); cursor: pointer; text-decoration: none; transition: background var(--m-fast) var(--m-ease); }
  .bf__secondary:hover { background: var(--c-primary-soft); }
  .bf__actions { display: flex; flex-direction: column; gap: var(--s2); }
  .bf__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .bf__turnstile:empty { display: none; }
  .bf__done { display: flex; flex-direction: column; gap: var(--s3); outline: none; }
  .bf__done-title { font-family: var(--font-display); font-size: var(--fs-h5); font-weight: var(--fw-700); color: var(--c-primary-strong); margin: 0; }
  .bf__done-code { font-size: var(--fs-base); margin: 0; }
  .bf__done-code strong { font-family: var(--font-display); color: var(--c-accent-strong); }
  .bf__done-dup { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }
  .bf__hotline a { color: var(--c-primary); font-weight: var(--fw-600); }

  /* Khối QR chuyển khoản. Mọi giá trị lấy từ tokens.css — không mã màu, không cỡ chữ viết
     cứng (luật cứng 1 của CLAUDE.md, ADR-0030 §4).
     Lật ngược: --c-surface-alt tung trung mau voi nen xam moi cua .bf, tan bien mat dung
     bo mat khach quet de TRA TIEN. Lat sang --c-card de khoi QR noi trang tren form xam. */
  .bf__qr { display: flex; flex-direction: column; gap: var(--s3); padding: var(--s4); background: var(--c-card); border: 1px solid var(--c-border); border-radius: var(--radius-md); }
  .bf__qr-title { font-family: var(--font-display); font-size: var(--fs-h5); font-weight: var(--fw-700); color: var(--c-primary-strong); margin: 0; }
  .bf__qr-body { display: flex; flex-direction: column; gap: var(--s4); }
  .bf__qr-visual { display: flex; flex-direction: column; align-items: center; gap: var(--s2); }
  /* width/height trong HTML là cỡ nội tại 540×640 của ảnh VietQR — giữ để trình duyệt chừa
     đúng chỗ, không giật khung lúc ảnh về (CLS). Ở đây co theo bề ngang thẻ sidebar. */
  .bf__qr-img { width: 100%; max-width: 16rem; height: auto; background: var(--c-card); border: 1px solid var(--c-border); border-radius: var(--radius-sm); }
  .bf__qr-hint { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; text-align: center; }
  .bf__qr-facts { display: flex; flex-direction: column; gap: var(--s2); margin: 0; }
  .bf__qr-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s2); }
  .bf__qr-row dt { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }
  .bf__qr-row dd { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: var(--s2); font-size: var(--fs-base); font-weight: var(--fw-600); color: var(--c-text); margin: 0; }
  /* `user-select: all` — một chạm chọn trọn giá trị. Đây là đường dự phòng khi nút chép hỏng
     (navigator.clipboard cần secure context và vẫn có thể bị từ chối), nên nó không phải trang trí. */
  .bf__qr-mono { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; user-select: all; overflow-wrap: anywhere; }
  .bf__qr-amount { font-family: var(--font-display); color: var(--c-accent-strong); }
  .bf__qr-copy { font-family: var(--font-ui); font-size: var(--fs-label); font-weight: var(--fw-600); color: var(--c-primary); background: var(--c-card); border: 1px solid var(--c-border); border-radius: var(--radius-pill); padding: var(--s1) var(--s3); cursor: pointer; transition: background var(--m-fast) var(--m-ease), color var(--m-fast) var(--m-ease); }
  .bf__qr-copy:hover { background: var(--c-primary-soft); }
  .bf__qr-copy.is-copied { color: var(--c-green-text); border-color: var(--c-green-text); background: var(--c-green-soft); }
  .bf__qr-note { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }

  /* Thuộc tính `hidden` phải thắng mọi khai báo `display` của chính component này.
     Vì sao cần một luật riêng: Astro gắn thuộc tính scoped vào selector, nên `.bf__step`
     thành `.bf__step[data-astro-cid-…]` (đặc hiệu 0,2,0) và đè luôn `[hidden]{display:none}`
     mặc định của trình duyệt (0,1,0). Hậu quả đo được trên production 2026-08-29: bước 2
     không bao giờ gấp lại dù JS đặt `hidden = true` — bấm "Đặt tour ngay" nhìn như không có
     gì xảy ra; nút mở cũng không ẩn đi; và khối "đã nhận yêu cầu" hiện thường trực với mã
     đơn rỗng. Liệt kê theo class thay vì `[hidden]` trần: selector có class thì Astro mới gắn
     thuộc tính scoped (thành 0,3,0 — thắng 0,2,0 mà không cần `!important`), còn `[hidden]`
