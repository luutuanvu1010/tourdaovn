---
// BookingForm.astro — thẻ đặt tour trong sidebar trang Tour (SPEC-2026-08-21-dat-tour §4.3).
// Một <form> hai bước: (1) ngày + số người + tạm tính, (2) thông tin khách + Turnstile.
// Giá NƯỚNG lúc build vào data-price-table; script client chỉ tính lại bằng computeQuote()
// (cùng hàm server kiểm — BK5). Không fetch giá (BK1). Không có nút nào không hoạt động:
// Zalo/hotline chỉ render khi siteSettings.contact có dữ liệu.
import type { Lang, SiteContact } from '../lib/types'
import { uiCopy } from '../lib/uiCopy'
import { formatPrice } from '../lib/renderer'
import { availablePaxCodes, computeQuote, emptyPax, type PaxCode, type PriceTable } from '../lib/booking/quote'
import type { Season } from '../lib/booking/season'
import { addDaysISO, formatDateVN, THU_NGAN_VN, todayVN } from '../lib/booking/vn-date'
import { LIMITS, MSG } from '../lib/booking/schema'
// Tài khoản nhận chuyển khoản là HẰNG SỐ BIÊN DỊCH — vào bằng import, không qua
// Astro.props/data-* như priceTable (thứ đọc từ Sanity lúc dựng). SPEC §4.5.
import { banking } from '../site.config'

export interface Props {
  lang: Lang
  tourSlug: string
  tourTitle: string
  bookingRef: string
  priceLabel: string
  priceTable: PriceTable
  seasons?: Season[]
  contact?: SiteContact | null
  turnstileSiteKey?: string
  prepayPercent?: number
}

const { lang, tourSlug, tourTitle, bookingRef, priceLabel, priceTable, seasons, contact = null, turnstileSiteKey = '', prepayPercent = 0 } = Astro.props
const t = uiCopy(lang)

const PAX_KEY: Record<PaxCode, 'paxAdult' | 'paxChild' | 'paxSenior' | 'paxInfant'> = {
  adult: 'paxAdult', child: 'paxChild', senior: 'paxSenior', infant: 'paxInfant',
}
const codes = availablePaxCodes(priceTable)
const isTiers = priceTable.kind === 'tiers'
function paxLabel(code: PaxCode): string {
  return isTiers ? t('paxGuests') : t(PAX_KEY[code])
}
function paxNote(code: PaxCode): string {
  return priceTable.kind === 'flat' ? (priceTable.notes?.[code] ?? '') : ''
}

// Thời điểm build = vintage bảng giá mà khách nhìn thấy (SPEC §4.4).
const quotedAt = new Date().toISOString()
const today = todayVN()
// Mốc dưới là CHÍNH HÔM NAY (QĐ-2026-09-01-01: nhận đặt tour đi trong ngày). Phải khớp
// từng chữ với `schema.ts` — bên đó chặn `departDate < today`. Lệch một ngày là ô chọn cho
// bấm một ngày mà máy chủ trả lỗi, hoặc ngược lại.
const minDate = today
const maxDate = addDaysISO(today, LIMITS.MAX_DAYS_AHEAD)

// Tạm tính ban đầu (1 người lớn) render sẵn ở server để không JS vẫn thấy số.
// Ba tham số dưới phải khớp ĐÚNG trạng thái mở màn của markup — ngày đã điền sẵn `minDate`
// và ô "Chuyển khoản" đã tick sẵn — vì `update()` chạy ngay lúc script khởi động và tính lại
// bằng cùng `computeQuote`. Lệch một tham số là số tiền NHẢY một nhịp ngay khi trang tải xong
// (đúng loại lỗi tiền thật mà DR-102 đã ghi). Không có ưu đãi (prepayPercent = 0) thì hai
// tham số cuối vô hại: `apDieuChinh` bỏ qua phần trăm 0.
const initialPax = emptyPax()
const initialPrepay = prepayPercent > 0
const initialQuote = computeQuote(priceTable, initialPax, {
  seasons, departDate: minDate, prepayPercent, prepay: initialPrepay,
})
// Câu chỉ phạm vi ngày, giữ dạng KHUÔN có {min}/{max} chứ không nướng sẵn hai mốc: script
// tính lại min/max theo giờ Việt Nam lúc khách mở trang, nên chuỗi cố định lúc build sẽ lệch
// mốc ngay hôm sau. Server dựng sẵn một bản để không JS vẫn đọc được phạm vi.

const zaloUrl = contact?.zaloUrl || ''
const hotline = contact?.hotline || ''
const hotlineHref = hotline ? `tel:${hotline.replace(/\s+/g, '')}` : ''

if (!turnstileSiteKey) {
  console.warn('[BookingForm] thiếu PUBLIC_TURNSTILE_SITE_KEY — widget không render; production phải có cả site key lẫn secret (SPEC §4.7)')
}
---

<form
  id="dat-tour"
  class="bf"
  method="post"
  action="/api/dat-tour"
  novalidate
  data-price-table={JSON.stringify(priceTable)}
  data-seasons={JSON.stringify(seasons ?? [])}
  data-prepay-percent={String(prepayPercent)}
  data-quoted-at={quotedAt}
  data-site-key={turnstileSiteKey}
  data-zalo={zaloUrl}
  data-error-text={t('bookingError')}
  data-sending-text={t('bookingSending')}
  data-submit-text={t('bookingSubmit')}
  data-total-max={String(LIMITS.TOTAL_MAX)}
  data-per-type-max={String(LIMITS.PER_TYPE_MAX)}
  data-date-required={MSG.dateRequired}
  data-date-label={t('bookingDepartDate')}
  data-date-hint={t('bookingDepartDatePlaceholder')}
  data-subtotal-label={t('bookingSubtotal')}
  data-pay-required-text={t('bookingPayRequired')}
  data-before-discount-text={t('bookingBeforeDiscount')}
  data-discount-line-text={t('bookingDiscountLine')}
  data-grand-total-text={t('bookingGrandTotal')}
  data-season-note-tpl={t('bookingSeasonNote')}
  data-qr-alt-text={t('bookingQrAlt')}
  data-qr-copied-text={t('bookingQrCopied')}
>
  <input type="hidden" name="tourSlug" value={tourSlug} />
  <input type="hidden" name="tourTitle" value={tourTitle} />
  <input type="hidden" name="bookingRef" value={bookingRef} />
  <input type="hidden" name="quoted.quotedAt" value={quotedAt} />
  <input type="hidden" name="quoted.total" value={String(initialQuote?.total ?? 0)} data-quoted-total />
  {codes.map(code => (
    <input type="hidden" name={`quoted.perPax.${code}`} value={String(initialQuote?.perPax[code] ?? '')} data-quoted-per-pax={code} />
  ))}

  <section class="bf__step" data-step="1">
    {/* Nhan AN THI GIAC, khong xoa node: `for="bf-date"` la thu gan ten cho o ngay trong cay
        truy cap, va script doc lai chinh nhan nay khi dung bang tom tat truoc khi gui (~L738).
        Xoa la mat ca hai. Chu nhin thay da chuyen thanh lop phu tren mat o ngay
        (`.bf__date-face` ben duoi). Dung lai `.bf__sr-only` — cung tien le voi nhan "So nguoi"
        va nhan hinh thuc thanh toan ben duoi, khong dung display:none.
        `.bf__label-row` da bi go cung voi dau ⓘ cua o ngay: hang do ton tai de giu nhan va
        dau ⓘ CUNG MOT DONG, ma nay khong con ca hai. Dau ⓘ do chi chua cau "Chon ngay tu …
        den …", thu chu du an yeu cau go HOAN TOAN ngay 01/09. */}
    <label class="bf__sr-only" for="bf-date">{t('bookingDepartDate')}</label>
    {/* `value` dien san NGAY HIEN TAI de o ngay khong con trong. Ngay nay NUONG LUC DUNG
        nen se cu di sau nua dem — script keo lai ve `min` vua tinh theo gio Viet Nam (xem
        ~L410). Khong co doan keo do thi hom sau khach bam nut la an loi pham vi tren mot
        ngay ho chua he go. */}
    {/* LOP PHU TIENG VIET tren mat o ngay. `<input type="date">` la dieu khien goc cua trinh
        duyet: no khong nhan `placeholder`, va dinh dang chu trong o di theo NGON NGU GIAO DIEN
        trinh duyet chu khong theo `lang` cua trang — do duoc tren may chu du an: Chrome giao
        dien tieng Anh in ra dang mm/dd, nguoc voi quy uoc dd/mm cua site (de doc nham ngay).
        Nen chu goc bi lam trong suot va `.bf__date-face` ve lai bang tieng Viet: co ngay thi
        in dung ngay theo dd/mm ("01/09/2026"), o rong thi cau moi "Chon ngay khoi hanh" dong
        vai placeholder — thay cho cai nhan da bi go o tren.
        GIOI HAN da biet: LICH BUNG RA van la lich goc cua trinh duyet, ten thang trong do
        KHONG ep duoc — muon tieng Viet ca trong lich thi phai tu viet lich, la quyet dinh
        kien truc rieng (phien 01/09: chu du an chon huong lop phu, khong tu viet lich).
        `aria-hidden`: o ngay da tu doc gia tri cua no cho trinh doc man hinh. */}
    <div class="bf__date-wrap">
      <input id="bf-date" class="bf__input bf__input--date" type="date" name="departDate" required value={minDate} min={minDate} max={maxDate} />
      <span class="bf__date-face" aria-hidden="true" data-date-face>{formatDateVN(minDate)}</span>
      {/* Nut mo lich, TRONG SUOT va phu kin mat o. Phai dung SAU `.bf__date-face` trong DOM
          de nam tren no. Bam bat cu dau tren o cung mo lich tieng Viet — o ngay ben duoi da
          bi `pointer-events: none` nen khong con mo duoc lich goc cua trinh duyet nua. */}
      <button type="button" class="bf__date-trigger" data-cal-open aria-haspopup="dialog"
              aria-expanded="false" aria-label={t('bookingDepartDatePlaceholder')}>
        {/* Nut lich GOC cua trinh duyet da an (`::-webkit-calendar-picker-indicator`), nen o
            ngay se khong con dau hieu nao cho biet bam duoc. Ve lai mot cai o dung cho cu —
            `aria-hidden` vi nut boc ngoai da co `aria-label` roi, khong doc hai lan. */}
        <svg class="bf__date-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path d="M3 10h18M8 3v4M16 3v4" />
        </svg>
      </button>
      {/* LICH TU VE. Ly do ton tai: lich goc cua `<input type="date">` in ten thang theo NGON
          NGU GIAO DIEN trinh duyet, khong theo `lang` cua trang, va khong ep duoc — do duoc
          tren may chu du an: trang `lang="vi"` ma `Intl` phan giai ra 'en-US'. Chu du an yeu
          cau thang phai la tieng Viet (01/09), nen phai tu ve.
          O `<input type="date">` VAN O LAI va van la nguon su that cua gia tri: `value`,
          `min`, `max`, `checkValidity()`, va ten truong luc gui form deu giu nguyen, nen moi
          thu dang chay ben tren no — keo ngay ve `min`, tinh lai gia theo mua, ba cau bao loi
          — khong phai viet lai. Lich nay chi la mot loi CHON ngay khac. */}
      <div class="bf__cal" data-cal hidden role="dialog" aria-label={t('bookingDepartDatePlaceholder')}>
        <div class="bf__cal-head">
          <button type="button" class="bf__cal-nav" data-cal-prev aria-label={t('bookingCalPrev')}>‹</button>
          <span class="bf__cal-title" data-cal-title aria-live="polite"></span>
          <button type="button" class="bf__cal-nav" data-cal-next aria-label={t('bookingCalNext')}>›</button>
        </div>
        <div class="bf__cal-dow" aria-hidden="true">
          {THU_NGAN_VN.map(d => <span>{d}</span>)}
        </div>
        <div class="bf__cal-grid" data-cal-grid></div>
      </div>
    </div>
    <p class="bf__err" data-err="departDate" aria-live="polite"></p>

    {/* Nhan "So nguoi" AN THI GIAC, khong xoa node: `aria-labelledby` cua nhom ben duoi
        tro vao id nay, xoa la nhom dem so mat ten trong cay truy cap. Dung lai lop
        `.bf__sr-only` — dung tien le da co o nhan hinh thuc thanh toan ngay duoi (L174),
        khong dung display:none/visibility:hidden (hai cai do an luon voi trinh doc man hinh).
        Doi lop chu khong them: `.bf__label` con mang margin, giu lai se de mot khoang trong. */}
    <p class="bf__sr-only" id="bf-pax-label">{t('bookingPax')}</p>
    <div role="group" aria-labelledby="bf-pax-label">
      {codes.map(code => (
        <div class="bf__pax" data-code={code} data-label={paxLabel(code)}>
          <div class="bf__pax-info">
            {/* <div> chu khong phai <span>: <details> la flow content, khong phai phrasing
                content, nen khong duoc long trong <span> (vi pham content model HTML5,
                cung loai loi nhu nhan ngay o tren). Doi tag khong doi layout — .bf__pax-info
                la flex column nen phan tu nay da bi "blockify" thanh khoi du khai tag gi. */}
            <div class="bf__pax-name">
              {paxLabel(code)}
              {paxNote(code) && (
                <details class="bf__tip">
                  <summary class="bf__tip-mark" aria-label={t('info')}>i</summary>
                  <p class="bf__tip-body">{paxNote(code)}</p>
                </details>
              )}
            </div>
          </div>
          <div class="bf__stepper">
            <button type="button" class="bf__btn" data-dec aria-label={`${t('paxDecrease')} ${paxLabel(code)}`}>−</button>
            <input
              class="bf__count"
              type="number"
              inputmode="numeric"
              name={`pax.${code}`}
              min={code === 'adult' ? LIMITS.ADULT_MIN : 0}
              max={LIMITS.PER_TYPE_MAX}
              value={code === 'adult' ? LIMITS.ADULT_MIN : 0}
              aria-label={paxLabel(code)}
            />
            <button type="button" class="bf__btn" data-inc aria-label={`${t('paxIncrease')} ${paxLabel(code)}`}>+</button>
          </div>
        </div>
      ))}
    </div>
    <p class="bf__err" data-err="pax" aria-live="polite"></p>
    <p class="bf__hint" data-large-group hidden>{t('bookingLargeGroupHint')}</p>

    {prepayPercent > 0 && (
      <>
        {/* Task 6: nhãn ẩn thị giác nhưng còn tên cho trợ năng — đổi lớp sang
            `.bf__sr-only` (đã dựng ở Task 4, dùng lại, không dựng lớp thứ hai),
            giữ nguyên id + `aria-labelledby` bên dưới nên nhóm radio không mất
            tên trong cây trợ năng. KHÔNG dùng display:none/visibility:hidden —
            hai cái đó ẩn luôn với trình đọc màn hình. */}
        <p class="bf__sr-only" id="bf-pay-label">{t('bookingPayLabel')}</p>
        <div class="bf__pay" role="radiogroup" aria-labelledby="bf-pay-label">
          {/* Tick san "Chuyen khoan": day la hinh thuc duoc uu dai, va de o trong thi buoc 1
              chan lai bang loi `bookingPayRequired` o mot o khach chua he cham toi. Tam tinh
              dung san o tren (`initialQuote`) da tinh kem uu dai de khop trang thai nay. */}
          <label class="bf__pay-opt">
            <input type="radio" name="paymentMethod" value="transfer" checked />
            <span>{t('bookingPayTransfer').replace('{x}', String(prepayPercent))}</span>
          </label>
          <label class="bf__pay-opt">
            <input type="radio" name="paymentMethod" value="onboard" />
            <span>{t('bookingPayOnboard')}</span>
          </label>
        </div>
        <p class="bf__err" data-err="paymentMethod" aria-live="polite"></p>
      </>
    )}

    <div class="bf__quote" aria-live="polite">
      <div data-quote-lines>
        {initialQuote?.lines.map(l => (
          <div class="bf__line"><span>{paxLabel(l.code)} × {l.count}</span><span>{formatPrice(l.subtotal, lang)}</span></div>
        ))}
      </div>
      <div class="bf__total">
        {/* <div> chu khong phai <span>: cung ly do o hai cho tren — <details> khong phai
            phrasing content. .bf__total la flex row 2 phan tu (nhan + so tien), doi tag
            khong doi layout vi day van la mot flex item duy nhat, khong tach hang moi. */}
        <div class="bf__total-label">
          {t('bookingSubtotal')}
          <details class="bf__tip">
            <summary class="bf__tip-mark" aria-label={t('info')}>i</summary>
            <p class="bf__tip-body">{t('bookingSubtotalNote')}</p>
          </details>
        </div>
        <strong data-total>{initialQuote ? formatPrice(initialQuote.total, lang) : '—'}</strong>
      </div>
    </div>
    {/* Task 8 (SPEC-2026-08-31-form-dat-tour-gon-va-chi-tiet-gia.md §4.5): bảng chi tiết giá.
        Gộp nội dung của .bf__season/.bf__prepay cũ (đã xoá — §4.5.3, hai node đó in TRÙNG
        con số với bảng này). Đặt NGOÀI .bf__quote (đóng ở trên) vì .bf__quote mang
        aria-live="polite" và bị replaceChildren() mỗi lần bấm +/− — lồng bảng chi tiết vào
        trong đó là mỗi lần đổi số khách trình đọc màn hình đọc lại toàn bộ bảng (§4.5.4 luật 3).
        Mặc định ĐÓNG (không đặt `open` — <details> tự quản trạng thái mở/đóng của nó); server
        dựng kèm `hidden` (2026-08-31: thân bảng chỉ có sau khi JS chạy, không hidden thì
        khách tắt JS thấy nút mở ra rỗng) — script gỡ `hidden` trong update() khi có quote (luật
        render 2), không phải qua CSS display. */}
    <details class="bf__detail" data-quote-detail hidden>
      <summary class="bf__detail-sum">{t('bookingPriceDetail')}</summary>
      <div class="bf__detail-body" data-detail-lines></div>
    </details>

    <button type="button" class="bf__primary" data-open>{t('bookingBookNow')}</button>
    {zaloUrl && <a class="bf__secondary" href={zaloUrl} target="_blank" rel="noopener">{t('bookingFreeConsult')}</a>}
    {hotline && <p class="bf__hotline">{t('bookingHotline')}: <a href={hotlineHref}>{hotline}</a></p>}
  </section>

  <section class="bf__step" data-step="2">
    <label class="bf__label" for="bf-name">{t('bookingName')}</label>
    <input id="bf-name" class="bf__input" type="text" name="name" autocomplete="name" required minlength={LIMITS.NAME_MIN} maxlength={LIMITS.NAME_MAX} />
    <p class="bf__err" data-err="name" aria-live="polite"></p>

    <label class="bf__label" for="bf-phone">{t('bookingPhone')}</label>
    <input id="bf-phone" class="bf__input" type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
    <p class="bf__err" data-err="phone" aria-live="polite"></p>

    <label class="bf__label" for="bf-email">{t('bookingEmail')}</label>
    <input id="bf-email" class="bf__input" type="email" name="email" autocomplete="email" maxlength={LIMITS.EMAIL_MAX} />
    <p class="bf__err" data-err="email" aria-live="polite"></p>

    <label class="bf__label" for="bf-pickup">{t('bookingPickup')}</label>
    <input id="bf-pickup" class="bf__input" type="text" name="pickup" maxlength={LIMITS.PICKUP_MAX} />
    <p class="bf__err" data-err="pickup" aria-live="polite"></p>

    <label class="bf__label" for="bf-note">{t('bookingNote')}</label>
    <textarea id="bf-note" class="bf__input" name="note" rows="3" maxlength={LIMITS.NOTE_MAX}></textarea>
    <p class="bf__err" data-err="note" aria-live="polite"></p>

    <!-- honeypot: người thật không thấy, bot điền bừa → server trả lời giả, không lưu -->
    <div class="bf__hp" aria-hidden="true">
      <label for="bf-website">Website</label>
      <input id="bf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="bf__turnstile" data-turnstile></div>
    <input type="hidden" name="turnstileToken" data-turnstile-token />

    <p class="bf__err bf__err--form" data-err="form" aria-live="polite"></p>
    <div class="bf__actions">
      <button type="button" class="bf__secondary" data-back>{t('bookingBack')}</button>
      <button type="submit" class="bf__primary" data-submit>{t('bookingSubmit')}</button>
    </div>
  </section>

  <section class="bf__done" data-done hidden role="status" tabindex="-1">
    <h3 class="bf__done-title">{t('bookingSuccessTitle')}</h3>
    <p class="bf__done-code">{t('bookingCode')}: <strong data-done-code></strong></p>
    <p class="bf__done-dup" data-done-dup hidden>{t('bookingDuplicate')}</p>
    <div class="bf__quote" data-done-summary></div>

    {/* Khối QR — chỉ hiện khi khách chọn chuyển khoản, và KHÔNG BAO GIỜ hiện với đơn trùng
        (SPEC §4.5: mọi con số ở đây dựng từ `quote` của lần nộp MỚI, không phải từ đơn đã lưu).
        Tên ngân hàng / số TK / chủ TK render sẵn từ site.config: chúng là hằng số biên dịch,
        nên có mặt trong HTML tĩnh và chọn-copy được kể cả trước khi script chạy.
        Ảnh QR không bao giờ là đường duy nhất — khối chữ bên cạnh phải đủ để chuyển tay,
        vì img.vietqr.io là bên thứ ba và compact2 KHÔNG in nội dung chuyển khoản (SPEC §11.4). */}
    <div class="bf__qr" data-qr hidden>
      <h4 class="bf__qr-title">{t('bookingQrTitle')}</h4>
      <div class="bf__qr-body">
        <div class="bf__qr-visual">
          <img class="bf__qr-img" data-qr-img alt={t('bookingQrTitle')} width="540" height="640" loading="lazy" decoding="async" />
          <button type="button" class="bf__secondary bf__qr-dl" data-qr-download>{t('bookingQrDownload')}</button>
          <p class="bf__qr-hint">{t('bookingQrSaveHint')}</p>
        </div>
        <dl class="bf__qr-facts">
          <div class="bf__qr-row">
            <dt>{t('bookingQrBank')}</dt>
            <dd>{banking.bankName}</dd>
          </div>
          <div class="bf__qr-row">
            <dt>{t('bookingQrAccount')}</dt>
            <dd>
              <span class="bf__qr-mono">{banking.accountNumber}</span>
              <button type="button" class="bf__qr-copy" data-copy={banking.accountNumber}>{t('bookingQrCopy')}</button>
            </dd>
          </div>
          <div class="bf__qr-row">
            <dt>{t('bookingQrHolder')}</dt>
            <dd>{banking.accountName}</dd>
          </div>
          <div class="bf__qr-row">
            <dt>{t('bookingQrAmount')}</dt>
            <dd><strong class="bf__qr-amount" data-qr-amount></strong></dd>
          </div>
          <div class="bf__qr-row">
            <dt>{t('bookingQrContent')}</dt>
            <dd>
              <span class="bf__qr-mono" data-qr-content></span>
              <button type="button" class="bf__qr-copy" data-qr-copy-content>{t('bookingQrCopy')}</button>
            </dd>
          </div>
        </dl>
      </div>
      <p class="bf__qr-note">{t('bookingQrContentNote')}</p>
    </div>

    <p class="bf__note">{t('bookingSuccessBody')}</p>
    {zaloUrl && <a class="bf__primary bf__primary--link" href={zaloUrl} target="_blank" rel="noopener">{t('contactZalo')}</a>}
  </section>

  <noscript><p class="bf__noscript">{t('bookingNoScript')}</p></noscript>
</form>

<script>
  import { PAX_ORDER, computeQuote, type PaxCode, type PaxCounts, type PriceTable, type Quote } from '../lib/booking/quote'
  import type { Season } from '../lib/booking/season'
  import { formatPrice } from '../lib/renderer'
  import { addDaysISO, formatDateVN, thangNamVN, todayVN } from '../lib/booking/vn-date'
  import { LIMITS, MSG, buildQuotedPayload, type PaymentMethod } from '../lib/booking/schema'
  import { buildPaymentQr } from '../lib/booking/payment-qr'
  import { banking } from '../site.config'

  declare global {
    interface Window {
      turnstile?: {
        render(el: HTMLElement, opts: Record<string, unknown>): string
        reset(id?: string): void
      }
    }
  }

  const form = document.getElementById('dat-tour') as HTMLFormElement | null
  if (form) init(form)

  // Nhãn kèm dấu ⓘ (`.bf__tip`) lồng một `<details>` con ngay trong node nhãn (Task 4), nên
  // `.textContent` trần của node đó giờ dính cả chữ "i" lẫn nội dung ghi chú phía trong —
  // KỂ CẢ khi `<details>` đang đóng, vì đóng chỉ ẩn hiển thị chứ không rút node khỏi DOM.
  // Hàm này chỉ lấy các text node con TRỰC TIẾP (bỏ qua phần tử con như `<details>`), để hai
  // chỗ dưới đây tiếp tục lấy đúng nhãn gốc, không dính chữ ghi chú.
  function directText(el: Element | null | undefined): string {
    if (!el) return ''
    return Array.from(el.childNodes)
      .filter(n => n.nodeType === Node.TEXT_NODE)
      .map(n => n.textContent || '')
      .join(' ')
      .trim()
  }

  function init(form: HTMLFormElement) {
    const q = <T extends Element>(sel: string) => form.querySelector<T>(sel)
    const table = JSON.parse(form.dataset.priceTable || 'null') as PriceTable | null
    if (!table) return
    const seasons = JSON.parse(form.dataset.seasons || '[]') as Season[]
    const prepayPercent = Number(form.dataset.prepayPercent) || 0
    const payRequiredText = form.dataset.payRequiredText || ''
    // Task 8 — bảng chi tiết giá. Script KHÔNG gọi được t() (module riêng, không thấy frontmatter),
    // nên bốn chuỗi này phải đi qua data-* nướng sẵn ở markup (xem data-*-text trên <form>).
    const beforeDiscountText = form.dataset.beforeDiscountText || ''
    const discountLineText = form.dataset.discountLineText || ''
    const grandTotalText = form.dataset.grandTotalText || ''
    const seasonNoteTpl = form.dataset.seasonNoteTpl || ''
    const payEls = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]'))
    const chonChuyenKhoan = () => payEls.some(el => el.checked && el.value === 'transfer')
    payEls.forEach(el => el.addEventListener('change', update))
    const siteKey = form.dataset.siteKey || ''
    const quotedAt = form.dataset.quotedAt || ''
    const totalMax = Number(form.dataset.totalMax) || LIMITS.TOTAL_MAX
    const perTypeMax = Number(form.dataset.perTypeMax) || LIMITS.PER_TYPE_MAX

    const step1 = q<HTMLElement>('[data-step="1"]')!
    const step2 = q<HTMLElement>('[data-step="2"]')!
    const done = q<HTMLElement>('[data-done]')!
    const openBtn = q<HTMLButtonElement>('[data-open]')!
    const backBtn = q<HTMLButtonElement>('[data-back]')!
    const submitBtn = q<HTMLButtonElement>('[data-submit]')!
    const dateEl = q<HTMLInputElement>('[name="departDate"]')!
    const linesEl = q<HTMLElement>('[data-quote-lines]')!
    const totalEl = q<HTMLElement>('[data-total]')!
    const detailBox = q<HTMLElement>('[data-detail-lines]')!
    const detailWrap = q<HTMLDetailsElement>('[data-quote-detail]')!
    const hintEl = q<HTMLElement>('[data-large-group]')!
    const paxErrEl = q<HTMLElement>('[data-err="pax"]')!
    const totalInput = q<HTMLInputElement>('[data-quoted-total]')!
    const tokenInput = q<HTMLInputElement>('[data-turnstile-token]')!
    const qrBox = q<HTMLElement>('[data-qr]')!
    const dlBtn = q<HTMLButtonElement>('[data-qr-download]')!
    const copyNoiDungBtn = q<HTMLButtonElement>('[data-qr-copy-content]')!

    // Nút chép cho giá trị TĨNH (số tài khoản): nội dung nằm sẵn trong data-copy từ lúc dựng,
    // nên gắn một lần ở đây. Nút chép nội dung chuyển khoản gắn trong hienQr() vì mã đơn chỉ
    // có sau khi server trả lời.
    for (const btn of Array.from(form.querySelectorAll<HTMLButtonElement>('[data-copy]'))) {
      btn.addEventListener('click', () => { void chep(btn, btn.dataset.copy || '') })
    }
    const widgetEl = q<HTMLElement>('[data-turnstile]')!

    // Tăng cường dần: không JS thì bước 2 hiện sẵn; có JS thì gấp lại.
    step2.hidden = true

    // Ngày: từ HÔM NAY tới +MAX_DAYS_AHEAD theo giờ Việt Nam, tính lại ở client để không lệ
    // thuộc giờ build. Không viết con số vào đây — hằng ở schema.ts là nguồn duy nhất.
    // Mốc dưới = `today` trần, khớp `schema.ts` (QĐ-2026-09-01-01, nhận đặt đi trong ngày).
    const today = todayVN()
    dateEl.min = today
    dateEl.max = addDaysISO(today, LIMITS.MAX_DAYS_AHEAD)
    // Ngày điền sẵn ở markup được NƯỚNG LÚC DỰNG. Qua nửa đêm là nó tụt xuống dưới `min` vừa
    // tính lại ở trên, và khách bấm "Đặt tour ngay" ăn ngay lỗi phạm vi trên một giá trị họ
    // không hề gõ. Kéo lại về hôm nay; ngày khách đã tự chọn về sau thì không đụng.
    // Phải nằm TRƯỚC `update()` (~L570) để tạm tính mở màn ăn đúng mùa của ngày này.
    if (!dateEl.value || dateEl.value < dateEl.min) dateEl.value = dateEl.min

    // Lop phu tieng Viet tren mat o ngay (xem comment o markup ~L142). Phai ve lai SAU khi keo
    // ngay o tren, neu khong no dung nguyen o ngay nuong luc dung trong khi o ngay da nhay.
    const dateFaceEl = q<HTMLElement>('[data-date-face]')
    const dateHint = form.dataset.dateHint || ''
    const veLaiMatNgay = () => {
      if (!dateFaceEl) return
      const v = dateEl.value
      // O ngay xoa trang duoc → quay ve cau moi, dung lop rieng de doi mau sang muted.
      dateFaceEl.textContent = v ? formatDateVN(v) : dateHint
      dateFaceEl.classList.toggle('bf__date-face--empty', !v)
    }
    veLaiMatNgay()
    dateEl.addEventListener('change', veLaiMatNgay)
    dateEl.addEventListener('input', veLaiMatNgay)

    /* ── Lich tieng Viet tu ve ────────────────────────────────────────────────────────
       Xem comment o markup (~L150) cho ly do ton tai. O `<input type="date">` van la nguon
       su that; lich nay chi ghi vao `dateEl.value` roi BAN 'change' — bat buoc phai ban tay,
       vi gan `.value` bang script KHONG tu sinh su kien, va ca lop phu mat o lan doan tinh
       lai gia theo mua deu dang nghe 'change'. */
    const calEl = q<HTMLElement>('[data-cal]')
    const calOpenBtn = q<HTMLButtonElement>('[data-cal-open]')
    const calTitleEl = q<HTMLElement>('[data-cal-title]')
    const calGridEl = q<HTMLElement>('[data-cal-grid]')
    const calPrevBtn = q<HTMLButtonElement>('[data-cal-prev]')
    const calNextBtn = q<HTMLButtonElement>('[data-cal-next]')

    if (calEl && calOpenBtn && calTitleEl && calGridEl && calPrevBtn && calNextBtn) {
      // Thang dang xem, doc lap voi ngay dang chon: khach lat qua thang khac ma chua chon gi
      // thi ngay chon van nguyen.
      let thangXem = { y: 0, m: 0 }

      const tachISO = (iso: string) => {
        const [y, m, d] = iso.split('-').map(Number)
        return { y, m: m - 1, d }
      }
      const ghepISO = (y: number, m: number, d: number) =>
        `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`

      const veLich = () => {
        const { y, m } = thangXem
        calTitleEl.textContent = thangNamVN(y, m)
        // `Date.UTC` chu khong `new Date(y, m, ...)`: cung ly do voi `addDaysISO` — gio may
        // khach lech mui co the day sang ngay khac.
        const dauThang = new Date(Date.UTC(y, m, 1))
        const oTrong = dauThang.getUTCDay()               // CN = 0, khop THU_NGAN_VN
        const soNgay = new Date(Date.UTC(y, m + 1, 0)).getUTCDate()
        const min = dateEl.min, max = dateEl.max, dangChon = dateEl.value

        calGridEl.textContent = ''
        // O trong dau thang: <span> chu khong <button>, de ban phim khong dung vao o rong.
        for (let i = 0; i < oTrong; i++) calGridEl.appendChild(document.createElement('span'))
        for (let d = 1; d <= soNgay; d++) {
          const iso = ghepISO(y, m, d)
          const b = document.createElement('button')
          b.type = 'button'
          b.className = 'bf__cal-day'
          b.textContent = String(d)
          b.dataset.iso = iso
          // Ngoai pham vi thi KHONG bam duoc ngay tu trong luoi, chu khong de bam roi bao loi.
          if ((min && iso < min) || (max && iso > max)) b.disabled = true
          if (iso === dangChon) { b.classList.add('is-chon'); b.setAttribute('aria-current', 'date') }
          calGridEl.appendChild(b)
        }
        // Het pham vi thi khoa luon nut lat thang, khong cho lat vao vung trong tron.
        calPrevBtn.disabled = !!min && ghepISO(y, m, 1) <= min
        calNextBtn.disabled = !!max && ghepISO(y, m, soNgay) >= max
      }

      const moLich = () => {
        const goc = tachISO(dateEl.value || dateEl.min || todayVN())
        thangXem = { y: goc.y, m: goc.m }
        veLich()
        calEl.classList.remove('bf__cal--tren')
        calEl.hidden = false
        calOpenBtn.setAttribute('aria-expanded', 'true')
        // Lich luon xo XUONG thi khi o ngay nam gan day man hinh, ca bang roi khoi tam nhin va
        // khach khong bam duoc gi — do duoc tren production: bang o y=1134 trong khi man hinh
        // cao 929. Khong du cho duoi ma tren rong hon thi lat len. Do SAU khi bo `hidden`, vi
        // node dang an khong co kich thuoc de do.
        const oHop = dateEl.getBoundingClientRect()
        const cao = calEl.getBoundingClientRect().height
        if (innerHeight - oHop.bottom < cao && oHop.top > innerHeight - oHop.bottom) {
          calEl.classList.add('bf__cal--tren')
        }
        // Lat roi van co the con thieu cho (man hinh thap, bang cao). Keo not vao tam nhin.
        const sau = calEl.getBoundingClientRect()
        if (sau.top < 0 || sau.bottom > innerHeight) calEl.scrollIntoView({ block: 'nearest' })
        ;(calGridEl.querySelector<HTMLButtonElement>('.is-chon')
          || calGridEl.querySelector<HTMLButtonElement>('.bf__cal-day:not([disabled])'))?.focus()
      }
      const dongLich = (traFocus = true) => {
        if (calEl.hidden) return
        calEl.hidden = true
        calOpenBtn.setAttribute('aria-expanded', 'false')
        if (traFocus) calOpenBtn.focus()
      }

      calOpenBtn.addEventListener('click', () => { calEl.hidden ? moLich() : dongLich() })
      calPrevBtn.addEventListener('click', () => {
        thangXem = thangXem.m === 0 ? { y: thangXem.y - 1, m: 11 } : { y: thangXem.y, m: thangXem.m - 1 }
        veLich()
      })
      calNextBtn.addEventListener('click', () => {
        thangXem = thangXem.m === 11 ? { y: thangXem.y + 1, m: 0 } : { y: thangXem.y, m: thangXem.m + 1 }
        veLich()
      })
      calGridEl.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.bf__cal-day')
        if (!b || b.disabled) return
        dateEl.value = b.dataset.iso!
        // BAN TAY: gan `.value` bang script khong tu sinh su kien nao.
        dateEl.dispatchEvent(new Event('input', { bubbles: true }))
        dateEl.dispatchEvent(new Event('change', { bubbles: true }))
        dongLich()
      })

      // Ban phim: Esc dong lich, mui ten lat ngay, Tab ra ngoai thi dong.
      calEl.addEventListener('keydown', e => {
        if (e.key === 'Escape') { e.preventDefault(); dongLich(); return }
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.bf__cal-day')
        if (!b) return
        const buoc = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1
          : e.key === 'ArrowDown' ? 7 : e.key === 'ArrowUp' ? -7 : 0
        if (!buoc) return
        e.preventDefault()
        const dich = addDaysISO(b.dataset.iso!, buoc)
        if ((dateEl.min && dich < dateEl.min) || (dateEl.max && dich > dateEl.max)) return
        const t = tachISO(dich)
        if (t.y !== thangXem.y || t.m !== thangXem.m) { thangXem = { y: t.y, m: t.m }; veLich() }
        calGridEl.querySelector<HTMLButtonElement>(`[data-iso="${dich}"]`)?.focus()
      })
      // `contains()` chu KHONG so sanh dong nhat `!== calOpenBtn`: nut mo boc mot <svg>, nen
      // cu bam len bieu tuong co `e.target` la chinh the <svg> chu khong phai cai nut. So bang
      // `!==` thi cu bam do bi coi la "bam ra ngoai" va dong sap lich ngay sau khi vua mo —
      // do duoc bang chuot that tren production: bam giua o thi mo, bam dung bieu tuong thi
      // khong. `element.click()` trong script KHONG lo ra loi nay vi no dat target la cai nut.
      calEl.addEventListener('focusout', e => {
        const t = e.relatedTarget as Node | null
        if (!calEl.contains(t) && !calOpenBtn.contains(t)) dongLich(false)
      })
      document.addEventListener('click', e => {
        const t = e.target as Node
        if (!calEl.hidden && !calEl.contains(t) && !calOpenBtn.contains(t)) dongLich(false)
      })
      // `pointer-events: none` chan duoc CHUOT tren o ngay, KHONG chan duoc ban phim: Chrome
      // van mo lich goc bang Alt+Mui-ten-xuong hoac F4 khi o dang duoc focus. Chan hai phim
      // do va mo lich cua minh, neu khong ban phim van gap ten thang tieng Anh.
      dateEl.addEventListener('keydown', e => {
        if (e.key === 'F4' || (e.altKey && e.key === 'ArrowDown')) { e.preventDefault(); moLich() }
      })
    }

    // Ngày ngoài phạm vi: nói THẲNG sai ở đâu thay vì đọc lại phạm vi. Câu "Chọn ngày từ …
    // đến …" đã gỡ hoàn toàn (chủ dự án chốt 01/09), nên chỗ này không còn nguồn nào để
    // dựng lại nó. Dùng đúng ba câu MSG mà PHÍA MÁY CHỦ trả về cho cùng ba tình huống
    // (schema.ts) — một nguồn sự thật, khách không thấy hai lối diễn đạt cho một lỗi.
    // KHÔNG rơi về `dateEl.validationMessage`: đó là câu của trình duyệt, đi theo ngôn ngữ
    // giao diện trình duyệt nên ra tiếng Anh giữa một form tiếng Việt (đo được trên máy chủ
    // dự án: Intl phân giải en-US dù trang lang="vi").
    const cauLoiNgay = () => {
      const v = dateEl.value
      if (v && dateEl.min && v < dateEl.min) return MSG.dateTooEarly
      if (v && dateEl.max && v > dateEl.max) return MSG.dateTooFar
      return MSG.dateInvalid
    }
    // Đổi ngày khởi hành có thể đổi mùa áp dụng, nên phải tính lại tạm tính ngay (Task 5).
    dateEl.addEventListener('change', update)

    // Bộ đếm
    const rows = new Map<PaxCode, { input: HTMLInputElement; label: string; inc: HTMLButtonElement; dec: HTMLButtonElement }>()
    form.querySelectorAll<HTMLElement>('.bf__pax').forEach(row => {
      const code = row.dataset.code as PaxCode
      const input = row.querySelector<HTMLInputElement>('input')!
      const inc = row.querySelector<HTMLButtonElement>('[data-inc]')!
      const dec = row.querySelector<HTMLButtonElement>('[data-dec]')!
      rows.set(code, { input, label: row.dataset.label || code, inc, dec })
      dec.addEventListener('click', () => { input.value = String(Math.max(Number(input.min) || 0, (parseInt(input.value, 10) || 0) - 1)); update() })
      inc.addEventListener('click', () => { input.value = String(Math.min(perTypeMax, (parseInt(input.value, 10) || 0) + 1)); update() })
      input.addEventListener('change', update)
    })

    // Lý do một thao tác vừa bị kéo về giới hạn. Chỉ sống tới lần update() kế tiếp: thao tác
    // hợp lệ sau đó phải xoá được thông báo, không để nó đọng lại trên màn hình.
    let clampMsg = ''
    function readPax(): PaxCounts {
      const pax: PaxCounts = { adult: 0, child: 0, senior: 0, infant: 0 }
      rows.forEach((r, code) => {
        const min = Number(r.input.min) || 0
        const raw = parseInt(r.input.value, 10) || 0
        const v = Math.min(perTypeMax, Math.max(min, raw))
        // Gõ tay số dưới mức tối thiểu thì bị kéo về im lặng; ghi lại để update() nói ra.
        if (raw < min && code === 'adult') clampMsg = MSG.adultMin
        r.input.value = String(v)
        pax[code] = v
      })
      return pax
    }

    // Tắt một nút đang giữ tiêu điểm sẽ ném `activeElement` về `<body>`, và phím Tab kế tiếp
    // bắt đầu lại từ đầu trang chi tiết (cao ~19.000px). Dời tiêu điểm sang ô số cùng hàng trước.
    function setBtnDisabled(btn: HTMLButtonElement, off: boolean, fallback: HTMLElement) {
      if (off && !btn.disabled && document.activeElement === btn) fallback.focus({ preventScroll: true })
      btn.disabled = off
    }

    let quote: Quote | null = null
    function update() {
      const pax = readPax()
      const total = PAX_ORDER.reduce((n, c) => n + pax[c], 0)
      const chon = chonChuyenKhoan()
      quote = computeQuote(table!, pax, { seasons, departDate: dateEl.value, prepayPercent, prepay: chon })

      linesEl.replaceChildren()
      if (quote) {
        for (const l of quote.lines) {
          const div = document.createElement('div')
          div.className = 'bf__line'
          const a = document.createElement('span'); a.textContent = `${rows.get(l.code)?.label ?? l.code} × ${l.count}`
          const b = document.createElement('span'); b.textContent = formatPrice(l.subtotal, 'vi')
          div.append(a, b); linesEl.append(div)
        }
      }
      totalEl.textContent = quote ? formatPrice(quote.total, 'vi') : '—'

      // Bảng chi tiết giá (Task 8). Dòng do JS dựng qua createElement KHÔNG mang
      // data-astro-cid-*, nên CSS phải nhắm qua :global() (xem [data-detail-lines] trong
      // <style>) — bỏ qua là tái hiện lỗi "Người lớn × 1019.550.000₫" (DR-102, 2026-08-29).
      detailBox.replaceChildren()
      if (quote) {
        // Luật render 2: quote null (vượt bậc / hạng không có giá) → KHÔNG dựng bảng rỗng —
        // ẩn cả khối kể cả dòng tóm tắt "Xem chi tiết giá".
        detailWrap.hidden = false

        // Bốn mốc chính xác (SPEC §4.5.1): mọi số tiền lấy NGUYÊN từ quote, không tự nhân —
        // apDieuChinh() áp cả hai phần trăm rồi mới làm tròn lên nghìn, nên totalGoc − total
        // đúng nhưng KHÔNG bằng percent% của totalGoc.
        const detailRows: [string, string][] = quote.lines.map(l =>
          [`${rows.get(l.code)?.label ?? l.code} × ${l.count}`, formatPrice(l.subtotal, 'vi')])
        // Luật render 3: KHÔNG ưu đãi → quote.prepay VẮNG → không có totalGoc. Hai dòng giữa
        // biến mất — đây là luật render, TUYỆT ĐỐI không tính bù bằng nhân ngược (làm tròn
        // lên nghìn không có phép nghịch đảo).
        if (quote.prepay) {
          detailRows.push([beforeDiscountText, formatPrice(quote.prepay.totalGoc, 'vi')])
          detailRows.push([
            `${discountLineText} (−${quote.prepay.percent}%)`,
            `−${formatPrice(quote.prepay.totalGoc - quote.total, 'vi')}`,
          ])
        }
        detailRows.push([grandTotalText, formatPrice(quote.total, 'vi')])

        detailRows.forEach(([label, amount], i) => {
          const div = document.createElement('div')
          div.className = i === detailRows.length - 1 ? 'bf__line bf__line--total' : 'bf__line'
          const a = document.createElement('span'); a.textContent = label
          const b = document.createElement('span'); b.textContent = amount
          div.append(a, b); detailBox.append(div)
        })

        // Luật render 1: không có mùa → không render ghi chú, không in "+0%".
        if (quote.season) {
          const note = document.createElement('p')
          note.className = 'bf__tip-body'
          // Vòng sửa 1/5: Studio cho phanTram ÂM (bangGiaMuaVu.ts:47, min(-90)) — mùa thấp
          // điểm GIẢM giá là tính năng đã thiết kế, không phải dữ liệu sai. Dấu + chỉ chèn
          // khi dương, đúng khuôn đã có ở bangGiaMuaVu.ts:63 (Studio preview.prepare) và ở
          // .bf__season cũ (đã xoá ở Task 8) — thiếu guard này in ra "+-15%" cho mùa giảm giá.
          const dau = quote.season.percent > 0 ? '+' : ''
          note.textContent = seasonNoteTpl
            .replace('{name}', quote.season.name)
            .replace('{p}', dau + String(quote.season.percent))
          detailBox.append(note)
        }
      } else {
        detailWrap.hidden = true
      }

      totalInput.value = String(quote?.total ?? 0)
      form.querySelectorAll<HTMLInputElement>('[data-quoted-per-pax]').forEach(el => {
        const code = el.dataset.quotedPerPax as PaxCode
        el.value = quote && typeof quote.perPax[code] === 'number' ? String(quote.perPax[code]) : ''
      })

      const atCap = total >= totalMax || !quote
      rows.forEach(r => {
        const v = parseInt(r.input.value, 10) || 0
        setBtnDisabled(r.inc, atCap || v >= perTypeMax, r.input)
        // "+" biết tự tắt còn "-" thì không: ở mức tối thiểu nó vẫn sáng nhưng bấm vô ích.
        setBtnDisabled(r.dec, v <= (Number(r.input.min) || 0), r.input)
      })

      // Nút mờ đi mà không một chữ nào là lỗi đo được: khách tưởng nút hỏng. Nói ra lý do
      // đang chặn, ưu tiên trần tổng vì nó khoá mọi hàng chứ không riêng hàng nào.
      let paxMsg = clampMsg
      clampMsg = ''
      if (!paxMsg && total >= totalMax) paxMsg = MSG.totalMax
      if (!paxMsg && PAX_ORDER.some(c => pax[c] >= perTypeMax)) paxMsg = MSG.perTypeMax
      paxErrEl.textContent = paxMsg
      // MSG.totalMax đã chứa sẵn lời mời nhắn Zalo y như hintEl, nên chỉ hiện một trong hai.
      hintEl.hidden = !!paxMsg || !!quote
      openBtn.disabled = !quote
    }
    update()

    // Lỗi theo ô
    function showErr(field: string, msg: string) {
      const el = form.querySelector<HTMLElement>(`[data-err="${field}"]`)
      if (el) el.textContent = msg
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`)
      if (input) input.setAttribute('aria-invalid', 'true')
    }
    function clearErrs() {
      form.querySelectorAll<HTMLElement>('[data-err]').forEach(el => { el.textContent = '' })
      form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'))
    }

    // Bước 2 + Turnstile nạp lười
    let widgetId: string | null = null
    let turnstileLoaded = false
    function loadTurnstile() {
      if (!siteKey || turnstileLoaded) return
      turnstileLoaded = true
      const s = document.createElement('script')
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
      s.async = true
      s.onload = () => {
        if (!window.turnstile) return
        widgetId = window.turnstile.render(widgetEl, {
          sitekey: siteKey,
          callback: (token: string) => { tokenInput.value = token },
          'expired-callback': () => { tokenInput.value = '' },
          'error-callback': () => { tokenInput.value = '' },
        })
      }
      document.head.appendChild(s)
    }

    // Thân của nút "Đặt tour ngay" tách thành hàm để Enter ở bước 1 gọi lại được ĐÚNG luồng
    // này (xem chốt trong handler submit), không phải một bản chép đôi dễ lệch.
    function openStep2() {
      clearErrs()
      if (!dateEl.value) {
        // Câu của mình TRƯỚC `validationMessage`. Thứ tự cũ (validationMessage trước) đưa chuỗi
        // của trình duyệt lên — theo ngôn ngữ trình duyệt, không theo ngôn ngữ trang, nên khách
        // Việt nhận "Please fill out this field." giữa một form tiếng Việt.
        showErr('departDate', form.dataset.dateRequired || dateEl.validationMessage || '')
        // `focus()` trần cuộn tối thiểu: ô ngày dừng sát mép trên, nơi header và thanh dính che
        // mất nó cùng dòng báo lỗi ngay dưới — người bấm chỉ thấy trang nhảy, tưởng nút hỏng
        // (chủ dự án báo đúng triệu chứng này 2026-08-29). Đưa ô vào giữa màn hình rồi mới focus.
        dateEl.focus({ preventScroll: true })
        dateEl.scrollIntoView({ block: 'center' })
        return
      }
      // `min`/`max` của ô ngày chỉ chặn được mũi tên lịch, không chặn ngày gõ tay. Không chốt
      // ở đây thì ngày ngoài phạm vi lọt hết bước 1 và khách chỉ biết sau khi server trả về.
      if (!dateEl.checkValidity()) {
        showErr('departDate', cauLoiNgay() || dateEl.validationMessage || '')
        dateEl.focus({ preventScroll: true })
        dateEl.scrollIntoView({ block: 'center' })
        return
      }
      if (payEls.length && !payEls.some(el => el.checked)) {
        showErr('paymentMethod', payRequiredText)
        payEls[0]?.focus()
        return
      }
      step2.hidden = false
      openBtn.hidden = true
      q<HTMLInputElement>('[name="name"]')?.focus()
      loadTurnstile()
    }
    openBtn.addEventListener('click', openStep2)
    backBtn.addEventListener('click', () => { step2.hidden = true; openBtn.hidden = false; openBtn.focus() })

    // Gửi
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      clearErrs()
      // Nút [data-submit] nằm trong bước 2 nhưng vẫn là nút mặc định của form, nên Enter ở ô
      // ngày lúc bước 2 đang gấp vẫn kích hoạt implicit submission: một POST thật đi ra với
      // tên/SĐT/token rỗng, còn lỗi trả về rơi vào các ô đang bị ẩn nên khách không thấy gì.
      // Bước 2 chưa mở thì Enter phải chạy đúng luồng của nút mở, rồi dừng.
      if (step2.hidden) {
        if (!openBtn.disabled) openStep2()
        return
      }
      if (!quote) return
      // Chốt hai giá trị này NGAY BÂY GIỜ, không đọc lại sau `await`. Khách bấm đổi hạng khách
      // hay đổi hình thức thanh toán trong lúc fetch đang chạy là `quote` bị `update()` gán
      // lại — khối thành công sẽ in một số tiền KHÁC số vừa gửi lên server, và số đó đi thẳng
      // lên mã QR. Đây đúng loại lỗi "bẫy tiền thật" mà SPEC §4.5 cảnh báo cho ca đơn trùng.
      const pmDaGui: PaymentMethod = chonChuyenKhoan() ? 'transfer' : 'onboard'
      const tongDaGui = quote.total
      const fd = new FormData(form)
      const val = (k: string) => String(fd.get(k) ?? '').trim()
      const payload = {
        tourSlug: val('tourSlug'), tourTitle: val('tourTitle'), bookingRef: val('bookingRef'),
        departDate: val('departDate'), pax: readPax(),
        quoted: buildQuotedPayload(quote, quotedAt),
        name: val('name'), phone: val('phone'), email: val('email'), pickup: val('pickup'), note: val('note'),
        turnstileToken: tokenInput.value, website: val('website'),
        paymentMethod: pmDaGui,
      }
      submitBtn.disabled = true
      const submitText = form.dataset.submitText || submitBtn.textContent || ''
      submitBtn.textContent = form.dataset.sendingText || '…'
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) })
        const data = await res.json().catch(() => null) as null | { ok?: boolean; code?: string; duplicate?: boolean; message?: string; fields?: Record<string, string>; summary?: { tourTitle: string; departDate: string; total: number } }
        if (res.ok && data?.ok && data.code) {
          showDone(data.code, !!data.duplicate, tongDaGui, pmDaGui)
        } else if (res.status === 400 && data?.fields) {
          for (const [k, m] of Object.entries(data.fields)) showErr(k, m)
          showErr('form', data.message || form.dataset.errorText || '')
          if (data.fields.departDate || data.fields.pax || data.fields.quoted) { step2.hidden = true; openBtn.hidden = false }
        } else {
          showErr('form', data?.message || form.dataset.errorText || '')
        }
      } catch {
        showErr('form', form.dataset.errorText || '')
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = submitText
        if (window.turnstile && widgetId) { window.turnstile.reset(widgetId); tokenInput.value = '' }
      }
    })

    function showDone(code: string, duplicate: boolean, total: number, paymentMethod: PaymentMethod) {
      step1.hidden = true
      step2.hidden = true
      q<HTMLElement>('[data-done-code]')!.textContent = code
      q<HTMLElement>('[data-done-dup]')!.hidden = !duplicate
      const summary = q<HTMLElement>('[data-done-summary]')!
      summary.replaceChildren()
      qrBox.hidden = true

      // ĐƠN TRÙNG — DANH SÁCH ĐÓNG (SPEC §4.5). Hiện đúng hai thứ: mã đơn và câu "đã ghi nhận
      // trước đó". KHÔNG tóm tắt, KHÔNG dòng tiền, KHÔNG QR.
      // Lý do là tiền thật, không phải gọn gàng: khi trùng, handler.ts:211–213 trả mã đơn CŨ
      // nhưng mọi con số quanh đây dựng từ `quote` của lần nộp MỚI. In số tiền mới cạnh mã cũ
      // đã là hiển thị lệch; đưa nó lên mã QR thì thành khách CHUYỂN SAI SỐ TIỀN.
      // (Liên kết "xem chi tiết và số tiền đã lưu" bổ sung khi trang /dat-tour/{mã}/ ở SPEC
      // §4.4 lên — trang đó đọc D1 nên in đúng. Đợt này chưa có, SPEC §11.1.)
      if (!duplicate) {
        // dateEl.labels không dùng được ổn định trong kiểu lib.dom qua astro check — lấy
        // trực tiếp nhãn <label for="bf-date"> theo id, giữ đúng ngữ nghĩa mà không đụng kiểu.
        // `directText` (Task 4): nhãn này giờ lồng `.bf__tip`, textContent trần dính cả chữ ghi chú.
        const dateLabel = directText(form.querySelector('label[for="bf-date"]')) || form.dataset.dateLabel || ''
        const lines: [string, string][] = [[form.querySelector<HTMLInputElement>('[name="tourTitle"]')!.value, ''], [dateLabel, dateEl.value.split('-').reverse().join('/')]]
        if (quote) for (const l of quote.lines) lines.push([`${rows.get(l.code)?.label ?? l.code} × ${l.count}`, formatPrice(l.subtotal, 'vi')])
        lines.push([directText(totalEl.closest('.bf__total')?.querySelector('.bf__total-label')) || form.dataset.subtotalLabel || '', formatPrice(total, 'vi')])
        for (const [a, b] of lines) {
          const div = document.createElement('div'); div.className = 'bf__line'
          const s1 = document.createElement('span'); s1.textContent = a
          const s2 = document.createElement('strong'); s2.textContent = b
          div.append(s1, s2); summary.append(div)
        }
        hienQr(code, total, paymentMethod)
      }

      done.hidden = false
      done.focus()
    }

    /** Dựng khối QR. `buildPaymentQr` tự trả null khi không phải chuyển khoản. */
    function hienQr(code: string, total: number, paymentMethod: PaymentMethod) {
      const qr = buildPaymentQr(banking, code, total, paymentMethod)
      if (!qr) return
      const img = q<HTMLImageElement>('[data-qr-img]')!
      img.src = qr.imageUrl
      img.alt = (form.dataset.qrAltText || '').replace('{code}', code)
      q<HTMLElement>('[data-qr-amount]')!.textContent = formatPrice(qr.amount, 'vi')
      q<HTMLElement>('[data-qr-content]')!.textContent = qr.addInfo
      dlBtn.onclick = () => { void taiAnh(qr.imageUrl, code + '.png') }
      copyNoiDungBtn.onclick = () => { void chep(copyNoiDungBtn, qr.addInfo) }
      qrBox.hidden = false
    }

    /**
     * Tải ảnh QR về máy. PHẢI đi qua blob: thuộc tính `download` bị trình duyệt BỎ QUA với URL
     * khác gốc, nên `<a href="https://img.vietqr.io/…" download>` chỉ mở ảnh chứ không tải.
     * Fetch được là vì đã đo img.vietqr.io trả `access-control-allow-origin: *` (31/08) —
     * không phải giả định. Mất CORS thì rơi xuống nhánh catch, không cụt.
     */
    async function taiAnh(url: string, ten: string) {
      try {
        const res = await fetch(url)
        if (!res.ok) throw new Error(String(res.status))
        const blobUrl = URL.createObjectURL(await res.blob())
        const a = document.createElement('a')
        a.href = blobUrl
        a.download = ten
        document.body.append(a)
        a.click()
        a.remove()
        setTimeout(() => URL.revokeObjectURL(blobUrl), 10_000)
      } catch {
        // Mất mạng, hoặc VietQR bỏ CORS: mở ảnh ở tab mới để khách nhấn giữ lưu tay.
        window.open(url, '_blank', 'noopener')
      }
    }

    /** Chép một trường. Hỏng thì im — chữ trong khối vẫn chọn-copy được bằng tay. */
    async function chep(btn: HTMLButtonElement, text: string) {
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
      } catch {
        return
      }
      const cu = btn.textContent
      btn.textContent = form.dataset.qrCopiedText || cu
      btn.classList.add('is-copied')
      setTimeout(() => { btn.textContent = cu; btn.classList.remove('is-copied') }, 1600)
    }
  }
</script>

<style>
  /* Nen xam cho form dat tour, dung cong thuc .inc-ex-card (TourDetail.astro:259-264) —
     giong module "Bao gom / Chua bao gom". Vong sua 1/5 (chu du an, sau khi do +75px o
     --s5): .inc-ex-card song trong vung noi dung chinh ~800px, con .bf song trong cot
     phai 340px (DetailLayout.astro:314) — dem 24px moi ben hop o the rong 800px nhung
     KHONG tu dong hop o cot 306px long, ep nhan nut ".bf__pay-opt" (Task 6) xuong 3 dong.
     Cai lam mat nhan ra "giong module Bao gom/Chua bao gom" la nen + vien + bo goc,
     khong phai con so dem — nen giu ca ba, chi ha dem ve --s4 (16px, dung nhu brief cu,
     nhung KHONG bo vien/bo goc nhu brief cu). .bf nam long trong .sidebar-card (da co
     nen trang --c-card, vien, dem --s4 rieng — xem Sidebar.astro) nen day la the trong
     the co chu dinh, khong sua Sidebar.astro vi no dung chung cho 12 loai trang chi tiet. */
  .bf { display: flex; flex-direction: column; gap: var(--s4); background: var(--c-surface-alt); border: 1px solid var(--c-border); border-radius: var(--radius-md); padding: var(--s4); }
  .bf__step { display: flex; flex-direction: column; gap: var(--s3); }
  .bf__label { font-family: var(--font-ui); font-size: var(--fs-label); font-weight: var(--fw-600); color: var(--c-text); margin: 0; }
  /* `<details>` là phần tử KHỐI. Để dấu ⓘ nằm cùng dòng với nhãn mà không đẩy
     chiều cao hàng, cả `<details>` lẫn `<summary>` phải khai inline-* rõ ràng
     (Task 4 — thu ba khối ghi chú của form thành dấu ⓘ mở được). */
  .bf__tip { display: inline; }
  .bf__tip-mark {
    /* MỘT khai báo duy nhất — đừng tách `position` ra rule thứ hai, ::before
       cần khối chứa được lập ngay tại đây */
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.25rem; height: 1.25rem; margin-inline-start: var(--s1);
    border: 1px solid var(--c-border); border-radius: var(--radius-pill);
    font-size: var(--fs-sm); font-weight: var(--fw-600);
    color: var(--c-text-muted); cursor: pointer; vertical-align: middle;
    list-style: none;
  }
  .bf__tip-mark::-webkit-details-marker { display: none; }
  .bf__tip-mark::before {
    /* vùng chạm 44px KHÔNG ăn vào chiều cao dòng — nếu không, −150px của
       ghi chú tuổi bị chính nút ⓘ ăn lại */
    content: ''; position: absolute; width: 2.75rem; height: 2.75rem;
    left: 50%; top: 50%; transform: translate(-50%, -50%);
  }
  .bf__tip-mark:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 2px; }
  /* KHÔNG khai `display` ở đây — phòng ngừa, không phải sửa lỗi đã đo được trên Chrome.
     Astro gắn thuộc tính scoped vào rule này (thành `.bf__tip-body[data-astro-cid-…]`,
     đặc hiệu 0,2,0). Ở engine nào còn ẩn nội dung đóng của `<details>` bằng luật UA
     `details:not([open]) > *:not(summary) { display: none }` (0,1,2) — cùng dạng lỗi
     DR-102, khác rule cho thuộc tính hidden — thì một khai báo `display: block` ở đây SẼ thắng và
     ghim ghi chú hiện thường trực. `<p>` vốn đã block theo mặc định UA nên bỏ khai báo là
     đủ, không mất gì. ĐO THẬT trên Chrome (31/08, dev server, xem task-4-report.md §6c):
     Chrome bản đang chạy máy này ẩn nội dung đóng qua giả phần tử `::details-content` với
     content-visibility, KHÔNG qua `display:none` — nên có khai `display: block` hay không
     đều KHÔNG đổi số đo `offsetHeight`/`formH` ở đây (đã thử cả hai, số giống hệt nhau);
     một `<details>` trần không style cũng cho `offsetHeight` khác 0 dù đóng. Giữ luật này
     lại vì lý do phòng ngừa cho engine khác (kể cả Chrome tương lai), không phải vì đã bắt
     được lỗi hiện hình ở đây — `checkVisibility()` mới là bằng chứng đóng đúng trên Chrome. */
  .bf__tip-body {
    margin: var(--s2) 0 0;
    font-size: var(--fs-sm); color: var(--c-text-muted);
  }
  /* Khuôn "chỉ trình đọc màn hình" chuẩn — vòng sửa 1/5, xem task-4-report.md §1. KHÔNG
     dùng `display:none` hay `visibility:hidden`: cả hai ẩn luôn với trình đọc màn hình,
     mất tác dụng của node này. `position:absolute` đưa nó ra khỏi luồng — không cộng
     thêm khoảng cách `gap` nào của `.bf__step` (flex container cha), nên không đẩy cao
     form. */
  .bf__sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .bf__input { width: 100%; font: inherit; font-size: var(--fs-base); padding: var(--s3) var(--s4); border: 1px solid var(--c-border); border-radius: var(--radius-md); background: var(--c-card); color: var(--c-text); }
  .bf__input:focus { outline: 2px solid var(--c-primary); outline-offset: 1px; }
  .bf__input[aria-invalid="true"] { border-color: var(--c-accent); }
  /* iOS Safari đo `input[type=date]` như control gốc: phần shadow (ô ngày + nút picker) đặt một
     sàn bề rộng nội tại, và `min-width: auto` mặc định không cho hộp co xuống dưới sàn đó —
     `width: 100%` thua. Với --fs-base 19px cộng đệm var(--s3) var(--s4), sàn ấy vượt lòng
     .sidebar-card trên iPhone: hộp ngày thò ra ngoài thẻ trắng trong khi ba ô nhập bước 2 vẫn
     vừa khung (chủ dự án báo 2026-08-30, Safari iOS). Blink KHÔNG áp sàn này — đo ở Chrome
     320/360/390/414px đều vừa đúng khung, nên đừng nghiệm thu bản vá này bằng Chrome.
     `min-width: 0` gỡ sàn, `appearance: none` bỏ luôn lối tự đo của control gốc.
     Dòng thứ hai là phần bắt buộc đi kèm, không phải trang trí: appearance:none làm iOS canh
     GIỮA phần giá trị, trả về canh trái để ô ngày còn cùng bộ với ô Họ tên, Số điện thoại.
     Giữ class trong bộ chọn (không viết `input[type=date]` trần) để Astro còn gắn được thuộc tính
     scoped — cùng lý do đã ghi ở luật `[hidden]` cuối khối này. */
  .bf__input[type="date"] { min-width: 0; appearance: none; -webkit-appearance: none; }
  .bf__input[type="date"]::-webkit-date-and-time-value { text-align: left; }
  /* Lop phu tieng Viet. Chu GOC cua o ngay bi lam trong suot chu khong bi an: an bang
     visibility/display lam o tut chieu cao va mat luon nut mo lich. iOS Safari bo qua `color`
     tren dieu khien goc nen phai them `-webkit-text-fill-color`. Nut mo lich la anh nen,
     khong an theo mau chu, nen van bam duoc. */
  .bf__date-wrap { position: relative; }
  /* `pointer-events: none`: moi cu bam roi xuong `.bf__date-trigger` phu ben tren, nen lich
     GOC cua trinh duyet khong con mo duoc bang chuot. O ngay VAN tab toi va go tay duoc —
     co y giu, de ban phim khong mat duong nhap nhanh. Nut mo lich goc an han: de lai thi no
     thanh mot diem chet, bam khong ra gi. */
  .bf__input--date { color: transparent; -webkit-text-fill-color: transparent; pointer-events: none; }
  .bf__input--date::-webkit-calendar-picker-indicator { display: none; }
  /* Nut mo lich: trong suot, phu kin mat o. Vien focus ve tren chinh no de ban phim con thay
     dang dung o dau. */
  .bf__date-trigger {
    position: absolute; inset: 0;
    width: 100%; padding: 0 var(--s4) 0 0;
    display: flex; align-items: center; justify-content: flex-end;
    background: none; border: 0; border-radius: var(--radius-md);
    color: var(--c-text-muted); cursor: pointer;
  }
  .bf__date-trigger:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 1px; }
  /* Bieu tuong khong nhan chuot: moi cu bam deu rot ve chinh cai nut. Doi day la lop thu hai
     — bo doi su kien o tren da xu ly dung roi — nhung giu cho `e.target` chi co MOT gia tri,
     de bay "target la <svg> chu khong phai nut" khong quay lai duoi dang khac. */
