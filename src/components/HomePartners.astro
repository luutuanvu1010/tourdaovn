---
// Logo đối tác — 06-BINDING_MAP §5.7. Nguồn duy nhất: siteSettings.partners.
//
// Đối tác nào không có `url` thì logo render thành ảnh tĩnh, KHÔNG bọc thẻ <a>
// rỗng — link chết còn tệ hơn không có link. Đối tác không có logo thì hiện tên
// bằng chữ, vẫn là bằng chứng, không phải khung xám.
import { imageUrl } from '../lib/sanity-image'
import type { SitePartner } from '../lib/types'

export interface Props {
  partners?: SitePartner[] | null
  heading: string
  sub?: string
}

const { partners, heading, sub } = Astro.props
const items = (partners ?? []).filter(p => p.name || p.logo)
---

{items.length > 0 && (
  <section class="partners-section">
    <div class="container">
      <div class="partners-head">
        <h2>{heading}</h2>
        <span class="partners-underline" aria-hidden="true"></span>
        {sub && <p class="partners-sub">{sub}</p>}
      </div>

      <ul class="partners-grid">
        {items.map(p => {
          const src = p.logo ? imageUrl(p.logo, { width: 320 }) : null
          const inner = src
            ? <img src={src} alt={p.logo?.alt || p.name || ''} loading="lazy" decoding="async" />
            : <span class="partner-name">{p.name}</span>
          return (
            <li class="partner-cell">
              {p.url
                ? <a href={p.url} target="_blank" rel="noopener nofollow">{inner}</a>
                : inner}
            </li>
          )
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .partners-section {
    background: var(--c-surface);
    padding: var(--s9) 0;
  }

  .partners-head {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    margin-bottom: var(--s6);
  }

  .partners-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-800);
    color: var(--c-primary);
    line-height: var(--lh-heading);
    text-wrap: balance;
  }

  .partners-underline {
    display: block;
    width: var(--underline-width);
    height: var(--underline-height);
    background: var(--c-sand);
    border-radius: 2px;
  }

  .partners-sub {
    font-size: var(--fs-base);
    color: var(--c-text-muted);
    max-width: 56ch;
  }

  .partners-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s4);
  }

  .partner-cell {
    height: var(--s9);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s4);
  }

  .partner-cell > a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .partner-cell img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .partner-name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text-muted);
    text-align: center;
  }

  @media (max-width: 1023px) {
    .partners-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 640px) {
    .partners-section { padding: var(--s6) 0; }
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
