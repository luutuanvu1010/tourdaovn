---
/**
 * Vùng "Thông tin nhanh" (06-BINDING_MAP §3, v2.1) — thay cặp InfoBar + InfoCard.
 *
 * Vì sao gộp: hai vùng cùng ăn một bộ field là gốc của DR-032 và của 44/58 trang
 * lặp vùng đo ngày 2026-08-22. Một field một vùng thì phải có đúng MỘT component.
 *
 * Hợp đồng từ 06: tối đa 6 ô cho bốn entity có hàng ở §3.1; KHÔNG chứa giá
 * (giá chỉ ở thanh dính + khối hành động).
 *
 * QĐ-2026-08-25-02 BỎ luật "≤ 2 ô thì không trải dải" — vùng này nay LUÔN trải
 * dải. Prop `inline` và biến thể `.fact-strip--inline` vì thế mất chỗ gọi cuối
 * cùng và đã gỡ, thay vì để mã chết.
 *
 * Task 7 fix round (2026-08-23, chủ dự án chỉ đạo, gỡ hạn chế "không sửa file
 * này" CHỈ cho hai thay đổi dưới): trần 6 từng cắt LẶNG (`.slice(0, 6)`, không
 * log, không cảnh báo) — với entity không có hàng ở §3.1 (vd khách sạn),
 * không có gì đối chiếu để biết cắt là đúng hay là mất nội dung. Sửa hai chỗ:
 *   1. `max` — trần tuỳ chỉnh, mặc định 6 (đúng hợp đồng cho bốn entity §3.1).
 *      Entity không có hàng ở §3.1 không bị ràng buộc trần đó (chỉ Luật 1: một
 *      field một vùng), nên chỗ gọi có thể truyền `max` cao hơn.
 *   2. Cắt phải ồn: vượt `max` thì `console.warn` lúc build, nêu rõ dư bao
 *      nhiêu và field nào bị cắt — không còn cắt câm.
 */
export interface Fact {
  /** Tên field trong 01-CONTENT_MODEL. Bộ kiểm Luật 1 đếm theo đây. */
  field: string
  icon: string
  label: string
  value: string
  href?: string
  visible: boolean
}

export interface Props {
  facts: Fact[]
  /** true = dựng dạng danh sách dọc để nhét vào sidebar (≤ 2 ô). */
  /** Trần số ô hiển thị. Mặc định 6 — hợp đồng 06 §3.1. Entity không có hàng
   *  ở §3.1 (chỉ ràng buộc bởi Luật 1, không ràng buộc bởi trần 6) có thể
   *  truyền cao hơn để không bị cắt oan. */
  max?: number
}

const { facts, max = 6 } = Astro.props
const allVisible = facts.filter(f => f.visible)
// Quá `max` thì cắt CÓ TIẾNG — cắt câm là đúng thất bại "vùng biến mất, cổng
// vẫn xanh" mà việc đóng Luật 1 tồn tại để loại bỏ.
if (allVisible.length > max) {
  const dropped = allVisible.slice(max).map(f => f.field).join(', ')
  console.warn(`[FactStrip] ${allVisible.length} ô hiển thị vượt trần ${max} — cắt bớt: ${dropped}`)
}
const visible = allVisible.slice(0, max)
const cols = Math.min(visible.length, 3)
---

{visible.length > 0 && (
  <section class="fact-strip">
    <div class="container">
      <dl class="fact-grid" style={`--fact-cols:${cols}`} data-region="fact-strip">
        {visible.map((f) => (
          <div class="fact" data-field={f.field}>
            <dt class="fact-label">
              <span class="fact-icon" aria-hidden="true">{f.icon}</span>
              {f.label}
            </dt>
            <dd class="fact-value">
              {f.href ? (
                <a href={f.href} {...(f.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{f.value}</a>
              ) : f.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .fact-strip { padding: 0 0 var(--s4); }

  /* Lịch sử: I4 fix (2026-08-23) đưa khối gộp ≤2 ô ra khỏi `.sidebar-card` để
     nó thôi ăn ké nền/viền/đệm của thẻ sidebar. QĐ-2026-08-25-02 bỏ hẳn khối
     gộp, nên `.fact-grid` nay chỉ có một hình dạng và giữ nền/viền/đệm riêng. */

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(var(--fact-cols, 3), 1fr);
    gap: var(--s3);
    margin: 0;
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--s4);
  }

  /* 06 §3 hàng "Thông tin nhanh": "di động giữ lưới 2 cột" — cột đơn (danh sách
     dọc kiểu InfoCard cũ) CHỈ áp cho desktop, nơi khối gộp nằm trong sidebar
     340px hẹp. Trước đây rule này không có media query nên đè cả di động
     (đặc hiệu hơn rule 2-cột bên dưới bất kể thứ tự khai) — I4, review toàn
     nhánh: hồi quy vị trí+bố cục trên 15 trang ≤2 ô. */

  .fact { min-width: 0; }

  .fact-label {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: var(--fw-500);
    color: var(--c-text-muted);
  }

  .fact-icon { font-size: 1.25rem; line-height: 1; flex: none; }

  .fact-value {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-700);
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  /* Giữa 641px và 1023px: hạ xuống 2 cột như InfoBar cũ. */
  @media (max-width: 1023px) {
    .fact-grid { grid-template-columns: repeat(min(var(--fact-cols, 3), 2), 1fr); }
  }

  /* Luật 5 (06 §6, v2.3) — ở ≤ 640px mỗi ô một hàng chiếm hết bề rộng.
     Luật nói: giá trị vừa một dòng thì nhãn trái / giá trị phải; dài hơn một
     dòng thì nhãn trên / giá trị full-width. CSS không đo được độ dài chữ, nên
     `flex-wrap` làm đúng việc đó một cách tự nhiên: còn chỗ thì giá trị nằm
     cùng hàng với nhãn; không còn chỗ thì nó tự xuống dòng và chiếm trọn.
     `flex-basis` là ngưỡng quyết định — dưới ngưỡng thì xuống dòng.

     KHÔNG dùng `text-align: right` cho giá trị: khi nó xuống dòng riêng, chữ
     căn phải làm một địa chỉ 78 ký tự khó đọc hẳn — đúng thứ Luật 5 sinh ra để
     gỡ. "Giá trị bên phải" đạt được bằng `space-between` khi hai thứ cùng hàng.
     Điểm này cần Design chặng 2 xác nhận. */
  @media (max-width: 640px) {
    .fact-grid { grid-template-columns: 1fr; }

    .fact {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--s2);
    }

    .fact-value {
      margin: 0;
      flex: 1 1 14ch;
    }
  }
</style>
