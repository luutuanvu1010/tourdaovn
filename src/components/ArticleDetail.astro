---
import type { ArticleResult, Lang } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy, typeLabel as lookupLabel, ARTICLE_TYPE_LABELS } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import FAQ from './FAQ.astro'
import Section from './Section.astro'
import Body from './Body.astro'
import { articleToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import { formatDate } from '../lib/dates'
import { ROUTE_MAP } from '../lib/routes'

export interface Props {
  data: ArticleResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
}

const { data, lang, nearby = [] } = Astro.props

const t = uiCopy(lang)

function entityHref(entityType: string, slug: string): string {
  const seg = ROUTE_MAP.find(r => r.entity === entityType)?.segments[lang] || entityType
  return `/${seg}/${slug}`
}

const typeLabel = lookupLabel(ARTICLE_TYPE_LABELS, lang, data.articleType)

function hasBlocksContent(blocks: unknown[] | undefined | null): boolean {
  if (!blocks || blocks.length === 0) return false
  return blocks.some((b: any) => b._type === 'block' && b.children?.some((c: any) => (c.text || '').trim()))
}

// Phù hiệu hero: CHỈ chuyên mục bài (§4.10 `articleType`).
//
// QĐ-2026-08-25-02: gỡ phù hiệu "Bởi {tác giả}". `06` §3 khai `author` đúng MỘT
// vùng — "Hộp tác giả" — còn ở đây nó là vùng thứ hai. Cùng với hàng sidebar đã
// gỡ bên dưới, tên tác giả từng hiện BA lần trên mỗi trang cẩm nang: phù hiệu
// hero, hộp tác giả, và hàng InfoCard. Đó là vi phạm Luật 1, và cổng không thấy
// vì hai trong ba chỗ không gắn `data-field` (khoảng mù DR-048).
//
// Lý lẽ cũ ở đây — "tác giả là tín hiệu E-E-A-T, phải đọc được ngay trên màn
// đầu" — vẫn đúng về ý định, nhưng nó không cho phép mở thêm vùng: Luật 1 chỉ
// nhượng bộ cho giá. Muốn tác giả lên màn đầu thì đổi VỊ TRÍ hộp tác giả, không
// phải nhân nó ra ba bản.
const heroBadges = [typeLabel].filter((x): x is string => !!x)

// Neo chỉ trỏ tới mục thật sự render — khối vắng mà vẫn để neo là link chết.
const jumpLinks = [
  { id: 'howto', label: t('howTo'), on: !!data.howTo?.length },
  { id: 'about', label: t('aboutEntity'), on: !!data.about?.length },
  { id: 'mentions', label: t('mentions'), on: !!data.mentions?.length },
  { id: 'faq', label: t('faqHeading'), on: !!data.faq?.length },
].filter(x => x.on).map(x => ({ href: `#${x.id}`, label: x.label }))

// Byline — QĐ-2026-08-29-04. Chuyên mục, tác giả và ngày đăng gộp thành MỘT
// dòng chữ nhỏ ngay dưới tiêu đề: không nền, không viền, không hộp. Chủ dự án
// chốt 2026-08-29 sau khi thấy bản trước đẩy chuyên mục vào ô có viền của
// `FactStrip` còn tác giả vào hộp nền `--c-surface-alt` ở cuối bài — hai dải
// riêng cho ba mẩu thông tin ngắn.
//
// `updatedAt` CỐ Ý không lên byline: `DetailLayout` đã hiện "Cập nhật" ở cuối
// nội dung. Đưa lên đây nữa là hai vùng cho một ý, đúng thứ Luật 1 cấm.
//
// Bài viết vì vậy không còn ô Thông tin nhanh nào. Không sao — `FactStrip` tự
// ẩn khi rỗng (R7), và khung chung vẫn là khung chung; có ô hay không là chuyện
// dữ liệu, không phải chuyện khung.
const bylineAuthorHref = data.author?.slug
  ? `/${ROUTE_MAP.find(r => r.entity === 'person')?.segments[lang] ?? 'tac-gia'}/${data.author.slug}/`
  : null
const bylinePublished = data.publishedAt ? formatDate(data.publishedAt, lang) : null
---

<DetailLayout
  title={data.title}
  lang={lang}
  entityType="article"
  image={data.mainImage}
  gallery={data.gallery}
  badges={heroBadges}
  summary={data.summary}
  speakable
  jumpLinks={jumpLinks}
  sidebarSlots={[
    { name: 'about', component: 'Article', visible: !!(data.about && data.about.length > 0), props: {} },
  ]}
  nearbyTitle={t('relatedArticles')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <Fragment slot="head-meta">
    {typeLabel && <span class="byline-item" data-field="articleType">{typeLabel}</span>}
    {data.author && (
      <span class="byline-item" data-region="byline" data-field="author">
        {bylineAuthorHref
          ? <a href={bylineAuthorHref}>{data.author.title}</a>
          : data.author.title}
        {data.author.jobTitle && <span class="byline-role">{data.author.jobTitle}</span>}
      </span>
    )}
    {bylinePublished && <span class="byline-item" data-field="publishedAt">{bylinePublished}</span>}
  </Fragment>

  <Fragment slot="content">
    {/* Hộp tác giả ĐÃ GỠ — QĐ-2026-08-29-04. Tác giả nay ở byline dưới tiêu đề,
        vẫn đúng MỘT vùng theo Luật 1, chỉ đổi chỗ và bỏ nền. Hộp cũ chỉ chứa
        tên + chức danh, không avatar không tiểu sử, nên gộp lên byline không
        mất nội dung nào. Bù lại nay CÓ link `/tac-gia/{slug}` — thứ 06 §3 hàng
        "Hộp tác giả" đã đòi mà bản cũ chưa làm. */}
    {/* Chuyên mục, tác giả và tóm tắt đã lên hero qua DetailLayout. `data-speakable`
        đi theo tóm tắt lên đó — cssSelector trong JSON-LD vẫn là `[data-speakable]`. */}
    {hasBlocksContent(data.body) && (
      <Section contained={false}>
        <Body blocks={data.body} />
      </Section>
    )}

    {data.howTo && data.howTo.length > 0 && (
      <Section heading={t('howTo')} contained={false} id="howto">
        <div class="howto-steps">
          {data.howTo.map((s) => (
            <div class="howto-step">
              <strong>{s.step}</strong>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </Section>
    )}

    {data.about && data.about.length > 0 && (
      <Section heading={t('aboutEntity')} contained={false} id="about">
        <div class="about-grid">
          {data.about.map((e) => (
            <a href={entityHref(e._type, e.slug)} class="about-card">
              <strong>{e.title}</strong>
              {e.summary && <p>{e.summary}</p>}
            </a>
          ))}
        </div>
      </Section>
    )}

    {data.mentions && data.mentions.length > 0 && (
      <Section heading={t('mentions')} contained={false} id="mentions">
        <div class="about-grid">
          {data.mentions.map((e) => (
            <a href={entityHref(e._type, e.slug)} class="about-card">
              <strong>{e.title}</strong>
              {e.summary && <p>{e.summary}</p>}
            </a>
          ))}
        </div>
      </Section>
    )}

    {data.faq && data.faq.length > 0 && <FAQ faq={data.faq} lang={lang} contained={false} id="faq" />}
  </Fragment>

  {data.about && data.about.length > 0 && (
    <div slot="about" class="about-links">
      <h5>{t('aboutEntity')}</h5>
      {data.about.map((e) => <a href={entityHref(e._type, e.slug)}>{e.title}</a>)}
    </div>
  )}
</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(articleToJsonLd(data, siteBaseUrl(Astro.site)))}></script>

<style>
  /* Byline: các mẩu ngăn nhau bằng dấu chấm giữa, KHÔNG nền không viền. */
  .byline-item + .byline-item::before {
    content: '·';
    margin-right: var(--s3);
    color: var(--c-border);
  }

  .byline-item a {
    color: var(--c-primary);
    font-weight: var(--fw-600);
  }

  .byline-item a:hover { text-decoration: underline; }

  .byline-role::before { content: ', '; }


  .author-info strong { display: block; font-size: var(--fs-base); font-weight: var(--fw-700); color: var(--c-text); }
  .author-info span { font-size: var(--fs-sm); color: var(--c-text-muted); }

  .howto-steps { display: flex; flex-direction: column; gap: var(--s4); }
  .howto-step strong { display: block; font-size: var(--fs-base); font-weight: var(--fw-700); color: var(--c-text); margin-bottom: var(--s1); }
  .howto-step p { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }

  .about-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s3); }
  .about-card { display: block; padding: var(--s4); background: var(--c-card); border: 1px solid var(--c-border); border-radius: var(--radius-md); text-decoration: none; color: inherit; transition: box-shadow var(--m-fast) var(--m-ease); }
  .about-card:hover { box-shadow: var(--shadow-raised); }
  .about-card strong { display: block; font-size: var(--fs-base); font-weight: var(--fw-700); margin-bottom: var(--s1); }
  .about-card p { font-size: var(--fs-sm); color: var(--c-text-muted); margin: 0; }

  .about-links h5 { font-family: var(--font-display); font-size: var(--fs-base); font-weight: var(--fw-700); margin-bottom: var(--s3); color: var(--c-text); }
  .about-links a { display: block; font-size: var(--fs-sm); color: var(--c-primary); text-decoration: none; padding: var(--s2) 0; border-bottom: 1px solid var(--c-border); }
  .about-links a:last-child { border-bottom: none; }
  .about-links a:hover { text-decoration: underline; }

  @media (max-width: 1023px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
