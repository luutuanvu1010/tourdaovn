---
import type { ExperienceResult, Lang, SiteContact } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import FAQ from './FAQ.astro'
import Section from './Section.astro'
import BookingCTA from './BookingCTA.astro'
import ContactChannels from './ContactChannels.astro'
import Body from './Body.astro'
import MapView from './MapView.astro'
import { applyPriceToJsonLd, entityPageGraphToLd, experienceToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import { loadPrices } from '../lib/prices'
import { resolvePrice } from '../lib/resolver'

export interface Props {
  data: ExperienceResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
  contact?: SiteContact | null
}

const { data, lang, nearby = [], contact = null } = Astro.props

const t = uiCopy(lang)

function hasPtContent(blocks: unknown[] | undefined | null): boolean {
  if (!blocks || blocks.length === 0) return false
  return blocks.some((b: any) => b._type === 'block' && b.children?.some((c: any) => (c.text || '').trim()))
}

const prices = loadPrices('data/prices.yaml')
const priceView = resolvePrice(data.bookingRef?.key, 'experience', data.isAccessibleForFree, prices, lang)
const siteBase = siteBaseUrl(Astro.site)
const entityJsonLd = applyPriceToJsonLd(
  experienceToJsonLd(data, siteBase, lang),
  priceView, data.bookingRef?.key,
)
const jsonLd = entityPageGraphToLd(entityJsonLd, data, siteBase, lang)
const hasContactChannel = !!(contact?.zaloUrl || contact?.hotline || contact?.whatsapp)

// Vùng "Thông tin nhanh" — 06 §3.1 Trải nghiệm: đúng 2 ô (`duration`,
// `touristType`). Giá không vào đây (thanh dính + khối hành động); `includes`
// đã có mục "Bao gồm" riêng; `experienceType` đã là huy hiệu hero, chỉ ở đó.
const facts = [
  { field: 'duration', icon: '⏱️', label: t('duration'), value: data.duration || '', visible: !!data.duration },
  { field: 'touristType', icon: '👤', label: t('suitableFor'), value: data.touristType?.join(', ') || '', visible: !!(data.touristType && data.touristType.length > 0) },
]

// Phù hiệu trong hero: loại trải nghiệm (§4.4 `experienceType`), và CHỈ loại —
// 06 §3.1 khai `duration` → Thông tin nhanh MỘT MÌNH ("chỉ ở đó" áp cho nhãn
// loại, không áp cho duration). Trước đây `data.duration` cũng vào đây, nên
// thời lượng hiện cả huy hiệu hero LẪN fact-strip — hai vùng cho một field,
// sống sót qua Luật 1 chỉ vì huy hiệu hero không mang data-region/data-field.
const heroBadges = [data.experienceType?.name].filter((x): x is string => !!x)

// Thanh dính: neo tới đúng những mục THẬT SỰ render. Trước đây ExperienceDetail
// không truyền jumpLinks/priceLabel/ctaHref nào, nên showStickyBar luôn sai và
// trang có giá + có Zalo lại không có thanh đặt chỗ. Đây là lỗi thật, không phải
// khác biệt cố ý so với trang tour.
const jumpLinks = [
  { id: 'highlights', label: t('highlights'), on: !!data.highlights?.length },
  { id: 'details', label: t('details'), on: hasPtContent(data.body) },
  { id: 'includes', label: t('includes'), on: !!data.includes?.length },
  { id: 'faq', label: t('faqHeading'), on: !!data.faq?.length },
].filter(x => x.on).map(x => ({ href: `#${x.id}`, label: x.label }))

// Nhãn giá dùng chung một quy tắc với InfoBar: miễn phí thì hiện nhãn thay số.
const stickyPriceLabel = data.isAccessibleForFree ? t('free') : (priceView?.label ?? null)

// CTA trên thanh dính là Zalo — kênh đặt chỗ duy nhất của site (00 §3).
const zaloHref = contact?.zaloUrl || ''
---

<DetailLayout
  title={data.title}
  lang={lang}
  entityType="experience"
  image={data.mainImage}
  gallery={data.gallery}
  containedInPlace={data.venue}
  badges={heroBadges}
  summary={data.summary}
  jumpLinks={jumpLinks}
  priceLabel={stickyPriceLabel}
  ctaHref={zaloHref || null}
  ctaLabel={zaloHref ? t('contactZalo') : null}
  facts={facts}
  sidebarSlots={[
    { name: 'booking', component: 'BookingCTA', visible: !!priceView?.label || hasContactChannel, props: {} },
    { name: 'map', component: 'Map', visible: !!(data.geo), props: {} },
  ]}
  nearbyTitle={t('similarExperiences')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <div slot="content">
    {/* `summary` đã lên hero qua DetailLayout — không lặp lại ở thân bài. */}
    {data.highlights && data.highlights.length > 0 && (
      <Section heading={t('highlights')} contained={false} id="highlights">
        <ul class="hl-list">
          {data.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </Section>
    )}

    {hasPtContent(data.body) && (
      <Section heading={t('details')} contained={false} id="details">
        <Body blocks={data.body} headingOffset={1} />
      </Section>
    )}

    {data.includes && data.includes.length > 0 && (
      <Section heading={t('includes')} contained={false} id="includes">
        <ul class="check-list">
          {data.includes.map((item) => <li><span class="check-icon">&#10003;</span> {item}</li>)}
        </ul>
      </Section>
    )}

    {data.faq && data.faq.length > 0 && <FAQ faq={data.faq} lang={lang} contained={false} id="faq" />}
  </div>

  {priceView?.label && <BookingCTA slot="booking" priceText={priceView.label} ctaLabel={t('bookNow')} />}
  {hasContactChannel && <ContactChannels slot="booking" contact={contact} lang={lang} />}
  {data.geo && <MapView slot="map" geo={data.geo} title={data.title} height={240} />}
</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)}></script>

<style>
  /* Trải nghiệm chỉ có `includes`, không có `excludes` — nên đây là danh sách
     hai cột, không phải hai thẻ đối nhau như trang tour (một thẻ sẽ trống). */
  .check-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s3) var(--s5);
  }

  .check-list li {
    display: flex;
    gap: var(--s3);
    align-items: center;
    font-size: var(--fs-base);
    color: var(--c-text);
  }

  .check-icon {
    color: var(--c-green);
    font-weight: var(--fw-700);
  }

  .hl-list { list-style: none; display: flex; flex-direction: column; gap: var(--s2); }
  .hl-list li { font-size: var(--fs-base); color: var(--c-text-muted); padding-left: var(--s5); position: relative; }
  .hl-list li::before { content: "✦"; position: absolute; left: 0; color: var(--c-primary); font-size: var(--fs-xs); }
</style>
