---
// Khối "Tour nổi bật" trên trang chủ — SPEC-2026-08-14-be-mat-vong-3 §3.4.
//
// Vì sao khối này tồn tại: trang chủ trước đây có chín khối và KHÔNG khối nào bán
// tour. Khách vào trang chủ của một công ty bán tour biển đảo phải bấm menu mới
// thấy sản phẩm. Đó là hệ quả có chủ ý của ADR-0024, quyết khi kho chỉ có 1 tour;
// nay đã 7 nên tiền đề ấy hết hiệu lực (xem ADR-0026).
//
// Nền sáng (--c-surface-alt), KHÔNG còn là dải màu đậm — QĐ-2026-08-29. Ba khối đầu
// trang chủ (hero, khối này, stats-band) từng cùng --c-primary nên đọc thành một dải
// xanh liền ~2.000px ở khổ điện thoại. Vai "dải đậm đầu tiên" nay chuyển hẳn cho
// stats-band; khối này lùi về nền xen kẽ để nhịp trang thành đậm/sáng/đậm/sáng.
import { imageUrl } from '../lib/sanity-image'
import { HOME_COPY } from '../lib/homepage'
import type { Lang } from '../lib/types'

export interface Props {
  tours: any[]
  lang: Lang
  /** Đường dẫn trang danh sách tour, ví dụ `/tour/`. */
  indexHref: string
  /** Tổng số tour đang có — dùng cho nhãn "Xem tất cả N tour". */
  total: number
}

const { tours, lang, indexHref, total } = Astro.props

const COPY = {
  eyebrow: 'TOUR BIỂN ĐẢO',
  sub: 'Khởi hành hằng ngày từ Nha Trang, có xe đón tận khách sạn nội thành.',
  all: (n: number) => `Xem tất cả ${n} tour`,
}
---

{tours.length > 0 && (
  <section class="home-tours">
    <div class="container">
      <p class="tours-eyebrow">{COPY.eyebrow}</p>
      <h2 class="tours-heading">{HOME_COPY[lang].sections.tours}</h2>
      <p class="tours-sub">{COPY.sub}</p>

      <ul class="tours-grid">
        {tours.map(tour => (
          <li class="tour-card">
            <a href={`/tour/${tour.slug}/`}>
              {imageUrl(tour.mainImage, { width: 480 }) ? (
                <img
                  class="tour-thumb"
                  src={imageUrl(tour.mainImage, { width: 480 })}
                  alt={tour.mainImage?.alt ?? ''}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="280"
                />
              ) : (
                <div class="tour-thumb tour-thumb-empty" aria-hidden="true"></div>
              )}
              <div class="tour-body">
                <h3 class="tour-title">{tour.title}</h3>
                {tour.duration && <p class="tour-meta">{tour.duration}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>

      <a class="tours-all" href={indexHref}>{COPY.all(total)}</a>
    </div>
  </section>
)}

<style>
  .home-tours {
    background: var(--c-surface-alt);
    padding: var(--s7) 0;
  }

  .tours-eyebrow {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-800);
    letter-spacing: 0.12em;
    color: var(--c-primary);
    margin: 0;
  }

  .tours-heading {
    font-family: var(--font-display);
    font-size: var(--fs-section);
    font-weight: var(--fw-800);
    letter-spacing: -0.015em;
    line-height: var(--lh-heading);
    color: var(--c-primary);
    margin: var(--s1) 0 var(--s1);
  }

  .tours-sub {
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--c-text-muted);
    margin: 0 0 var(--s4);
    max-width: 56ch;
  }

  .tours-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Biên tập chọn 1–2 tour là hợp lệ sau R6a. Không có hai luật này thì một thẻ
     nằm trong cột 1/3 bề ngang, hai phần ba trống — đúng thứ EntityIndex.astro:258
     gọi là "một thẻ dọc nằm lẻ loi bên trái, trông như trang lỗi".
     Khuôn chép từ HomeRollupSection.astro:76/:92/:96 — KỂ CẢ phần nhắc lại
     trong khối @media ≤600px bên dưới. Phần nhắc lại đó bắt buộc, không phải
     trang trí: :has() mang độ đặc hiệu (0,3,0), còn `.tours-grid` trần trong
     media query chỉ (0,1,0) — media query không cộng đặc hiệu, nên thiếu phần
     nhắc lại thì luật ≤600px thua, lưới giữ 2 cột bóp trên điện thoại (R-06). */
  .tours-grid:has(> :last-child:nth-child(1)) {
    grid-template-columns: 1fr;
  }

  .tours-grid:has(> :last-child:nth-child(2)) {
    grid-template-columns: repeat(2, 1fr);
  }

  .tour-card {
    background: var(--c-card);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .tour-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .tour-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 12 / 7;
    object-fit: cover;
  }

  .tour-thumb-empty {
    background: linear-gradient(135deg, var(--c-hero-fallback-top-teal), var(--c-hero-fallback-bottom-teal));
  }

  .tour-body { padding: var(--s3); }

  .tour-title {
    font-family: var(--font-display);
    font-size: var(--fs-card-title);
    font-weight: var(--fw-700);
    letter-spacing: -0.01em;
    line-height: 1.24;
    color: var(--c-text);
    margin: 0;
  }

  .tour-meta {
    font-size: var(--fs-label);
    color: var(--c-text-muted);
    margin: var(--s1) 0 0;
  }

  /* Nút dùng --c-accent (san hô), KHÔNG dùng --c-sand — QĐ-2026-08-29. Nền khối đã
     chuyển sang sáng nên lý do gạch chìm hết hiệu lực; lý do đúng là phân vai màu:
     07-DESIGN_TOKENS §1 giao --c-accent cho CTA và nhãn giá, cát cho gạch chân/nút
     trên nền đậm — cho cát thêm vai CTA là một màu hai vai. */
  .tours-all {
    display: inline-block;
    margin-top: var(--s4);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-family: var(--font-display);
    font-weight: var(--fw-700);
    font-size: var(--fs-base);
    padding: var(--s2) var(--s4);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .tours-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    /* Nhắc lại nguyên bộ chọn :has() — để `.tours-grid` trần là thua đặc hiệu.
       Cùng khuôn HomeRollupSection dùng ở khối ≤640 của nó. */
    .tours-grid,
    .tours-grid:has(> :last-child:nth-child(1)),
    .tours-grid:has(> :last-child:nth-child(2)) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .home-tours {
      padding: var(--s6) 0;
    }
  }
</style>
