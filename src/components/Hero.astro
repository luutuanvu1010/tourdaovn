---
import { imageUrl } from '../lib/sanity-image'
import type { ImageAsset } from '../lib/types'

export interface Props {
  image?: string | ImageAsset
  gallery?: ImageAsset[] | null
  imageAlt?: string
  /**
   * Hero tràn hết chiều ngang thay vì nằm trong container.
   * Container policy (06-BINDING_MAP §3) cho Hero là ngoại lệ full-width có chủ
   * ý; phần chữ bên trong vẫn tự bọc container nên không có element trần.
   */
  fullBleed?: boolean
  /**
   * Slot `overlay` có nội dung hay không.
   * Lớp phủ tối `.hero-gradient-overlay` sinh ra CHỈ để chữ đè trên ảnh đọc
   * được. Từ 06 v2.5, breadcrumb / h1 / đoạn mở đều đã ra ngoài hero, nên trang
   * không có huy hiệu loại thì lớp phủ đó làm tối 55% dưới của một tấm ảnh
   * chẳng còn gì trên nó — khung trang trí rỗng, đúng thứ R7 cấm. Cờ này tắt cả
   * lớp phủ lẫn `.hero-overlay` cho những trang đó.
   */
  hasOverlay?: boolean
}

// Không dùng default `= []` ở đây: nó chỉ kích hoạt với `undefined`, mà caller
// đưa `null` (GROQ). Chặn bằng `?? []` ở điểm dùng bên dưới.
const { image, gallery, imageAlt, fullBleed = false, hasOverlay = true } = Astro.props
const src = typeof image === 'string' ? image : imageUrl(image, { width: 1200 })
const alt = imageAlt || (typeof image === 'object' ? image?.alt : undefined) || ''
const mainImageKey = typeof image === 'object' ? (image?.asset?._id || image?.asset?.url) : src
const galleryItems = (gallery ?? [])
  .filter(item => {
    const itemKey = item?.asset?._id || item?.asset?.url
    return Boolean(itemKey && itemKey !== mainImageKey)
  })
  .map(item => ({
    src: imageUrl(item, { width: 640 }),
    alt: item.alt || '',
  }))
  .filter(item => item.src)
  .slice(0, 4)
const hasMedia = !!src
const hasGallery = galleryItems.length === 4
---

<section class:list={["hero-shell", { "hero-shell--full": fullBleed }]}>
  {hasMedia ? (
    <div class={hasGallery ? 'hero-block hero-block--mosaic' : 'hero-block'}>
      <div class="hero-media-grid">
        <div class="hero-main">
          <figure class="hero-main-figure">
            <img src={src} alt={alt} loading="eager" fetchpriority="high" />
          </figure>
          {hasOverlay && (
            <>
              <div class="hero-gradient-overlay" aria-hidden="true"></div>
              <div class="hero-overlay"><div class:list={[{ container: fullBleed }]}>
                <slot name="overlay" />
              </div></div>
            </>
          )}
        </div>
        {hasGallery && (
          <div class="hero-gallery-grid">
            {galleryItems.map((item) => (
              <figure class="hero-gallery-item">
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="hero-gradient">
      <div class="hero-landscape" aria-hidden="true"></div>
      <div class="container hero-gradient-inner">
        <slot name="overlay" />
      </div>
    </div>
  )}
</section>

<style>
  .hero-shell {
    /* no margin — InfoBar sits tight against hero bottom */

    /* MỘT nguồn cho chiều cao hero, và MỘT giá trị cho mọi loại trang.
       QĐ-2026-08-28-03: bỏ biến thể `--tall`. QĐ-2026-08-28-02 dựng nó ra để
       riêng trang điểm đến cao 430px còn trang chi tiết giữ 380px; chủ dự án
       quyết mọi trang chi tiết entity dùng CÙNG MỘT định dạng hero, nên hai
       giá trị gộp làm một. Một biến thể mà mọi nơi gọi đều bật thì không còn
       là biến thể.
       Trước QĐ-2026-08-28-02 con số này được chép ở sáu chỗ — `.hero-main`,
       `.hero-block--mosaic .hero-media-grid`, và một cặp nữa cho mỗi điểm ngắt.
       Gom về biến thì không nhánh nào lệch được nhánh nào.
       Lưu ý số học: nâng riêng TRẦN 380→430 KHÔNG cho +50px ở mọi khổ, vì
       `30vw` mới là số đang trói — đã đo, chỉ +4px ở 1280 và +30px ở 1366. Phải
       cộng vào chính SỐ GIỮA, và nâng cả sàn lẫn trần theo.
       ⚠ Luật 3: ở 1366 con số này đẩy thanh dính xuống 668, vượt mốc màn đầu
       657px. Ngoại lệ có ghi phiếu, kèm điều kiện phải xét lại TRƯỚC khi
       `sticky-bar__price` render trên bất kỳ trang nào — xem QĐ-2026-08-28-03. */
    --hero-h: clamp(330px, calc(30vw + 50px), 430px);
  }

  .hero-block {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-primary-soft);
  }

  .hero-media-grid {
    display: grid;
  }

  .hero-block--mosaic .hero-media-grid {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    gap: var(--s1);
    /* 06 v2.5 (QĐ-2026-08-25-01): rút từ clamp(320px, 34vw, 430px).
       Breadcrumb và h1 nay đứng TRÊN hero, cộng thêm ~151px trước thanh dính.
       ĐÃ ĐO (Chrome headless, CDP, 2026-08-25), viewport 1366x657: thanh dính ở
       618-675px khi h1 một dòng, 674-731px khi h1 hai dòng — trường hợp hai dòng
       nằm HẲN ngoài màn đầu. 14/28 trang tour có tiêu đề >45 ký tự nên đây là
       nửa số trang, không phải ca hiếm. Chưa thành vi phạm Luật 3 vì
       sticky-bar__price render trên 0 trang; xem 06 §3 hàng Hero.
       380 là chiều cao hero desktop trong mockup Design chặng 2.
       QĐ-2026-08-28-02: con số chuyển vào `--hero-h` trên `.hero-shell`. */
    height: var(--hero-h);
    background: var(--c-card);
  }

  /* ── Main image ── */
  .hero-main {
    position: relative;
    /* 06 v2.5: 400px → CÙNG clamp với biến thể mosaic ở trên. Đây là biến thể
       ảnh đơn (không đủ 4 ảnh gallery). Bản sửa đầu đặt phẳng 380px kèm chú
       thích "phải cùng chiều cao với mosaic" — câu đó tự sai: mosaic là clamp,
       nên trong khoảng 1024–1266px mosaic thấp hơn (330px ở 1100px) và hai loại
       trang có thanh giá ở hai độ sâu khác nhau, đúng thứ chú thích bảo là
       không thể xảy ra. Dùng chung một biểu thức thì nó đúng thật.
       QĐ-2026-08-28-02: "dùng chung một biểu thức" nay là dùng chung một BIẾN,
       nên hai biến thể không thể lệch nhau nữa dù ai sửa. */
    height: var(--hero-h);
    overflow: hidden;
  }

  .hero-block--mosaic .hero-main {
    height: 100%;
  }

  .hero-main-figure {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .hero-main-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--c-primary-strong) 0%, transparent 55%);
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--s7) var(--s5) var(--s5);
    z-index: 2;
  }

  .hero-shell--full {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    border-radius: 0;
  }

  .hero-shell--full .hero-main-figure,
  .hero-shell--full .hero-main-figure img {
    border-radius: 0;
  }

  /* ── Booking-style gallery mosaic ── */
  .hero-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--s1);
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
  }

  .hero-gallery-item {
    margin: 0;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--c-primary-soft);
  }

  .hero-gallery-item img {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: cover;
    display: block;
    transition: transform var(--m-base) var(--m-ease);
  }

  .hero-gallery-item:hover img {
    transform: scale(1.05);
  }

  /* ── No-image variant ── */
  .hero-gradient {
    position: relative;
    /* QĐ-2026-08-28-03: dùng CHUNG `--hero-h` với hai biến thể kia.
       Trước đó khối này giữ công thức riêng `clamp(280px, 36vw, 420px)` — hệ số
       36vw và trần 420px đều khác hai biến thể có ảnh, nên ở 1710px nó ra 420
       trong khi mọi hero khác ra 430. Đo được trên production 2026-08-28 tại
       `/dia-danh/deo-vinh-hy/`. Đây là biến thể hero THỨ BA, dễ sót vì nó không
       có `.hero-main` nên mọi phép đo neo vào `.hero-main` đều bỏ qua nó. */
    min-height: var(--hero-h);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(720px 300px at 92% 0%, color-mix(in srgb, var(--c-green) 20%, transparent), transparent 62%),
      radial-gradient(620px 260px at 10% 8%, color-mix(in srgb, var(--c-sand) 18%, transparent), transparent 62%),
      linear-gradient(135deg, var(--c-primary-strong), var(--c-primary) 52%, color-mix(in srgb, var(--c-primary) 80%, var(--c-green) 20%));
  }

  .hero-landscape {
    position: absolute;
    inset: auto 0 0;
    height: 46%;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--c-green) 18%, transparent), color-mix(in srgb, var(--c-primary-strong) 72%, transparent));
    clip-path: polygon(0 42%, 13% 32%, 28% 40%, 43% 28%, 58% 39%, 75% 29%, 100% 40%, 100% 100%, 0 100%);
    opacity: .72;
  }

  .hero-gradient-inner {
    position: relative;
    z-index: 2;
    padding: var(--s7) var(--s6);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-block--mosaic .hero-media-grid {
      grid-template-columns: 1fr;
      height: auto;
    }

    /* 06 v2.5: 280 → 240px, theo mockup Design chặng 2. Trên 390px, hero 280px
       chiếm 33% màn nên nội dung đầu tiên chưa vào tầm mắt ở lần cuộn thứ nhất.
       QĐ-2026-08-28-03: 240 → 290px cho MỌI trang. Đo ở khung 386px: hero-shell
       328 → 378px, tức 41% → 47% của màn 800px. Con số đó ăn vào chính lý do đã
       cắt 280→240 ở trên; chủ dự án chấp nhận, đổi lấy một định dạng hero duy
       nhất. Ghi lại để lần sau không ai tưởng 290 là số ngẫu nhiên. */
    .hero-shell {
      --hero-h: 290px;
    }

    .hero-main {
      height: var(--hero-h);
    }

    .hero-block--mosaic .hero-main {
      height: var(--hero-h);
    }

    .hero-gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: 1fr;
      height: 84px;
    }

    .hero-overlay {
      padding: var(--s5) var(--s4) var(--s4);
    }

    .hero-gradient-inner {
      padding: var(--s5) var(--s4);
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-shell {
      --hero-h: 390px;
    }

    .hero-block--mosaic .hero-media-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    }

    .hero-block--mosaic .hero-main {
      height: 100%;
    }
  }
</style>
