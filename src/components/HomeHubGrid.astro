---
import WaveDivider from './WaveDivider.astro'
import { HOME_COPY, indexHref, routeForEntity, hubCountLabel } from '../lib/homepage'
import type { Lang } from '../lib/types'
import { navHubs } from '../site.config'

export interface Props {
  lang: Lang
  hubCounts?: Record<string, number>
}

const { lang, hubCounts = {} } = Astro.props
const copy = HOME_COPY[lang]
// Hub nào hiện ở đây do src/site.config.ts quyết định, không khai lại tại chỗ.
const hubEntities = navHubs

const iconBg: Record<string, string> = {
  'hub-kham-pha': 'var(--c-primary-soft)',
  'hub-luu-tru':  'var(--c-green-soft)',
  'hub-di-lai':   'var(--c-sand-soft)',
}

const iconEmoji: Record<string, string> = {
  'hub-kham-pha': '🏛️',
  'hub-luu-tru':  '🛏️',
  'hub-di-lai':   '🚌',
}

const hubs = hubEntities
  .map(entity => {
    const route = routeForEntity(entity)
    const href = indexHref(entity, lang)
    if (!route || !href) return null
    return {
      entity,
      href,
      label: route.labels[lang],
      desc: copy.hubDescriptions[entity] || '',
      iconBg: iconBg[entity],
      emoji: iconEmoji[entity],
      count: hubCounts[entity] ?? undefined,
    }
  })
  .filter(Boolean) as Array<{ entity: string; href: string; label: string; desc: string; iconBg: string; emoji: string; count?: number }>
---

{hubs.length > 0 && (
  <div>
    <div class="hubs-wave-top" aria-hidden="true">
      <WaveDivider fill="var(--c-primary)" opacity={0.08} flip noSecond />
    </div>
    <div class="hubs-section">
      <div class="container">
        {copy.hubsHeading && <h2 class="hubs-title">{copy.hubsHeading}</h2>}
        {copy.hubsSub && <p class="hubs-sub">{copy.hubsSub}</p>}
        <div class="hubs-grid">
          {hubs.map(hub => (
            <a href={hub.href} class="hub-card">
              <div class="hub-icon" style={`background:${hub.iconBg}`} aria-hidden="true">{hub.emoji}</div>
              <div>
                <h3 class="hub-name">{hub.label}</h3>
                <p class="hub-desc">{hub.desc}</p>
              </div>
              <div class="hub-footer">
                {hub.count !== undefined && (
                  <span class="hub-count">{hubCountLabel(hub.count, lang)}</span>
                )}
                <span class="hub-arrow" aria-hidden="true">›</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="hubs-wave-bottom" aria-hidden="true">
      <WaveDivider fill="var(--c-surface)" />
    </div>
  </div>
)}

<style>
  .hubs-wave-top {
    background: var(--c-primary);
    padding-top: 2px;
  }

  .hubs-wave-bottom {
    background: var(--c-primary);
  }

  .hubs-section {
    background: var(--c-primary);
    padding: 72px 0;
  }

  .hubs-title {
    font-family: var(--font-display);
    font-weight: var(--fw-900);
    font-size: clamp(var(--fs-h3), 3vw, var(--fs-h2));
    color: var(--c-text-inverse);
    margin-bottom: var(--s2);
    text-align: center;
  }

  .hubs-sub {
    font-weight: var(--fw-500);
    font-size: var(--fs-sm);
    color: var(--c-text-inverse);
    opacity: 0.6;
    text-align: center;
    margin-bottom: var(--s6);
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s4);
  }

  .hub-card {
    background: var(--c-card);
    border-radius: var(--radius-lg);
    padding: var(--s6) var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    transition: transform var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
    color: inherit;
    text-decoration: none;
  }

  .hub-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .hub-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-h5);
  }

  .hub-name {
    font-family: var(--font-display);
    font-weight: var(--fw-800);
    font-size: var(--fs-h5);
    color: var(--c-text);
    margin-bottom: var(--s1);
  }

  .hub-desc {
    font-weight: var(--fw-500);
    font-size: var(--fs-label);
    color: var(--c-text-muted);
    line-height: 1.55;
  }

  .hub-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hub-count {
    font-family: var(--font-ui);
    font-weight: var(--fw-700);
    font-size: var(--fs-label);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }

  .hub-arrow {
    color: var(--c-text-muted);
    font-size: var(--fs-card-title);
  }

  @media (max-width: 1024px) {
    .hubs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hubs-section {
      padding: var(--s6) 0;
    }

    .hubs-grid {
      grid-template-columns: 1fr;
      gap: var(--s3);
    }

    .hub-card {
      padding: var(--s5) var(--s4);
    }
  }
</style>
