---
// "Vì sao chọn" — 06-BINDING_MAP §5.7, hàng `config (build)`.
//
// Bốn điểm khác biệt của công ty (00-PROJECT_BRIEF). Không phải dữ liệu Sanity:
// đây là định vị, đổi theo chiến lược chứ không theo biên tập, nên nguồn là
// HOME_COPY trong `src/lib/homepage.ts`.
//
// Mockup vòng 2 đổi khối này từ thanh mảnh bốn cột thành một mục có tiêu đề và
// lưới 2×2: bốn điểm khác biệt là lập luận bán hàng, không phải chú thích.
export interface Props {
  items: Array<{ icon: string; title: string; description: string }>
  heading?: string
}

const { items, heading } = Astro.props
---

{items.length > 0 && (
  <section class="why-section">
    <div class="container">
      {heading && (
        <div class="why-head">
          <h2>{heading}</h2>
          <span class="why-underline" aria-hidden="true"></span>
        </div>
      )}
      <div class="why-grid">
        {items.map(item => (
          <div class="why-item">
            <div class="why-icon" aria-hidden="true">{item.icon}</div>
            <div class="why-body">
              <h3 class="why-title">{item.title}</h3>
              <p class="why-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .why-section {
    background: var(--c-surface-alt);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    padding: var(--s9) 0;
  }

  .why-head {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    margin-bottom: var(--s7);
  }

  .why-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-800);
    color: var(--c-primary);
    line-height: var(--lh-heading);
    text-wrap: balance;
  }

  .why-underline {
    display: block;
    width: var(--underline-width);
    height: var(--underline-height);
    background: var(--c-sand);
    border-radius: 2px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s6) var(--s7);
  }

  .why-item {
    display: flex;
    gap: var(--s4);
  }

  .why-icon {
    width: var(--s7);
    height: var(--s7);
    flex: none;
    border-radius: var(--radius-md);
    background: var(--c-primary-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-h4);
  }

  .why-body {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }

  .why-title {
    font-family: var(--font-display);
    font-size: var(--fs-card-title);
    font-weight: var(--fw-700);
    color: var(--c-text);
    line-height: var(--lh-heading);
  }

  .why-desc {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 767px) {
    .why-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .why-section { padding: var(--s6) 0; }
  }
</style>
