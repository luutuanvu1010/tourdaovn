---
import type { Lang } from '../lib/types'
import SiteLogo from './SiteLogo.astro'
import { resolveNav } from '../lib/routes'
import { fetchSiteContact } from '../lib/siteContact'
import { uiCopy } from '../lib/uiCopy'
import { langs } from '../site.config'

export interface Props {
  currentPath?: string;
  lang?: string;
  /**
   * Map ngôn ngữ → URL bản dịch CÓ THẬT cho trang hiện tại. Ngôn ngữ vắng trong map =
   * chưa có bản dịch (track QĐ3) → render disable, KHÔNG link chết (audit G5, prompt R5).
   */
  alternates?: Record<string, string>;
}

const { currentPath = '/', lang = 'vi', alternates } = Astro.props;
const uiLang = (['vi', 'en', 'zh', 'ko', 'ru'].includes(lang) ? lang : 'vi') as Lang
const t = uiCopy(uiLang)
const homeHref = uiLang === 'vi' ? '/' : `/${uiLang}/`

// Menu đọc từ `nav` trong site.config.ts — nguồn duy nhất (ADR-0023, DR-007).
// zaloUrl lấy từ Sanity: chưa điền thì mục "Đặt vé trực tuyến" tự biến mất,
// không render nút chết.
const contact = await fetchSiteContact()
const navItems = resolveNav(uiLang, contact?.zaloUrl, 'header')

type NavHit = { kind: string | null; href: string | null }

/**
 * Mục đang mở? Dùng cho cả mục lẻ lẫn nhóm có con.
 *
 * Trang chủ so khớp CHÍNH XÁC: `startsWith('/')` đúng với mọi đường dẫn, nên dùng nó ở
 * đây sẽ tô sáng "Trang chủ" trên khắp site. Trước đây hàm này chặn cứng `href !== '/'`,
 * viết từ thời chưa mục nào có href là '/', nên thêm mục 'home' vào thì trang chủ không
 * bao giờ được tô sáng.
 */
function isActive(item: NavHit & { children: NavHit[] }): boolean {
  const hit = (i: NavHit) =>
    i.href !== null && (i.kind === 'home' ? currentPath === i.href : currentPath.startsWith(i.href))
  return hit(item) || item.children.some(hit)
}

// Danh sách nút chuyển ngôn ngữ đọc từ `langs` trong site.config.ts (PHA 4, GÓI 2) —
// không khai tay danh sách 5 ngôn ngữ ở đây nữa. Chỉ 1 ngôn ngữ → ẩn hẳn cụm, không xoá
// code, để bật thêm ngôn ngữ vào `langs` là cụm tự hiện lại.
const LANG_LABELS: Record<Lang, string> = { vi: 'VI', en: 'EN', zh: 'ZH', ko: 'KO', ru: 'RU' };
const languages = langs.map(code => ({ code, label: LANG_LABELS[code] }));
---

<header class="site-header">
  <a href="#main-content" class="skip-link">{t('skipNav')}</a>

  <div class="container header-inner">
    <a href={homeHref} class="logo" aria-label={t('homeAria')}>
      <SiteLogo />
    </a>

    <nav class="nav-main" aria-label={t('mainNavAria')}>
      {navItems.map(item => item.children.length > 0 ? (
        <div class="nav-group">
          <button
            type="button"
            class={`nav-link nav-toggle${isActive(item) ? ' active' : ''}`}
            aria-expanded="false"
          >
            {item.label}
            <svg class="nav-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-submenu">
            {item.children.map(child => (
              <a href={child.href} class={child.href && currentPath.startsWith(child.href) ? 'active' : ''}>
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class={`nav-link${isActive(item) ? ' active' : ''}`}
          {...(item.href?.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      {languages.length > 1 && (
        <div class="lang-switch" aria-label={t('chooseLangAria')}>
          {languages.map((l, i) => {
            const href = alternates?.[l.code];
            return (
              <>
                {i > 0 && <span class="lang-sep">·</span>}
                {l.code === lang ? (
                  <span class="active" aria-current="true">{l.label}</span>
                ) : href ? (
                  <a href={href} hreflang={l.code}>{l.label}</a>
                ) : (
                  <span class="disabled" aria-disabled="true" title={t('translationPending')}>{l.label}</span>
                )}
              </>
            );
          })}
        </div>
      )}

      <button class="hamburger" aria-label={t('openMenu')} data-close-label={t('closeMenu')} aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector('.hamburger') as HTMLElement | null;
  const nav = document.querySelector('.nav-main') as HTMLElement | null;
  // .lang-switch không render khi site chỉ có 1 ngôn ngữ (PHA 4, GÓI 2) — không bắt buộc.
  const lang = document.querySelector('.lang-switch') as HTMLElement | null;
  if (!btn || !nav) throw new Error('Header: missing required elements');

  let open = false;
  const openLabel = btn.getAttribute('aria-label') || 'Menu';
  const closeLabel = btn.getAttribute('data-close-label') || openLabel;

  function show() {
    nav!.style.display = 'flex';
    nav!.style.flexDirection = 'column';
    nav!.style.position = 'absolute';
    nav!.style.top = 'var(--header-h)';
    nav!.style.left = '0';
    nav!.style.right = '0';
    nav!.style.background = 'var(--c-surface)';
    nav!.style.padding = 'var(--s4)';
    nav!.style.borderBottom = '1px solid var(--c-border)';
    nav!.style.zIndex = '99';
    if (lang) {
      lang.style.display = 'flex';
      lang.style.padding = '0 var(--s4) var(--s4)';
      lang.style.justifyContent = 'center';
    }
    btn!.setAttribute('aria-label', closeLabel);
    btn!.setAttribute('aria-expanded', 'true');
    open = true;
  }

  function hide() {
    nav!.style.display = '';
    nav!.style.flexDirection = '';
    nav!.style.position = '';
    nav!.style.background = '';
    nav!.style.padding = '';
    nav!.style.borderBottom = '';
    nav!.style.zIndex = '';
    if (lang) {
      lang.style.display = '';
      lang.style.padding = '';
      lang.style.justifyContent = '';
    }
    btn!.setAttribute('aria-label', openLabel);
    btn!.setAttribute('aria-expanded', 'false');
    open = false;
  }

  btn!.addEventListener('click', () => {
    open ? hide() : show();
  });

  // Close when clicking any nav link
  nav!.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => { if (open) hide(); });
  });

  // ── Nhóm thả xuống ──
  // Dùng <button> chứ không phải hover thuần CSS: hover không mở được bằng bàn
  // phím và không dùng được trên cảm ứng.
  const groups = Array.from(document.querySelectorAll('.nav-group')) as HTMLElement[];

  function closeGroups(except?: HTMLElement) {
    for (const g of groups) {
      if (g === except) continue;
      g.removeAttribute('data-open');
      g.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
    }
  }

  for (const group of groups) {
    const toggle = group.querySelector('.nav-toggle') as HTMLElement | null;
    if (!toggle) continue;
    toggle.addEventListener('click', () => {
      const isOpen = group.getAttribute('data-open') === 'true';
      closeGroups(group);
      group.toggleAttribute('data-open', !isOpen);
      if (!isOpen) group.setAttribute('data-open', 'true');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  // Bấm ra ngoài thì đóng
  document.addEventListener('click', (e) => {
    if (!(e.target as Element)?.closest('.nav-group')) closeGroups();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeGroups();
    if (open) {
      hide();
      btn!.focus();
    }
  });

  // Reset on resize to desktop
  window.addEventListener('resize', () => {
    if (open && window.innerWidth >= 1024) hide();
  });
</script>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--s4);
    padding: var(--s2) var(--s4);
    background: var(--c-primary);
    color: var(--c-text-inverse);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    z-index: 200;
  }
  .skip-link:focus {
    top: var(--s2);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s6);
    height: var(--header-h);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-family: var(--font-display);
    font-weight: var(--fw-800);
    font-size: var(--fs-nav);
    color: var(--c-primary-strong);
    letter-spacing: 0;
    flex-shrink: 0;
  }

  /* Cỡ và hình của dấu hiệu thương hiệu nằm trong SiteLogo.astro — style Astro
     có phạm vi theo component nên không đặt được từ đây. */

  .nav-main {
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex: 1;
  }

  .nav-main a,
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    padding: var(--s3) var(--s3);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-600);
    color: var(--c-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: all var(--m-fast) var(--m-ease);
  }

  .nav-main a:hover,
  .nav-toggle:hover {
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }

  .nav-main a.active,
  .nav-toggle.active {
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }

  /* ── Nhóm thả xuống ── */
  .nav-group {
    position: relative;
  }

  .nav-caret {
    transition: transform var(--m-fast) var(--m-ease);
  }

  .nav-toggle[aria-expanded='true'] .nav-caret {
    transform: rotate(180deg);
  }

  .nav-submenu {
    display: none;
    position: absolute;
    top: calc(100% + var(--s2));
    left: 0;
    min-width: 232px;
    flex-direction: column;
    padding: var(--s2);
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised);
    z-index: 120;
  }

  .nav-group[data-open='true'] .nav-submenu {
    display: flex;
  }

  .nav-submenu a {
    white-space: nowrap;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .lang-switch {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s1);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    font-weight: var(--fw-500);
  }

  .lang-sep {
    color: var(--c-border);
  }

  .lang-switch .active {
    color: var(--c-primary);
    font-weight: var(--fw-700);
  }

  .lang-switch a {
    color: var(--c-text-muted);
    font-weight: var(--fw-500);
    transition: color var(--m-fast) var(--m-ease);
  }

  .lang-switch a:hover {
    color: var(--c-primary);
  }

  .lang-switch .disabled {
    color: var(--c-border);
    cursor: not-allowed;
  }

  .hamburger {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: var(--c-primary-soft);
    color: var(--c-primary);
    border: none;
    cursor: pointer;
  }

  @media (max-width: 1023px) {
    .nav-main,
    .lang-switch {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    /* Trên điện thoại menu đã là một cột — nhóm con trải phẳng thay vì
       nổi lên trên, vì lớp nổi trong menu dọc rất khó bấm trúng. */
    .nav-group,
    .nav-submenu {
      display: block;
      position: static;
      min-width: 0;
      padding: 0;
      border: none;
      box-shadow: none;
      background: none;
    }
    .nav-submenu a {
      padding-left: var(--s5);
    }
    .nav-toggle {
      display: none;
    }
  }
</style>
