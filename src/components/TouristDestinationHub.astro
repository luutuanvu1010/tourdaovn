---
/**
 * Trang điểm đến `/{destinationSlug}/`.
 *
 * Ghép từ chính bộ khối mà `SiteHome` dùng, không dựng lại markup riêng.
 * Căn cứ: `06-BINDING_MAP` §4.1 khai trang điểm đến là *"khung chung áp dụng,
 * cộng"* các khối riêng, và §5.7 khai khối nội dung trang chủ là *"như §4.1"* —
 * tức đặc tả đã bắt hai trang dùng chung một bộ khối. Trước bản này mã có hai
 * bản cho một đặc tả: `SiteHome` ghép component, còn file này tự vẽ 1086 dòng.
 * Xem DR-061.
 *
 * Khác `SiteHome` đúng bốn chỗ, đều là thứ §4.1 khai thêm cho trang điểm đến:
 * hero điểm đến (không phải hero site), điểm đến liên quan, ghi chú an toàn,
 * và dải meta cuối trang.
 */
import Body from './Body.astro'
import Breadcrumb from './Breadcrumb.astro'
import FAQ from './FAQ.astro'
import Hero from './Hero.astro'
import HomeAreaGrid from './HomeAreaGrid.astro'
import HomeBannerGrid from './HomeBannerGrid.astro'
import HomeFacts from './HomeFacts.astro'
import HomeGuideGrid from './HomeGuideGrid.astro'
import HomeHubGrid from './HomeHubGrid.astro'
import HomeMetaBar from './HomeMetaBar.astro'
import HomeRollupSection from './HomeRollupSection.astro'
import HomeTrustBar from './HomeTrustBar.astro'
import Section from './Section.astro'
import { HOME_COPY, indexHref } from '../lib/homepage'
import type { Lang, TouristDestinationHubProps } from '../lib/types'

export interface Props extends TouristDestinationHubProps {}

const { td, lang } = Astro.props

// Hai prop này cho phép nơi gọi truyền sẵn danh sách đã gom; không truyền thì
// lấy từ chính document. Giữ nguyên hợp đồng cũ, RouteDispatch đang dùng.
const areaPlaces = Array.isArray(Astro.props.areaPlaces) ? Astro.props.areaPlaces : (td?.homepagePlaces || [])
const guideArticles = Array.isArray(Astro.props.guideArticles) ? Astro.props.guideArticles : (td?.homepageArticles || [])

const copy = HOME_COPY[lang]
const title = td?.title || ''
const summary = td?.summary

/* Sanity trả về object ảnh RỖNG NHƯNG TRUTHY khi field chưa nhập, nên
   `Boolean(image)` luôn đúng và hero dựng ra một khung gradient trống — đúng ca
   mà cổng BM-EMPTY-REGION bắt được hồi vòng 5. Phải soi tới `asset.url`. */
const heroImage = td?.mainImage
const hasHeroImage = typeof heroImage === 'string'
  ? Boolean(heroImage)
  : Boolean((heroImage as any)?.asset?.url)

const localeMap: Record<Lang, string> = {
  vi: 'vi-VN',
  en: 'en-US',
  zh: 'zh-CN',
  ko: 'ko-KR',
  ru: 'ru-RU',
}

function formatDate(value?: string) {
  if (!value) return undefined
  const date = new Date(value)
  if (Number.isNaN(date.getTime())) return undefined
  return new Intl.DateTimeFormat(localeMap[lang], {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date)
}

const updatedLabel = formatDate(td?.updatedAt || td?._updatedAt)

const safePrefixes = ['/', 'https://', 'http://', 'tel:', 'mailto:']
const relatedDestinations = (td?.relatedDestinations || [])
  .map(destination => ({
    name: destination.name,
    href: destination.url && safePrefixes.some(p => destination.url!.startsWith(p)) ? destination.url : undefined,
  }))
  .filter(destination => destination.name && destination.href)

// Ba guard giữ nguyên từ bản cũ. R7: vùng rỗng thì ẩn hẳn, không để lại tiêu đề trơ.
const hasBody = Boolean(td?.body?.length)
const hasHighlights = Boolean(td?.highlights?.length)
const hasFacts = Boolean(td?.keyFacts?.length)
const hasOverview = hasBody || hasHighlights || hasFacts
const hasReference = Boolean(td?.faq?.length || td?.safetyNote || td?.sameAs?.length)
---

{/* ── Bốn dải quanh hero — 06 v2.5, đúng thứ tự khung chung ──
    §3 hàng Hero: *"trên ảnh chỉ còn huy hiệu loại. `title` và `summary` đều đã
    ra ngoài … KHÔNG CÒN CHỮ NÀO ĐÈ LÊN ẢNH."*
    §3.1 hàng Nhãn loại entity: *"không áp dụng: … touristDestination"* — trang
    này không có huy hiệu, nên hero còn đúng một tấm ảnh.
    Thứ tự khối (§6, v2.5): breadcrumb → tiêu đề → hero → đoạn mở → nội dung.
    Trang điểm đến không có thanh dính (đó là thiết bị của trang chi tiết), nên
    đoạn mở nối thẳng sau hero. */}

<div class="crumb-band">
  <Breadcrumb entityType="touristDestination" lang={lang} currentTitle={title} />
</div>

<div class="title-band">
  <div class="container">
    <h1 class="detail-title">{title}</h1>
  </div>
</div>

{/* R7: không ảnh thì bỏ hẳn hero, không dựng khung rỗng. Trang này không có
    huy hiệu nên ảnh là điều kiện duy nhất. `hasOverlay={false}` — lớp phủ tối
    sinh ra CHỈ để chữ đè trên ảnh đọc được; không còn chữ thì nó chỉ làm tối
    55% dưới của một tấm ảnh không lý do. */}
{hasHeroImage && (
  <Hero image={heroImage} imageAlt={(heroImage as any)?.alt || title} fullBleed hasOverlay={false} />
)}

{/* Ghi công ảnh: giữ lại nhưng đưa XUỐNG DƯỚI ảnh. Bản cũ đặt nó đè lên góc
    ảnh. `Hero` dùng chung không có chỗ cho dòng này (trang chi tiết không hiện
    ghi công), nên nó đứng riêng ở đây, không khai `data-region`. */}
{td?.imageProvenance && (
  <div class="hero-credit-band">
    <div class="container"><p class="hero-credit">{td.imageProvenance}</p></div>
  </div>
)}

{summary && (
  <div class="summary-band" data-region="summary-band">
    <div class="container">
      <p class="detail-summary" data-field="summary" data-speakable>{summary}</p>
    </div>
  </div>
)}

{/* Không truyền `heading` — bản cũ của trang này không có tiêu đề mục cho dải
    tin cậy, mỗi mục tự là một h2. Giữ nguyên nội dung; bản refactor này chỉ đổi
    cấu trúc. Trang chủ có truyền tiêu đề; muốn khớp nốt thì là một quyết định
    nội dung, cần chủ dự án duyệt riêng. */}
<HomeTrustBar items={copy.trustItems} />

{hasOverview && (
  /* Hai cột — cùng bố cục `SiteHome` đang dùng theo QĐ-2026-08-25-01: thân bài
     và điểm nổi bật ở cột chính, Thông tin nhanh về cột phụ 340px thay vì thành
     dải riêng chạy hết bề ngang. Dưới 1024px xếp chồng. */
  <Section heading={copy.sections.overview(title)}>
    <div class="editorial-grid">
      <div class="editorial-main">
        {hasBody && td?.body && <Body blocks={td.body} />}
        {hasHighlights && td?.highlights && (
          <>
            <h3 class="highlights-heading">{copy.sections.highlights}</h3>
            <ul class="highlights-list">
              {td.highlights.map(h => <li>{h}</li>)}
            </ul>
          </>
        )}
      </div>
      {hasFacts && td?.keyFacts && (
        <aside class="editorial-aside">
          <HomeFacts facts={td.keyFacts} aside />
        </aside>
      )}
    </div>
  </Section>
)}

<HomeHubGrid lang={lang} />

{td?.homepageBanners?.length ? <HomeBannerGrid banners={td.homepageBanners} lang={lang} /> : null}

{td?.featuredAttractions?.length ? (
  <HomeRollupSection heading={copy.sections.attractions} items={td.featuredAttractions} lang={lang} viewAllLabel={copy.viewAll} viewAllHref={indexHref('attraction', lang)} />
) : null}

{td?.featuredExperiences?.length ? (
  <HomeRollupSection heading={copy.sections.experiences} items={td.featuredExperiences} lang={lang} viewAllLabel={copy.viewAll} viewAllHref={indexHref('experience', lang)} />
) : null}

{td?.featuredStays?.length ? (
  <HomeRollupSection heading={copy.sections.stays} items={td.featuredStays} lang={lang} viewAllLabel={copy.viewAll} viewAllHref={indexHref('hotel', lang)} />
) : null}

{td?.featuredSpecialties?.length ? (
  <HomeRollupSection heading={copy.sections.specialties} items={td.featuredSpecialties} lang={lang} viewAllLabel={copy.viewAll} viewAllHref={indexHref('specialty', lang)} />
) : null}

{td?.featuredTours?.length ? (
  <HomeRollupSection heading={copy.sections.tours} items={td.featuredTours} lang={lang} viewAllLabel={copy.viewAll} viewAllHref={indexHref('tour', lang)} />
) : null}

{areaPlaces.length > 0 && (
  <HomeAreaGrid places={areaPlaces} lang={lang} heading={copy.sections.areas} viewAllLabel={copy.viewAll} viewAllHref={indexHref('place', lang)} />
)}

{guideArticles.length > 0 && (
  <HomeGuideGrid articles={guideArticles} lang={lang} heading={copy.sections.articles} viewAllLabel={copy.viewAll} viewAllHref={indexHref('article', lang)} />
)}

{relatedDestinations.length > 0 && (
  /* Không có component dùng chung cho khối này: trang chủ không render điểm đến
     liên quan. `06` §4.1 khai nó là khối riêng của trang điểm đến. */
  <Section heading={copy.sections.relatedDestinations}>
    <div class="related-grid">
      {relatedDestinations.map(destination => (
        <a href={destination.href!} class="related-card">
          <span>{destination.name}</span>
          <span aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </Section>
)}

{hasReference && (
  <section class="reference-section">
    <div class="container container--editorial">
      {td?.faq && td.faq.length > 0 && (
        <FAQ faq={td.faq} heading={copy.sections.faq} contained={false} />
      )}

      {td?.safetyNote && (
        <aside class="safety-note">
          <h2 class="safety-title">{copy.safety}</h2>
          <p class="safety-body">{td.safetyNote}</p>
        </aside>
      )}

      <HomeMetaBar sameAs={td?.sameAs} updatedLabel={updatedLabel} lang={lang} />
    </div>
  </section>
)}

<style>
  /* Chỉ còn CSS cho ba thứ không có component dùng chung: lưới hai cột của mục
     tổng quan, khối điểm đến liên quan, và cụm tham chiếu cuối trang. Mọi mục
     khác lấy khung, tiêu đề, gạch chân và điểm ngắt từ `Section.astro`.
     Điểm ngắt viết bằng px thật — `var()` KHÔNG dùng được trong điều kiện media
     query, trình duyệt bỏ nguyên khối mà không báo lỗi (DR-060). */

  /* Bốn dải quanh hero — cùng token và cùng giá trị với `DetailLayout.astro`
     để trang điểm đến và trang chi tiết khớp nhau, không phải hai nhịp khác
     nhau. Cả bốn đứng trên nền trang, không đè ảnh, nên chữ dùng token màu chữ
     thường chứ không phải --c-text-inverse. */
  .crumb-band {
    background: var(--c-surface);
    padding: var(--s3) 0 0;
  }

  .title-band {
    background: var(--c-surface);
    padding: var(--s3) 0 var(--s5);
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(var(--fs-h3), 4.2vw, var(--fs-hero));
    font-weight: var(--fw-800);
    color: var(--c-text);
    line-height: var(--lh-display);
    text-wrap: balance;
    padding-bottom: var(--s2);
    margin: 0;
  }

  .hero-credit-band {
    background: var(--c-surface);
    padding: var(--s2) 0 0;
  }

  .hero-credit {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }

  .summary-band {
    background: var(--c-surface);
    padding: var(--s5) 0 0;
  }

  .detail-summary {
    max-width: 62ch;
    color: var(--c-text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    margin: 0;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--s7);
    align-items: start;
  }

  /* Bắt buộc, không phải trang trí. Ở ≤1024px rãnh thành `1fr`, mà `1fr` là
     `minmax(auto, 1fr)` — nội dung không ngắt được (URL dài, bảng rộng) sẽ đẩy
     rãnh vượt container và làm cả trang cuộn ngang. `SiteHome.astro:424` khai
     đúng dòng này cho cùng lưới. */
  .editorial-main {
    min-width: 0;
  }

  .highlights-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--fw-700);
    color: var(--c-text);
    margin: var(--s6) 0 var(--s3);
  }

  .highlights-list {
    margin: 0;
    padding-left: var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    color: var(--c-text);
    line-height: var(--lh-body);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s4);
  }

  .related-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: var(--s4) var(--s5);
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    color: var(--c-text);
    text-decoration: none;
    font-weight: var(--fw-600);
  }

  .related-card:hover {
    border-color: var(--c-primary);
    color: var(--c-primary);
  }

  .reference-section {
    padding: var(--s7) 0;
    background: var(--c-surface-alt);
    border-top: 1px solid var(--c-border);
  }

  .container--editorial {
    max-width: var(--container-editorial);
  }

  .safety-note {
    margin-top: var(--s6);
    padding: var(--s5);
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }

  .safety-title {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--fw-700);
    color: var(--c-text);
    margin-bottom: var(--s2);
  }

  .safety-body {
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  @media (max-width: 1024px) {
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Luật 5 (06 §6): cột trên máy tính thành hàng trải hết bề ngang ở ≤640px. */
  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .reference-section {
      padding: var(--s5) 0;
    }
  }
</style>
