---
import Body from './Body.astro'
import Card from './Card.astro'
import FAQ from './FAQ.astro'
import HomeHero from './HomeHero.astro'
import HomeMetaBar from './HomeMetaBar.astro'
import { HOME_COPY, entityHref, indexHref, routeForEntity } from '../lib/homepage'
import { imageUrl } from '../lib/sanity-image'
import { navHubs } from '../site.config'
import type {
  EntityRef,
  HomepageArticleCard,
  HomepagePlaceCard,
  Lang,
  TouristDestinationHubProps,
} from '../lib/types'

export interface Props extends TouristDestinationHubProps {}

const { td, lang, stampText } = Astro.props
const areaPlaces = Array.isArray(Astro.props.areaPlaces) ? Astro.props.areaPlaces : (td?.homepagePlaces || [])
const guideArticles = Array.isArray(Astro.props.guideArticles) ? Astro.props.guideArticles : (td?.homepageArticles || [])

const copy = HOME_COPY[lang]
const title = td?.title || ''
const summary = td?.summary
const currentYear = new Date().getFullYear().toString()

const localeMap: Record<Lang, string> = {
  vi: 'vi-VN',
  en: 'en-US',
  zh: 'zh-CN',
  ko: 'ko-KR',
  ru: 'ru-RU',
}

function formatDate(value?: string) {
  if (!value) return undefined
  const date = new Date(value)
  if (Number.isNaN(date.getTime())) return undefined
  return new Intl.DateTimeFormat(localeMap[lang], {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date)
}

const updatedLabel = formatDate(td?.updatedAt || td?._updatedAt)

function featuredCards(items: EntityRef[] | undefined | null, fallbackEntity: string, limit: number) {
  if (!Array.isArray(items)) return []
  return items
    .map(item => {
      const entityType = item._type || fallbackEntity
      const href = entityHref(entityType, item.slug, lang)
      const image = imageUrl(item.mainImage, { width: 640 })
      if (!href || !item.title || !item.summary) return null
      return { ...item, href, image }
    })
    .filter(Boolean)
    .slice(0, limit) as Array<EntityRef & { href: string; image?: string }>
}

const attractionCards = featuredCards(td?.featuredAttractions, 'attraction', 3)
const experienceCards = featuredCards(td?.featuredExperiences, 'experience', 3)
const stayCards = featuredCards(td?.featuredStays, 'hotel', 4)
const specialtyCards = featuredCards(td?.featuredSpecialties, 'specialty', 4)
const tourCards = featuredCards(td?.featuredTours, 'tour', 3)

const safePrefixes = ['/', 'https://', 'http://', 'tel:', 'mailto:']
function safeUrl(url?: string) {
  return url && safePrefixes.some(prefix => url.startsWith(prefix)) ? url : undefined
}

const banners = (td?.homepageBanners || [])
  .filter(banner => banner.title)
  .map(banner => ({
    ...banner,
    href: safeUrl(banner.linkUrl),
    image: imageUrl(banner.image, { width: 560 }),
    imageAlt: banner.image?.alt || banner.title,
  }))
  .slice(0, 3)

// Hub nào hiện ở đây do src/site.config.ts quyết định, không khai lại tại chỗ.
const hubEntities = navHubs
const hubIcons: Record<string, string> = {
  'hub-kham-pha': '🏛️',
  'hub-luu-tru': '🛏️',
  'hub-di-lai': '🚌',
}

const hubIconBg: Record<string, string> = {
  'hub-kham-pha': 'var(--c-primary-soft)',
  'hub-luu-tru': 'var(--c-green-soft)',
  'hub-di-lai': 'var(--c-sand-soft)',
}

const hubs = hubEntities
  .map(entity => {
    const route = routeForEntity(entity)
    const href = indexHref(entity, lang)
    if (!route || !href) return null
    return {
      entity,
      href,
      label: route.labels[lang],
      description: copy.hubDescriptions[entity] || '',
      icon: hubIcons[entity],
      iconBg: hubIconBg[entity],
    }
  })
  .filter(Boolean) as Array<{
    entity: string
    href: string
    label: string
    description: string
    icon: string
    iconBg: string
  }>

const areaCards = areaPlaces
  .map((place: HomepagePlaceCard) => ({
    ...place,
    href: entityHref('place', place.slug, lang),
    image: imageUrl(place.mainImage, { width: 520 }),
  }))
  .filter(card => card.href && card.title && card.summary)
  .slice(0, 4)

const articleCards = guideArticles
  .map((article: HomepageArticleCard) => ({
    ...article,
    href: entityHref('article', article.slug, lang),
    image: imageUrl(article.mainImage, { width: 520 }),
  }))
  .filter(card => card.href && card.title && card.summary)
  .slice(0, 4)

const relatedDestinations = (td?.relatedDestinations || [])
  .map(destination => ({
    name: destination.name,
    href: safeUrl(destination.url),
  }))
  .filter(destination => destination.name && destination.href)

const hasOverview = Boolean(td?.body?.length || td?.highlights?.length || td?.keyFacts?.length)
const hasReference = Boolean(td?.faq?.length || td?.safetyNote || td?.sameAs?.length)
---

<HomeHero
  title={title}
  summary={summary}
  image={td?.mainImage}
  eyebrow={copy.heroEyebrow}
  imageCredit={td?.imageProvenance}
  stampText={stampText}
  stampYear={currentYear}
/>

<section class="hub-section hub-section--editorial hub-section--trust">
  <div class="container container--editorial">
    <div class="trust-grid">
      {copy.trustItems.map(item => (
        <article class="trust-item">
          <div class="trust-icon" aria-hidden="true">{item.icon}</div>
          <div>
            <h2 class="trust-title">{item.title}</h2>
            <p class="trust-desc">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

{hasOverview && (
  <section class="hub-section hub-section--editorial">
    <div class="container container--editorial">
      <div class="overview-stack">
        {td?.body && td.body.length > 0 && (
          <div class="overview-block">
            <h2 class="section-title">{copy.sections.overview(title)}</h2>
            <span class="section-underline" aria-hidden="true"></span>
            <div class="body-text">
              <Body blocks={td.body} />
            </div>
            {td?.keyFacts && td.keyFacts.length > 0 && (
              <div class="facts-grid">
                {td.keyFacts.map(fact => (
                  <article class="fact-card">
                    <p class="fact-label">{fact.label}</p>
                    <p class="fact-value">{fact.value}</p>
                  </article>
                ))}
              </div>
            )}
          </div>
        )}

        {td?.highlights && td.highlights.length > 0 && (
          <div class="overview-block">
            <h2 class="section-title">{copy.sections.highlights}</h2>
            <span class="section-underline" aria-hidden="true"></span>
            <ul class="highlights-list">
              {td.highlights.map(highlight => (
                <li class="highlight-item">
                  <span class="highlight-marker" aria-hidden="true">✦</span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

{hubs.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--hubs">
    <div class="container">
      <div class="section-header section-header--center">
        <h2 class="section-title section-title--inverse">{copy.hubsHeading}</h2>
        <p class="section-subtitle section-subtitle--inverse">{copy.hubsSub}</p>
      </div>
      <div class="hubs-grid">
        {hubs.map(hub => (
            <a href={hub.href} class="hub-card">
            <div class="hub-icon" style={`background:${hub.iconBg}`} aria-hidden="true">{hub.icon}</div>
            <div>
              <h3 class="hub-name">{hub.label}</h3>
              <p class="hub-desc">{hub.description}</p>
            </div>
            <div class="hub-footer">
              <span class="hub-arrow" aria-hidden="true">›</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{banners.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--banners">
    <div class="container">
      <div class="banner-list">
        {banners.map(banner => (
          banner.href ? (
            <a href={banner.href} class:list={{ 'banner-card': true, 'banner-card--text': !banner.image }}>
              {banner.image && (
                <div class="banner-media">
                  <img src={banner.image} alt={banner.imageAlt} loading="lazy" />
                </div>
              )}
              <div class="banner-body">
                {banner.linkLabel && <p class="banner-kicker">{banner.linkLabel}</p>}
                <h2 class="banner-title">{banner.title}</h2>
                {banner.description && <p class="banner-desc">{banner.description}</p>}
              </div>
            </a>
          ) : (
            <article class:list={{ 'banner-card': true, 'banner-card--text': !banner.image }}>
              {banner.image && (
                <div class="banner-media">
                  <img src={banner.image} alt={banner.imageAlt} loading="lazy" />
                </div>
              )}
              <div class="banner-body">
                {banner.linkLabel && <p class="banner-kicker">{banner.linkLabel}</p>}
                <h2 class="banner-title">{banner.title}</h2>
                {banner.description && <p class="banner-desc">{banner.description}</p>}
              </div>
            </article>
          )
        ))}
      </div>
    </div>
  </section>
)}

{attractionCards.length > 0 && (
  <section class="hub-section hub-section--navigation">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.attractions}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('attraction', lang) && <a href={indexHref('attraction', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="feature-grid feature-grid--attractions">
        {attractionCards.map(card => (
          <div class="feature-card-wrap">
            <Card title={card.title} summary={card.summary || ''} href={card.href} image={card.image} imageAlt={card.mainImage?.alt || card.title} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{experienceCards.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--alt">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.experiences}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('experience', lang) && <a href={indexHref('experience', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="feature-grid feature-grid--experiences">
        {experienceCards.map((card, index) => (
          <div class:list={{ 'feature-card-wrap': true, 'feature-card-wrap--large': index === 0 }}>
            <Card title={card.title} summary={card.summary || ''} href={card.href} image={card.image} imageAlt={card.mainImage?.alt || card.title} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{stayCards.length > 0 && (
  <section class="hub-section hub-section--navigation">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.stays}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('hub-luu-tru', lang) && <a href={indexHref('hub-luu-tru', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="feature-grid feature-grid--stays">
        {stayCards.map(card => (
          <div class="feature-card-wrap">
            <Card title={card.title} summary={card.summary || ''} href={card.href} image={card.image} imageAlt={card.mainImage?.alt || card.title} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{specialtyCards.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--alt">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.specialties}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('specialty', lang) && <a href={indexHref('specialty', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="specialty-grid">
        {specialtyCards.map(card => (
          <a href={card.href} class:list={{ 'art-card': true, 'art-card--text': !card.image }}>
            {card.image && (
              <div class="art-card-media">
                <img src={card.image} alt={card.mainImage?.alt || card.title} loading="lazy" />
              </div>
            )}
            <div class="art-card-body">
              <h3 class="art-card-title">{card.title}</h3>
              <p class="art-card-desc">{card.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{tourCards.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--soft">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.tours}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('tour', lang) && <a href={indexHref('tour', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="feature-grid feature-grid--tours">
        {tourCards.map(card => (
          <div class="feature-card-wrap">
            <Card title={card.title} summary={card.summary || ''} href={card.href} image={card.image} imageAlt={card.mainImage?.alt || card.title} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{areaCards.length > 0 && (
  <section class="hub-section hub-section--navigation">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.areas}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('place', lang) && <a href={indexHref('place', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="rollup-grid">
        {areaCards.map(card => (
          <a href={card.href!} class="rollup-card">
            {card.image && (
              <div class="rollup-media">
                <img src={card.image} alt={card.mainImage?.alt || card.title} loading="lazy" />
              </div>
            )}
            <div class="rollup-body">
              <h3 class="rollup-title">{card.title}</h3>
              <p class="rollup-desc">{card.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{articleCards.length > 0 && (
  <section class="hub-section hub-section--navigation hub-section--alt">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.articles}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
        {indexHref('article', lang) && <a href={indexHref('article', lang)} class="see-all">{copy.viewAll} ›</a>}
      </div>
      <div class="article-grid">
        {articleCards.map(card => (
          <a href={card.href!} class:list={{ 'art-card': true, 'art-card--text': !card.image }}>
            {card.image && (
              <div class="art-card-media">
                <img src={card.image} alt={card.mainImage?.alt || card.title} loading="lazy" />
              </div>
            )}
            <div class="art-card-body">
              <h3 class="art-card-title">{card.title}</h3>
              {card.author?.title && <p class="art-card-meta">{card.author.title}</p>}
              <p class="art-card-desc">{card.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{relatedDestinations.length > 0 && (
  <section class="hub-section hub-section--navigation">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">{copy.sections.relatedDestinations}</h2>
          <span class="section-underline" aria-hidden="true"></span>
        </div>
      </div>
      <div class="related-grid">
        {relatedDestinations.map(destination => (
          <a href={destination.href!} class="related-card">
            <span>{destination.name}</span>
            <span aria-hidden="true">›</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{hasReference && (
  <section class="hub-section hub-section--reference">
    <div class="container container--editorial">
      {td?.faq && td.faq.length > 0 && (
        <FAQ faq={td.faq} heading={copy.sections.faq} contained={false} />
      )}

      {td?.safetyNote && (
        <aside class="safety-note">
          <h2 class="safety-title">{copy.safety}</h2>
          <p class="safety-body">{td.safetyNote}</p>
        </aside>
      )}

      <HomeMetaBar sameAs={td?.sameAs} updatedLabel={updatedLabel} lang={lang} />
    </div>
  </section>
)}

<style>
  .container--editorial {
    max-width: var(--container-editorial);
  }

  .hub-section {
    background: var(--c-surface);
  }

  .hub-section--editorial {
    padding: var(--s9) 0;
  }

  .hub-section--trust {
    padding: var(--s7) 0 var(--s6);
  }

  .hub-section--navigation {
    padding: var(--s7) 0;
  }

  .hub-section--reference {
    background: var(--c-primary-soft);
    border-top: 1px solid var(--c-border);
    padding: var(--s6) 0;
  }

  .hub-section--alt {
    background: var(--c-surface-alt);
  }

  .hub-section--soft {
    background: var(--c-primary-soft);
  }

  .hub-section--hubs {
    background: var(--c-primary);
  }

  .hub-section--banners {
    padding-top: var(--s6);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s5);
  }

  .section-header--center {
    display: block;
    text-align: center;
    max-width: var(--container-editorial);
    margin-inline: auto;
    margin-bottom: var(--s6);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: var(--fw-800);
    font-size: var(--fs-section);
    letter-spacing: -0.015em;
    color: var(--c-primary);
    line-height: var(--lh-heading);
    margin-bottom: var(--s2);
  }

  .section-title--inverse {
    color: var(--c-text-inverse);
  }

  .section-subtitle {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  .section-subtitle--inverse {
    color: var(--c-text-inverse);
    opacity: .72;
  }

  .section-underline {
    display: block;
    width: var(--underline-width);
    height: var(--underline-height);
    background: var(--c-sand);
    border-radius: var(--radius-pill);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    color: var(--c-primary);
    font-size: var(--fs-label);
    font-weight: var(--fw-700);
    transition: opacity var(--m-fast) var(--m-ease);
  }

  .see-all:hover {
    opacity: .72;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s4);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--s4);
    box-shadow: var(--shadow-card);
  }

  .trust-icon {
    width: var(--s7);
    height: var(--s7);
    border-radius: var(--radius-sm);
    background: var(--c-primary-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    font-size: var(--fs-card-title);
  }

  .trust-title {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: var(--fw-700);
    color: var(--c-text);
    margin-bottom: var(--s1);
  }

  .trust-desc {
    font-size: var(--fs-label);
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  .overview-stack {
    display: grid;
    gap: var(--s7);
  }

  .body-text {
    color: var(--c-text);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  .body-text :global(p + p) {
    margin-top: var(--s4);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s4);
  }

  .fact-card {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--s5);
  }

  .fact-label {
    color: var(--c-text-muted);
    font-size: var(--fs-label);
    font-weight: var(--fw-700);
    line-height: var(--lh-heading);
    margin-bottom: var(--s2);
  }

  .fact-value {
    color: var(--c-text);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  .highlights-list {
    list-style: none;
    display: grid;
    gap: var(--s3);
  }

  .highlight-item {
    display: flex;
    gap: var(--s3);
    color: var(--c-text);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  .highlight-marker {
    color: var(--c-sand);
    flex: 0 0 auto;
    font-weight: var(--fw-700);
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s4);
  }

  .hub-card {
    background: var(--c-card);
    border-radius: var(--radius-md);
    padding: var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    min-height: 100%;
    transition: transform var(--m-fast) var(--m-ease), box-shadow var(--m-fast) var(--m-ease);
  }

  .hub-card:hover {
    transform: translateY(var(--card-lift));
    box-shadow: var(--shadow-lg);
  }

  .hub-icon {
    width: var(--s7);
    height: var(--s7);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-card-title);
  }

  .hub-name {
    font-size: var(--fs-h5);
    font-weight: var(--fw-800);
    color: var(--c-text);
    margin-bottom: var(--s1);
  }

  .hub-desc {
    color: var(--c-text-muted);
    font-size: var(--fs-label);
    line-height: var(--lh-body);
  }

  .hub-footer {
    margin-top: auto;
    display: flex;
