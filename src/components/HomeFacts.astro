---
import type { KeyFact } from '../lib/types'

export interface Props {
  facts?: KeyFact[]
  /**
   * Đứng CẠNH cột chữ thay vì thành dải riêng chạy hết bề ngang.
   * Bỏ nền, viền và container của dải; lưới về một cột để vừa cột phụ 340px.
   * Cùng nếp với prop `inline` của FactStrip — không phải API mới.
   */
  aside?: boolean
}

const facts = Array.isArray(Astro.props.facts) ? Astro.props.facts : []
const { aside = false } = Astro.props
---

{facts.length > 0 && (
  <div class:list={['facts-section', { 'facts-section--aside': aside }]}>
    <div class:list={[{ container: !aside }]}>
      <div class="facts-grid">
        {facts.map(fact => (
          <div class="fact-card">
            <span class="fact-label">{fact.label}</span>
            <span class="fact-value">{fact.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .facts-section {
    background: var(--c-primary-soft);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
    padding: var(--s7) 0;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s4);
  }

  /* Biến thể cạnh cột chữ: bỏ dải, xếp dọc, chữ về căn trái cho khớp cột chữ
     bên cạnh — căn giữa chỉ hợp khi bốn thẻ nằm ngang. */
  /* Hai lớp, không phải một: `@media (max-width: 640px) { .facts-section }` ở
     cuối file cũng là (0,1,0) và đứng SAU, nên một lớp sẽ thua và biến thể aside
     lấy lại 32px đệm dọc trên di động — đúng thứ nó phải bỏ. */
  .facts-section.facts-section--aside {
    background: none;
    border: 0;
    padding: 0;
  }

  .facts-section--aside .facts-grid {
    grid-template-columns: 1fr;
    gap: var(--s3);
  }

  .facts-section--aside .fact-card {
    text-align: left;
    background: var(--c-primary-soft);
    box-shadow: none;
  }

  .fact-card {
    background: var(--c-card);
    border-radius: var(--radius-md);
    padding: var(--s5);
    text-align: center;
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .fact-label {
    font-weight: var(--fw-600);
    font-size: var(--fs-label);
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    line-height: var(--lh-eyebrow);
  }

  .fact-value {
    font-weight: var(--fw-500);
    font-size: var(--fs-base);
    color: var(--c-text);
    line-height: var(--lh-body);
  }

  @media (max-width: 1024px) {
    .facts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .facts-section {
      padding: var(--s6) 0;
    }

    .facts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
