---
import type { Lang } from '../lib/types'
import SiteLogo from './SiteLogo.astro'
import FooterBadges from './FooterBadges.astro'
import { resolveNav, autoRouteLinks } from '../lib/routes'
import { uiCopy } from '../lib/uiCopy'
import { fetchSiteContact } from '../lib/siteContact'
import { fetchSiteFooter } from '../lib/siteFooter'
import { imageUrl } from '../lib/sanity-image'
import { brand } from '../site.config'

export interface Props {
  lang?: string
}

const { lang = 'vi' } = Astro.props
const uiLang = (['vi', 'en', 'zh', 'ko', 'ru'].includes(lang) ? lang : 'vi') as Lang
const t = uiCopy(uiLang)
const prefix = uiLang === 'vi' ? '' : `/${uiLang}`
const homeHref = uiLang === 'vi' ? '/' : `/${uiLang}/`

const contact = await fetchSiteContact()
const footerChannels = [
  contact?.hotline ? { href: `tel:${contact.hotline.replace(/\s+/g, '')}`, label: contact.hotline } : null,
  contact?.zaloUrl ? { href: contact.zaloUrl, label: t('contactZalo'), external: true } : null,
  contact?.email ? { href: `mailto:${contact.email}`, label: contact.email } : null,
].filter(Boolean) as { href: string; label: string; external?: boolean }[]

// Chân trang đọc cùng một `nav` với menu chính (ADR-0023, DR-007). Trước đây hai
// danh sách entity viết cứng ở đây, nên chân trang và menu lệch nhau mà không ai
// thấy. Nay sửa một chỗ là cả hai đổi theo.
const navItems = resolveNav(uiLang, contact?.zaloUrl, 'footer')
const navGroups = navItems.filter(i => i.children.length > 0)
const navFlat = navItems.filter(i => i.children.length === 0 && i.href)

// Nhóm thứ hai: MỌI trang danh sách đang bật, sinh thẳng từ ROUTE_MAP. Menu chính chỉ
// mang năm entity bán hàng, nên nếu không có nhóm này thì Khách sạn, Resort và bốn hub
// thành trang mồ côi — sống, nằm trong sitemap, mà không lối vào nào từ site.
// Bỏ đường dẫn đã có ở nhóm khai tay để không hiện hai lần.
const manualHrefs = new Set(navItems.flatMap(i => [i.href, ...i.children.map(c => c.href)]))
const browseLinks = autoRouteLinks(uiLang).filter(l => !manualHrefs.has(l.href))

const currentYear = new Date().getFullYear()
const copyrightYear = brand.foundedYear < currentYear ? `${brand.foundedYear}–${currentYear}` : `${currentYear}`

// Chữ và ảnh chân trang do biên tập viên nhập (QĐ-2026-08-14-03). Đọc qua đúng
// một đường `fetchSiteFooter()` — Footer render ở MỌI trang nên không đi nhờ
// `config` của trang chủ được.
const footerConfig = await fetchSiteFooter()

// Sáu ô chữ là TIẾNG VIỆT một tầng: ngôn ngữ khác thì bỏ qua giá trị Sanity và
// dùng bản dịch trong `uiCopy`. Cùng luật với `viOnly()` ở SiteHome.astro.
const viOnly = (value?: string) => (uiLang === 'vi' ? value?.trim() || undefined : undefined)

const footerTagline = viOnly(footerConfig?.tagline) || t('footerTagline')
const footerDisclaimer = viOnly(footerConfig?.disclaimer) || t('footerDisclaimer')
const footerBg = imageUrl(footerConfig?.backgroundImage, { width: 1800 })
---

<footer class:list={['site-footer', footerBg && 'site-footer--image']}>
  {/* Ảnh nền nằm DƯỚI một lớp phủ màu chân trang đục 88%: màu chữ ở đây được
      chọn để tương phản với nền đặc, giữ 88% màu đó thì tỉ lệ gần như không đổi,
      nên ảnh sáng cũng không nuốt mất chữ. Ngưỡng nghiệm thu là số — tương phản
      chữ chân trang trên ảnh sáng nhất phải ≥ 4.5:1 (WCAG AA). */}
  {footerBg && (
    <>
      <img class="foot-bg" src={footerBg} alt="" loading="lazy" decoding="async" />
      <div class="foot-bg-veil" aria-hidden="true"></div>
    </>
  )}
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href={homeHref} class="logo" aria-label={t('homeAria')}>
          <SiteLogo />
        </a>
        <p>{footerTagline}</p>
      </div>

      {navGroups.map(group => (
        <div class="foot-col">
          <h4>{group.label}</h4>
          <ul>
            {group.children.map(child => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      {navFlat.length > 0 && (
        <div class="foot-col">
          <h4>{t('footerServices')}</h4>
          <ul>
            {navFlat.map(item => (
              <li>
                <a
                  href={item.href}
                  target={item.href?.startsWith('http') ? '_blank' : undefined}
                  rel={item.href?.startsWith('http') ? 'noopener' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {browseLinks.length > 0 && (
        <div class="foot-col">
          <h4>{t('footerBrowse')}</h4>
          <ul>
            {browseLinks.map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="foot-col">
        <h4>{t('footerAboutUs')}</h4>
        <ul>
          {footerChannels.map(ch => (
            <li><a href={ch.href} target={ch.external ? '_blank' : undefined} rel={ch.external ? 'noopener' : undefined}>{ch.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <FooterBadges badges={footerConfig?.badges} />

    <div class="foot-bottom">
      {/* Tên pháp nhân là chữ MÁY đọc — nó cũng là `Organization.legalName` trong
          JSON-LD, nên ở lại `site.config.ts`, cố định lúc build (QĐ-2026-08-14-01). */}
      <span>&copy; {copyrightYear} {brand.legalName}</span>
      <span>{footerDisclaimer}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-footer-bg);
    color: var(--c-footer-text);
    padding: var(--s7) 0 var(--s5);
    font-size: var(--fs-sm);
  }

  /* Chỉ bật `position: relative` khi CÓ ảnh nền: không ảnh thì chân trang giữ
     nguyên hình cũ, không thêm ngữ cảnh xếp lớp nào. */
  .site-footer--image {
    position: relative;
    isolation: isolate;
  }

  .foot-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 88% — xem ghi chú ở phần markup. Đây là lớp giữ tương phản, không phải hiệu
     ứng thẩm mỹ: hạ con số này xuống là hạ tỉ lệ tương phản của chữ chân trang. */
  .foot-bg-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-footer-bg);
    opacity: 0.88;
  }

  .site-footer--image .container {
    position: relative;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: var(--s6);
    margin-bottom: var(--s6);
  }

  .foot-brand .logo {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-family: var(--font-display);
    font-weight: var(--fw-800);
    font-size: var(--fs-nav);
    color: var(--c-text-inverse);
    letter-spacing: 0;
    margin-bottom: var(--s3);
  }

  /* Cỡ và hình của dấu hiệu thương hiệu nằm trong SiteLogo.astro — style Astro
     có phạm vi theo component nên không đặt được từ đây. */

  .foot-brand p {
    font-size: var(--fs-sm);
    max-width: 36ch;
    line-height: 1.6;
    color: var(--c-footer-text);
  }

  .foot-col h4 {
    color: var(--c-text-inverse);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-eyebrow);
    line-height: var(--lh-eyebrow);
    text-transform: uppercase;
    margin-bottom: var(--s3);
    font-family: var(--font-ui);
    font-weight: var(--fw-600);
  }

  .foot-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .foot-col a {
    color: var(--c-footer-text);
    transition: color var(--m-fast) var(--m-ease);
  }

  .foot-col a:hover {
    color: var(--c-sand);
  }

  .foot-bottom {
    border-top: 1px solid var(--c-footer-border);
    padding-top: var(--s4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s3);
    flex-wrap: wrap;
    font-size: var(--fs-badge);
    color: var(--c-footer-muted);
  }

  @media (max-width: 768px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s5);
    }
  }

  @media (max-width: 480px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
