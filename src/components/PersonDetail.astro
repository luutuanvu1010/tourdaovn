---
import type { PersonResult, Lang } from '../lib/types'
import { siteBaseUrl, hostLabel } from '../lib/siteUrl'
import { uiCopy } from '../lib/uiCopy'
import DetailLayout from './DetailLayout.astro'
import Section from './Section.astro'
import Body from './Body.astro'
import { entityPageGraphToLd, personToJsonLd, jsonLdScriptContent } from '../lib/serialize'

export interface Props {
  data: PersonResult
  lang: Lang
  nearby?: import('../lib/types').NearbyEntity[]
}

const { data, lang, nearby = [] } = Astro.props

const t = uiCopy(lang)

// Thông tin nhanh — QĐ-2026-08-29-03 chuyển sang `FactStrip`, cùng vùng mà
// mười template kia đã dùng. Đóng nốt DR-046; `InfoCard.astro` đã xoá.
// `sameAs` KHÔNG nằm ở đây: `06` §3.1 khai nó là dòng "Nguồn tham khảo" cạnh
// Cập nhật ở cuối nội dung, "không nằm trong sidebar" — nay truyền qua prop
// `sameAs` của DetailLayout, đúng vùng, thay vì làm ô thứ bảy.
const facts = [
  { field: 'jobTitle', icon: '💼', label: t('role'), value: data.jobTitle || '', visible: !!data.jobTitle },
  { field: 'knowsAbout', icon: '📚', label: t('knowsAbout'), value: data.knowsAbout?.join(', ') || '', visible: !!(data.knowsAbout && data.knowsAbout.length > 0) },
  { field: 'url', icon: '🌐', label: t('website'), value: hostLabel(data.url), href: data.url || undefined, visible: !!data.url },
]

const siteBase = siteBaseUrl(Astro.site)
const jsonLd = entityPageGraphToLd(personToJsonLd(data, siteBase, lang), data, siteBase, lang)
---

<DetailLayout
  title={data.title}
  lang={lang}
  entityType="person"
  image={data.mainImage}
  sameAs={data.sameAs}
  facts={facts}
  sidebarSlots={[
  ]}
  nearbyTitle={t('articlesBy')}
  nearby={nearby}
  updatedAt={data._updatedAt}
>
  <Fragment slot="content">
    {data.summary && <div class="summary-block">{data.summary}</div>}

    {data.bio && (
      <Section contained={false}>
        <Body blocks={data.bio} />
      </Section>
    )}
  </Fragment>

</DetailLayout>

<script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)}></script>

<style>
  .summary-block {
    font-size: var(--fs-h5);
    max-width: 70ch;
    line-height: var(--lh-body);
    font-weight: var(--fw-500);
    font-family: var(--font-ui);
    margin-bottom: var(--s6);
  }
</style>
