---
export interface Slot {
  name: string
  // I4 fix round (2026-08-23): 'custom' từng khai cho ô FactStrip chèn qua slot
  // 'info'. Bỏ khỏi union thay vì để mã chết (tiền lệ Ruling 2: hằng khai mà
  // không dùng là nợ reviewer sẽ bắt).
  // Cập nhật QĐ-2026-08-25-02: không còn "FactStrip inline" nào cả — Thông tin
  // nhanh nay luôn là dải riêng phía trên `.two-col`, không đi qua Sidebar dưới
  // bất kỳ hình thức nào.
  // 'BookingForm' (nhánh đặt tour): ô đặt trong slot 'booking' khi tour có giá.
  // 'InfoCard' đã rời union theo main (InfoCard.astro đã xoá, DR-046 / QĐ-2026-08-29-03).
  component: 'BookingCTA' | 'BookingForm' | 'Map' | 'Article'
  visible: boolean
  props: Record<string, any>
}

export interface Props {
  slots: Slot[]
  /** Trang có thanh dính dưới header (DetailLayout) → chỗ dính cộng thêm --sticky-bar-h. */
  stickyBar?: boolean
}

const { slots, stickyBar = false } = Astro.props
const anyVisible = slots.some(s => s.visible)
---

{anyVisible && (
  <aside class="sidebar" style={`--sidebar-offset:${stickyBar ? 'var(--sticky-bar-h)' : '0px'}`}>
    {slots.filter(s => s.visible).map((s) => (
      <div class="sidebar-card">
        {s.name === 'booking' && <slot name="booking" />}
        {s.name === 'map' && <slot name="map" />}
        {s.name === 'about' && <slot name="about" />}
      </div>
    ))}
  </aside>
)}

<style>
  /* Chỗ dính = header + thanh dính (nếu DetailLayout có, qua --sidebar-offset) + 16px.
     Trước đây top:16px chết cứng nên sidebar chui xuống dưới header và thanh dính,
     hai dòng đầu của thẻ thông tin khuất — DR-033. */
  .sidebar {
    /* grid-area 'sidebar' — tên vùng dùng chung với `.two-col` (DetailLayout.astro)
       và cả hai bản grid-template-areas của nó (desktop/di động, I4). Đặt tên ở
       đây để .sidebar tự đứng đúng ô dù bản mẫu nào đang chạy — không cần lặp lại
       chọn lựa breakpoint. */
    grid-area: sidebar;
    width: 340px;
    position: sticky;
    top: calc(var(--header-h) + var(--sidebar-offset, 0px) + var(--s4));
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .sidebar-card {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--s4);
  }

  @media (max-width: 1023px) {
    .sidebar {
      width: 100%;
      position: static;
    }
  }
</style>
