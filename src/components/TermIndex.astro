---
import type { Lang, PriceEntry } from '../lib/types'
import { siteBaseUrl } from '../lib/siteUrl'
import { uiCopy, TOUR_FORMAT_LABELS } from '../lib/uiCopy'
import { resolvePrice } from '../lib/resolver'
import { ROUTE_MAP } from '../lib/routes'
import { termToJsonLd, jsonLdScriptContent } from '../lib/serialize'
import Card from './Card.astro'
import EmptyState from './EmptyState.astro'

interface ListingEntity {
  title: string
  summary: string
  slug: string
  image?: string
  imageAlt?: string
  experienceType?: string
  tourFormat?: string
  bookingRef?: { key?: string }
}

interface TermData {
  name: string
  description: string
  slug: string
  sameAs?: string
}

export interface Props {
  term: TermData
  entities: ListingEntity[]
  entityType: 'experience' | 'tour'
  lang: Lang
  prices?: Map<string, PriceEntry>
}

const { term, entities, entityType, lang, prices } = Astro.props
const t = uiCopy(lang)

// Segment lookup
function getSegment(lang: Lang): string {
  const entry = ROUTE_MAP.find(r => r.entity === entityType)
  return entry?.segments[lang] ?? entityType
}

function entityHref(slug: string): string {
  const seg = getSegment(lang)
  const prefix = lang === 'vi' ? '' : `/${lang}`
  return `${prefix}/${seg}/${slug}/`
}

const tourFormatLabel = TOUR_FORMAT_LABELS[lang] ?? TOUR_FORMAT_LABELS.en

function getBadge(entity: ListingEntity): string | undefined {
  if (entityType === 'experience') return entity.experienceType
  if (entityType === 'tour') return entity.tourFormat ? tourFormatLabel[entity.tourFormat] || entity.tourFormat : undefined
  return undefined
}

function getPriceLabel(entity: ListingEntity): string | undefined {
  if (!entity.bookingRef?.key || !prices) return undefined
  const pv = resolvePrice(entity.bookingRef.key, entityType, undefined, prices, lang)
  return pv?.label
}

const hasEntities = entities.length > 0
const seg = getSegment(lang)
const prefix = lang === 'vi' ? '' : `/${lang}`
const parentLabel = ROUTE_MAP.find(r => r.entity === entityType)?.labels[lang] ?? entityType
const parentHref = `${prefix}/${seg}/`
---

{/* 06 §5.4 — Term listing */}
<div class="term-index">
  <div class="container">
    <nav aria-label={t('breadcrumbAria')} class="term-breadcrumb">
      <a href={prefix || '/'}>{t('breadcrumbHome')}</a>
      <span>/</span>
      <a href={parentHref}>{parentLabel}</a>
      <span>/</span>
      <strong>{term.name}</strong>
    </nav>

    <header class="term-header">
      <h1 class="term-heading">{term.name}</h1>
      <p class="term-definition">{term.description}</p>
      <p class="term-count">{entities.length} {t('results')}</p>
    </header>

    {/* Vùng 3: Lưới card */}
    {hasEntities ? (
      <div class="card-grid">
        {entities.map(entity => (
          <Card
            title={entity.title}
            summary={entity.summary}
            href={entityHref(entity.slug)}
            image={entity.image}
            imageAlt={entity.imageAlt}
            badge={getBadge(entity)}
            badgeVariant="default"
            priceLabel={getPriceLabel(entity)}
          />
        ))}
      </div>
    ) : (
      <EmptyState entityType={entityType} lang={lang} />
    )}
  </div>

  {/* Vùng 4: JSON-LD — phát cả khi 0 entity (I6: mọi trang có JSON-LD);
      termToJsonLd tự bỏ mainEntity khi danh sách rỗng */}
  <script type="application/ld+json" set:html={jsonLdScriptContent(
    termToJsonLd(
      {
        term: { ...term, sameAs: term.sameAs ? [term.sameAs] : undefined },
        entityType,
        entities: entities.map(e => ({ ...e, _type: entityType })),
        lang,
        pagePath: Astro.url.pathname,
      },
      siteBaseUrl(Astro.site)
    )
  )} />
</div>

<style>
  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .term-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    align-items: center;
    padding: var(--s4) 0 0;
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  .term-breadcrumb a {
    color: var(--c-text-muted);
    transition: color var(--m-fast) var(--m-ease);
  }

  .term-breadcrumb a:hover {
    color: var(--c-primary);
  }

  .term-breadcrumb strong {
    color: var(--c-text);
    font-weight: var(--fw-600);
  }

  .term-header {
    background: var(--c-primary);
    color: var(--c-text-inverse);
    border-radius: var(--radius-lg);
    padding: var(--s6);
    margin-top: var(--s4);
    margin-bottom: var(--s7);
    position: relative;
    overflow: hidden;
  }

  .term-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    background: var(--c-sand);
  }

  .term-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-800);
    color: var(--c-text-inverse);
    line-height: var(--lh-heading);
    margin-bottom: var(--s2);
  }

  .term-definition {
    font-size: var(--fs-base);
    color: var(--c-text-inverse);
    opacity: .86;
    max-width: var(--measure, 70ch);
  }

  .term-count {
    font-size: var(--fs-sm);
    color: var(--c-text-inverse);
    opacity: .65;
    margin-top: var(--s3);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s5);
    padding-bottom: var(--s9);
  }

  @media (max-width: 1023px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
