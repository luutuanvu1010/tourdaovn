---
export interface Props {
  title: string;
  summary: string;
  href: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  badgeVariant?: 'default' | 'author' | 'free' | 'past';
  priceLabel?: string;
  authorLabel?: string;
}

const {
  title,
  summary,
  href,
  image,
  imageAlt,
  badge,
  badgeVariant = 'default',
  priceLabel,
  authorLabel,
} = Astro.props;

const badgeClass = badgeVariant === 'author' ? 'badge-author'
  : badgeVariant === 'free' ? 'badge-free'
  : badgeVariant === 'past' ? 'badge-past'
  : 'badge-default';
---

<a href={href} class="card">
  {image ? (
    <div class="card-img-wrap">
      <img
        class="card-img"
        src={image}
        alt={imageAlt || title}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="card-img-wrap card-img-placeholder" aria-hidden="true"></div>
  )}

  <div class="card-body">
    <h5 class="card-title">{title}</h5>
    <p class="card-summary">{summary}</p>

    <div class="card-meta">
      {badge && <span class={`card-badge ${badgeClass}`}>{badge}</span>}
      {authorLabel && <span class="card-author">{authorLabel}</span>}
      {priceLabel && <span class="card-price">{priceLabel}</span>}
    </div>
  </div>
</a>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease),
                border-color var(--m-fast) var(--m-ease);
    text-decoration: none;
    color: inherit;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--c-primary-soft) 55%, transparent), transparent 42%),
      linear-gradient(0deg, color-mix(in srgb, var(--c-sand) 7%, transparent), transparent 34%);
    opacity: .55;
    z-index: 0;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-raised);
    border-color: var(--c-primary);
  }

  .card-img-wrap {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      linear-gradient(135deg, var(--c-primary-soft), var(--c-sand-soft));
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-img-placeholder {
    min-height: var(--s9);
    background:
      linear-gradient(135deg, var(--c-surface-alt), var(--c-primary-soft));
  }

  .card-body {
    position: relative;
    z-index: 1;
    padding: var(--s4);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: var(--fw-700);
    font-size: var(--fs-h5);
    color: var(--c-text);
    margin-bottom: var(--s2);
    line-height: 1.20;
  }

  .card-summary {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--s4);
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex-wrap: wrap;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    padding: var(--s1) var(--s3);
    border-radius: var(--radius-pill);
    font-size: var(--fs-badge);
    font-weight: var(--fw-600);
    font-family: var(--font-ui);
  }

  .badge-default {
    background: var(--c-primary-soft);
    color: var(--c-primary);
  }

  .badge-author {
    background: var(--c-green-soft);
    color: var(--c-green-text);
  }

  .badge-free {
    background: var(--c-green-soft);
    color: var(--c-green-text);
  }

  .badge-past {
    background: var(--c-surface-alt);
    color: var(--c-text-muted);
  }

  .card-author {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    font-weight: var(--fw-500);
  }

  .card-price {
    display: inline-flex;
    align-items: center;
    padding: var(--s1) var(--s3);
    background: var(--c-accent-soft);
    color: var(--c-accent-strong);
    font-size: var(--fs-sm);
    font-weight: var(--fw-700);
    border-radius: var(--radius-sm);
    margin-left: auto;
  }
</style>
