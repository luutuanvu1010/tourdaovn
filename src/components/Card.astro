---
export interface Props {
  title: string;
  summary: string;
  href: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  badgeVariant?: 'default' | 'author' | 'free' | 'past';
  priceLabel?: string;
  authorLabel?: string;
}

const {
  title,
  summary,
  href,
  image,
  imageAlt,
  badge,
  badgeVariant = 'default',
  priceLabel,
  authorLabel,
} = Astro.props;

const badgeClass = badgeVariant === 'author' ? 'badge-author'
  : badgeVariant === 'free' ? 'badge-free'
  : badgeVariant === 'past' ? 'badge-past'
  : 'badge-default';
---

<a href={href} class="card">
  {image ? (
    <div class="card-img-wrap">
      <img
        class="card-img"
        src={image}
        alt={imageAlt || title}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="card-img-wrap card-img-placeholder" aria-hidden="true"></div>
  )}

  <div class="card-body">
    <h5 class="card-title">{title}</h5>
    <p class="card-summary">{summary}</p>

    <div class="card-meta">
      {badge && <span class={`card-badge ${badgeClass}`}>{badge}</span>}
      {authorLabel && <span class="card-author">{authorLabel}</span>}
      {priceLabel && <span class="card-price">{priceLabel}</span>}
    </div>
  </div>
</a>

<style>
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease),
                border-color var(--m-fast) var(--m-ease);
    text-decoration: none;
    color: inherit;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--c-primary-soft) 55%, transparent), transparent 42%),
      linear-gradient(0deg, color-mix(in srgb, var(--c-sand) 7%, transparent), transparent 34%);
    opacity: .55;
    z-index: 0;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-raised);
    border-color: var(--c-primary);
  }

  .card-img-wrap {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      linear-gradient(135deg, var(--c-primary-soft), var(--c-sand-soft));
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-img-placeholder {
    min-height: var(--s9);
    background:
      linear-gradient(135deg, var(--c-surface-alt), var(--c-primary-soft));
  }

  .card-body {
    position: relative;
    z-index: 1;
    padding: var(--s4);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: var(--fw-700);
    /* Dùng đúng token của chính nó thay vì mượn --fs-h5. Trước đây hai thứ cùng
       20px nên không ai thấy sự nhầm vai; nay --fs-card-title lên 21px và h5 vẫn
       20px, mượn nhầm sẽ làm thẻ không nhận được đợt giãn thang. */
    font-size: var(--fs-card-title);
    color: var(--c-text);
    margin-bottom: var(--s2);
    line-height: 1.20;
    letter-spacing: -0.01em;
  }

  .card-summary {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--s4);
    /* KHÔNG flex:1 ở đây: -webkit-line-clamp chỉ cắt đúng khi hộp cao bằng hai dòng.
       Trước đây flex:1 kéo hộp cao hơn khi thẻ không có huy hiệu, trình duyệt vẽ "…"
       ở dòng 2 rồi vẫn lòi dòng 3 — DR-038. Phần co giãn chuyển sang .card-meta. */
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    padding: var(--s1) var(--s3);
    border-radius: var(--radius-pill);
    font-size: var(--fs-badge);
    font-weight: var(--fw-600);
    font-family: var(--font-ui);
  }

  .badge-default {
    background: var(--c-primary-soft);
    color: var(--c-primary);
  }

  .badge-author {
    background: var(--c-green-soft);
    color: var(--c-green-text);
  }

  .badge-free {
    background: var(--c-green-soft);
    color: var(--c-green-text);
  }

  .badge-past {
    background: var(--c-surface-alt);
    color: var(--c-text-muted);
  }

  .card-author {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    font-weight: var(--fw-500);
  }

  .card-price {
    display: inline-flex;
    align-items: center;
    padding: var(--s1) var(--s3);
    background: var(--c-accent-soft);
    color: var(--c-accent-strong);
    /* Giá phải bật lên gần ngang tiêu đề thẻ — đây là trang bán tour. Tăng trong
       khuôn huy hiệu sẵn có thay vì đổi sang chữ trần, để không phá ngôn ngữ thẻ. */
    font-size: var(--fs-base);
    font-weight: var(--fw-800);
    border-radius: var(--radius-sm);
    margin-left: auto;
  }

  /* SPEC-2026-08-29 R1 — thẻ ngang ở khổ điện thoại.
     Ảnh 4:3 trên thẻ full-width cho ô ảnh cao 267px, biến mỗi thẻ thành một tấm
     poster; 16 thẻ ăn 6.560px, một phần ba trang chủ. Tỷ lệ 4:3 là tỷ lệ của lưới
     NHIỀU cột — khi lưới sập còn một cột nó thành hệ quả phụ, không phải lựa chọn.
     Vẫn hợp Luật 5 (06 §6): mỗi thẻ một hàng, chiếm trọn bề ngang. */
  @media (max-width: 640px) {
    .card {
      display: grid;
      /* Track 1 phải chứa CẢ lề trái của ảnh, không chỉ bề rộng ảnh: .card-img-wrap
         bên dưới mang width:88px + margin-left:var(--s3), tức hộp thật rộng
         88+12=100px. Track chỉ 88px thì hộp tràn 12px sang track 2 và ăn đúng
         12px đệm trái của .card-body — rãnh giữa ảnh và tiêu đề còn 0px. Nới
         track bằng calc() từ token thay vì đổi lề, để giữ đúng nhịp 12px quanh
         ảnh mà không cần số trần mới. */
      grid-template-columns: calc(var(--s3) + 88px) 1fr;
      align-items: start;
    }

    .card-img-wrap {
      width: 88px;
      height: 88px;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-sm);
      margin: var(--s3) 0 var(--s3) var(--s3);
    }

    /* min-height: var(--s9) (96px) ở luật gốc (:110) sống sót tới đây và thắng
       height:88px bằng box model (min-height lớn hơn height thì min-height thắng),
       không phải bằng đặc hiệu — CSS hợp lệ, không phải bug đặc hiệu như R1.
       Reset về đúng 88px (ngoại lệ thumbnail đã duyệt) để ba ô ảnh chờ không cao
       hơn ảnh thật 8px. */
    .card-img-placeholder {
      min-height: 88px;
    }

    .card-body {
      padding: var(--s3);
    }

    .card-summary {
      margin-bottom: var(--s2);
    }
  }
</style>
