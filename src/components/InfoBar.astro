---
export interface InfoBarItem {
  /** Tên field trong 01-CONTENT_MODEL nuôi ô này. Bộ kiểm Luật 1 đếm theo đây,
   *  không đếm theo `label` hay `value` — 06 v2.2 N11: luật ràng buộc field,
   *  không ràng buộc chuỗi. Vùng giá dùng tên quy ước 'gia'. */
  field: string
  icon: string
  label: string
  value: string
  visible: boolean
}

export interface Props {
  items: InfoBarItem[]
}

const { items } = Astro.props
const visible = items.filter(i => i.visible)
// Lưới co theo số ô THẬT. Trước đây lưới cố định 4 cột và ô ẩn dùng
// `display:none`, nên ba ô có dữ liệu vẫn để hở một cột. Bốn là trần vì quá
// bốn ô một hàng thì chữ bị bóp.
const cols = Math.min(visible.length, 4)
---

{visible.length > 0 && (
  <section class="info-bar">
    <div class="container">
      <div class="info-bar-grid" style={`--info-cols:${cols}`} data-region="info-bar">
        {visible.map((item) => (
          <div class="info-slot" data-field={item.field}>
            <span class="info-icon" aria-hidden="true">{item.icon}</span>
            <div class="info-text">
              <span class="info-label">{item.label}</span>
              <span class="info-value">{item.value}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .info-bar {
    padding: 0 0 var(--s4);
  }

  .info-bar-grid {
    display: grid;
    grid-template-columns: repeat(var(--info-cols, 4), 1fr);
    gap: var(--s3);
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--s4);
  }

  .info-slot {
    display: flex;
    align-items: flex-start;
    text-align: left;
    gap: var(--s2);
    min-width: 0;
  }

  .info-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex: none;
  }

  .info-label {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: var(--fw-500);
    color: var(--c-text-muted);
  }

  .info-value {
    display: -webkit-box;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: var(--fw-700);
    margin-top: 2px;
    color: var(--c-text);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1023px) {
    .info-bar-grid {
      grid-template-columns: repeat(min(var(--info-cols, 4), 2), 1fr);
    }
  }
</style>
