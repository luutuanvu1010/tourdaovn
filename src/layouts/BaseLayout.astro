---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import { brand } from '../site.config';
import { siteBaseUrl } from '../lib/siteUrl';
import { fetchSiteTheme, themeSurface } from '../lib/siteTheme';
import { fetchSiteBranding } from '../lib/siteBranding';
import { imageUrl, isSvg } from '../lib/sanity-image';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  currentPath?: string;
  alternates?: Record<string, string>;
  ogImage?: string;
  ogType?: string;
}

const { title, description, lang = 'vi', currentPath = '/', alternates, ogImage, ogType = 'website' } = Astro.props;

// hreflang (G5 defect, overlay S2.5 / URL_MAP §1c R4): khi có `alternates` (trang detail
// có bản dịch thật, track QĐ3), phát reciprocal cho từng lang có mặt trong alternates +
// x-default trỏ bản vi. Không có alternates (index/hub hoặc chưa có bản dịch) → giữ
// self-referential tối thiểu cho trang vi như cũ, không phát hreflang trỏ trang không tồn tại.
const siteBase = siteBaseUrl(Astro.site);
const pathWithSlash = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const selfUrl = siteBase + pathWithSlash;

// Bộ giao diện chọn trong Sanity Studio (siteSettings.theme). Giá trị lạ hoặc
// trống → bộ mặc định, trang vẫn dựng. Xem 07-DESIGN_TOKENS §1b.
const theme = await fetchSiteTheme();

// Ảnh nhận diện tải lên trong Studio (siteSettings.branding) — 06-BINDING_MAP §2.
const branding = await fetchSiteBranding();

// ── Favicon ──
// Chưa tải lên thì rơi về /favicon.svg trong public/. File đó BẮT BUỘC phải tồn
// tại: trước 2026-08-14 hai dòng <link> dưới đây trỏ vào hư không, favicon 404
// trên mọi trang mà không cổng nào bắt được.
const faviconSrc = imageUrl(branding?.favicon, { width: 64 });
const faviconHref = faviconSrc ?? '/favicon.svg';
const faviconType = faviconSrc && !isSvg(branding?.favicon) ? undefined : 'image/svg+xml';
// apple-touch-icon phải là ảnh raster — iOS không đọc SVG. Favicon raster thì ép
// PNG 180px; SVG hoặc chưa tải thì giữ file dự phòng (iOS bỏ qua, không hỏng gì).
const appleTouchHref =
  branding?.favicon && !isSvg(branding.favicon)
    ? imageUrl(branding.favicon, { width: 180, format: 'png', autoFormat: false })!
    : '/favicon.svg';

// ── Ảnh chia sẻ mạng xã hội ──
// Prop `ogImage` của từng trang THẮNG: ảnh riêng của một tour sát nội dung hơn
// ảnh chung. Ảnh chung chỉ đỡ những trang không có ảnh riêng — trước đây các
// trang đó dán lên Facebook/Zalo ra thẻ trắng.
const fallbackOgImage = imageUrl(branding?.ogImage, { width: 1200, height: 630, fit: 'crop' });
const shareImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : siteBase + ogImage)
  : fallbackOgImage;
const shareImageAlt = ogImage ? undefined : branding?.ogImage?.alt;
---

<!DOCTYPE html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Màu thanh địa chỉ di động = nền trang của bộ đang bật, đọc từ tokens.css.
        Trước đây viết cứng #C2410C — accent của site cũ, không có trong token nào (DR-037).
        Lấy nền chứ không lấy accent vì thanh địa chỉ nằm sát header nền trắng. */}
    <meta name="theme-color" content={themeSurface(theme)} />
    <link rel="icon" href={faviconHref} type={faviconType} />
    <link rel="apple-touch-icon" href={appleTouchHref} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={selfUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : lang === 'en' ? 'en_US' : lang === 'zh' ? 'zh_CN' : lang === 'ko' ? 'ko_KR' : 'ru_RU'} />
    <meta property="og:site_name" content={brand.name} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImageAlt && <meta property="og:image:alt" content={shareImageAlt} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <link rel="canonical" href={selfUrl} />

    {alternates ? (
      <Fragment>
        {Object.entries(alternates).map(([code, href]) => (
          <link rel="alternate" hreflang={code} href={siteBase + href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternates.vi ? siteBase + alternates.vi : selfUrl} />
      </Fragment>
    ) : (
      lang === 'vi' && (
        <Fragment>
          <link rel="alternate" hreflang="vi" href={selfUrl} />
          <link rel="alternate" hreflang="x-default" href={selfUrl} />
        </Fragment>
      )
    )}

    {/* Preload đúng một file: Nunito latin-viet, tức chữ THÂN BÀI.
        Tiêu đề dùng Be Vietnam Pro (xem chú thích @font-face dưới) và hiện
        KHÔNG được preload. DR-052 nêu đây là ứng viên cho nợ LCP nhưng ghi rõ
        "chưa đo, nên là việc phải kiểm, không phải kết luận" — nên chưa đụng
        vào dòng này. Đóng cùng lượt R5 sau khi đo LCP thật. */}
    <link rel="preload" href="/fonts/nunito-latin-viet-var.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      /* HAI VAI, HAI BỘ — sửa 2026-08-24, đóng DR-052.
         Be Vietnam Pro là chữ TIÊU ĐỀ (--font-display), không phải lớp dự phòng:
         SPEC-2026-08-14-be-mat-vong-3 §3.1 đảo thứ tự ở --font-display.
         Nunito là chữ THÂN BÀI và giao diện (--font-ui), biến thiên 400–800 nên
         hai file phủ mọi cấp đậm.
         Lora và Plus Jakarta Sans đã gỡ: không còn chỗ nào gọi tới chúng.

         Ba câu chú thích cũ ở đây khai ngược ("Nunito — MỘT chữ cho cả trang",
         "Be Vietnam Pro ở lại làm lớp dự phòng duy nhất", "chỉ 2 file") — sai từ
         2026-08-14, ghi ở DR-052. Thư mục có SÁU file, không phải hai. */
      @font-face {
        font-family: 'Nunito';
        src: url('/fonts/nunito-latin-viet-var.woff2') format('woff2');
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Nunito';
        src: url('/fonts/nunito-vietnamese-var.woff2') format('woff2');
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-latin-viet-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-vietnamese-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      /* Cấp 800 — thêm 2026-08-24, đóng DR-052.
         Hai file này đã nằm trong public/fonts/ và đã lên dist/ từ trước, chỉ là
         chưa bao giờ được khai. Hệ quả cũ: ≥12 component xin --fw-800 trên
         --font-display, trình duyệt chỉ thấy mặt 700 nên TỔNG HỢP GIẢ cấp đậm —
         nét dày không đều, và dấu tiếng Việt ở cỡ nhỏ bị bết.
         Chi phí THẬT: khai hai khối này làm trình duyệt tải THÊM 18.524 byte
         (13.380 latin-viet + 5.144 vietnamese). Trước đây hai file nằm trong
         dist/ nhưng KHÔNG luật CSS nào trỏ tới, nên không trình duyệt nào tải —
         chúng tốn băng thông triển khai, không tốn băng thông của khách.
         Một trang tiếng Việt dùng cả hai cấp nay tải 89.196 byte thay vì 70.672.
         Vẫn dưới trần R4 (140 KB payload). Đây là đánh đổi BYTE lấy ĐỘ ĐẬM THẬT,
         không phải bữa trưa miễn phí. */
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-latin-viet-800.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-vietnamese-800.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      .container {
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--s5);
      }
      @media (max-width: 480px) {
        .container {
          padding-inline: var(--s4);
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} lang={lang} alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
