---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  currentPath?: string;
  alternates?: Record<string, string>;
  ogImage?: string;
  ogType?: string;
}

const { title, description, lang = 'vi', currentPath = '/', alternates, ogImage, ogType = 'website' } = Astro.props;

// hreflang (G5 defect, overlay S2.5 / URL_MAP §1c R4): khi có `alternates` (trang detail
// có bản dịch thật, track QĐ3), phát reciprocal cho từng lang có mặt trong alternates +
// x-default trỏ bản vi. Không có alternates (index/hub hoặc chưa có bản dịch) → giữ
// self-referential tối thiểu cho trang vi như cũ, không phát hreflang trỏ trang không tồn tại.
const siteBase = (Astro.site?.toString() ?? 'https://tourdaovn.vn').replace(/\/$/, '');
const pathWithSlash = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const selfUrl = siteBase + pathWithSlash;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#C2410C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={selfUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : lang === 'en' ? 'en_US' : lang === 'zh' ? 'zh_CN' : lang === 'ko' ? 'ko_KR' : 'ru_RU'} />
    <meta property="og:site_name" content="Nha Trang Travel" />
    {ogImage && <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : siteBase + ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : siteBase + ogImage} />}

    <link rel="canonical" href={selfUrl} />

    {alternates ? (
      <Fragment>
        {Object.entries(alternates).map(([code, href]) => (
          <link rel="alternate" hreflang={code} href={siteBase + href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternates.vi ? siteBase + alternates.vi : selfUrl} />
      </Fragment>
    ) : (
      lang === 'vi' && (
        <Fragment>
          <link rel="alternate" hreflang="vi" href={selfUrl} />
          <link rel="alternate" hreflang="x-default" href={selfUrl} />
        </Fragment>
      )
    )}

    <link rel="preload" href="/fonts/be-vietnam-pro-latin-viet-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-viet-500.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-latin-viet-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-vietnamese-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-latin-viet-800.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Be Vietnam Pro';
        src: url('/fonts/be-vietnam-pro-vietnamese-800.woff2') format('woff2');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-latin-viet-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-vietnamese-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-latin-viet-600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-vietnamese-600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-latin-viet-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        src: url('/fonts/plus-jakarta-sans-vietnamese-700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      .container {
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--s5);
      }
      @media (max-width: 480px) {
        .container {
          padding-inline: var(--s4);
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} lang={lang} alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
