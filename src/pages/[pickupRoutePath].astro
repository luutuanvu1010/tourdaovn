---
// Trang lộ trình đón khách — bản đồ + bảng giờ đón.  URL: /lo-trinh-don-khach/
//
// ─────────────────────────────────────────────────────────────────────────────
// TẠI SAO TÊN FILE LẠI CÓ NGOẶC VUÔNG?
// ─────────────────────────────────────────────────────────────────────────────
// Vì trang này đang ở CHẾ ĐỘ PHÁT TRIỂN (site.config §5) — xem được bằng
// `npm run dev` nhưng không được có mặt trong bản production.
//
// Astro chỉ cho phép quyết định "có sinh trang này không" ở route ĐỘNG, qua
// getStaticPaths. Với file tĩnh tên `lo-trinh-don-khach.astro` thì trang LUÔN
// được sinh, không có cách nào chặn — nên dù không ai link tới, địa chỉ vẫn tồn
// tại trên site thật. Đặt tên động là cách duy nhất để cờ tắt có hiệu lực thật.
//
// Không đụng gì tới [...path].astro: ở chế độ static mỗi route tự sinh file từ
// getStaticPaths của chính nó, mà 'lo-trinh-don-khach' không nằm trong danh sách
// slug của [...path].astro, nên không có chuyện hai route ghi đè nhau.
//
// Khi chốt cho lên production: bật cờ trong site.config §5. Muốn dọn hẳn tên file
// động thì đổi lại thành `lo-trinh-don-khach.astro` và bỏ getStaticPaths.
// ─────────────────────────────────────────────────────────────────────────────
//
// Nguồn dữ liệu duy nhất: siteSettings.pickupPoints (CONTENT_MODEL §2.15 v1.0.13).
// Cấm hardcode danh sách điểm đón tại đây.
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import RouteMap from '../components/RouteMap.astro'
import { getClient } from '../lib/sanity'
import { siteSettingsQuery } from '../lib/queries'
import { jsonLdScriptContent } from '../lib/serialize/utils'
import { siteBaseUrl } from '../lib/siteUrl'
import { brand, devPages, isDevPageBuilt } from '../site.config'
import type { SiteSettingsResult, PickupPoint } from '../lib/types'

const SLUG = 'lo-trinh-don-khach'

export function getStaticPaths() {
  // Cờ tắt và đang build production → mảng rỗng → Astro không sinh trang nào.
  if (!isDevPageBuilt('lo-trinh-don-khach')) return []
  return [{ params: { pickupRoutePath: 'lo-trinh-don-khach' } }]
}

const PATH = `/${SLUG}/`

const config: SiteSettingsResult | null = await getClient().fetch(siteSettingsQuery())

// Guard rỗng là cổng cứng, cùng quy tắc với section trang chủ: điểm bị ẩn không render ở
// bất kỳ đâu; không có điểm nào thì trang vẫn lên nhưng nói rõ đang cập nhật, không để
// khung bản đồ trống gây hiểu nhầm là lỗi.
const allPoints: PickupPoint[] = config?.pickupPoints ?? []
const points = allPoints.filter((p) => !p.hidden)
const hasPoints = points.length > 0
const mappable = points.filter(
  (p) => typeof p.geo?.lat === 'number' && typeof p.geo?.lng === 'number'
)

const contact = config?.contact ?? null
const hotlineHref = contact?.hotline ? `tel:${contact.hotline.replace(/\s+/g, '')}` : null

const metaTitle = `Lộ trình đón khách — ${brand.name}`
const metaDescription = hasPoints
  ? `Danh sách ${points.length} điểm đón khách và giờ đón của ${brand.legalName}, kèm bản đồ lộ trình xe đưa đón.`
  : `Điểm đón khách và giờ đón của ${brand.legalName}.`

const siteBase = siteBaseUrl(Astro.site)
const pageUrl = siteBase.replace(/\/$/, '') + PATH

// Dải cảnh báo "đang phát triển" chỉ hiện khi xem bằng `npm run dev` mà cờ còn tắt.
// Không cần thẻ noindex: cờ tắt thì bản production không hề có trang này, còn cờ bật thì
// ta muốn Google đánh chỉ mục.
const isPreview = import.meta.env.DEV && !devPages['lo-trinh-don-khach']

// JSON-LD: mô tả trang, không mô tả chuyến đi. Không dùng @type Trip vì lộ trình đón
// khách là khâu vận hành chung, không phải một tour bán được — gán Trip sẽ tạo thực thể
// thương mại không có giá, sai vai (I1, I6).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: metaTitle,
    description: metaDescription,
    inLanguage: 'vi',
    isPartOf: { '@id': `${siteBase.replace(/\/$/, '')}/#website` },
  },
]
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  lang="vi"
  currentPath={PATH}
>
  <script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)} />

  <Section heading="Lộ trình đón khách">
    {isPreview && (
      <p class="preview-flag">
        Trang đang ở chế độ phát triển — chưa công bố. Bật ở <code>src/site.config.ts</code> mục 5.
      </p>
    )}

    <p class="lead">
      Xe đưa đón dừng lần lượt tại các điểm dưới đây. Bấm vào số trên bản đồ để xem
      giờ đón và vị trí đứng chờ.
    </p>

    {mappable.length > 0 && <RouteMap points={points} height={440} />}

    {hasPoints ? (
      <div class="stops">
        <h3 class="stops-title">Bảng giờ đón</h3>
        <ol class="stop-list">
          {points.map((p, i) => (
            <li class="stop">
              <span class="stop-num" aria-hidden="true">{i + 1}</span>
              <div class="stop-body">
                <p class="stop-name">{p.stopName || `Điểm đón ${i + 1}`}</p>
                {p.stopAddress && <p class="stop-addr">{p.stopAddress}</p>}
                {p.pickupNote && <p class="stop-note">{p.pickupNote}</p>}
              </div>
              {p.pickupTime && <span class="stop-time">{p.pickupTime}</span>}
            </li>
          ))}
        </ol>
        <p class="stops-hint">
          Vui lòng có mặt trước giờ đón 5 phút. Giờ đón có thể thay đổi theo tình hình
          giao thông{hotlineHref ? ' — gọi hotline để xác nhận trước khi khởi hành.' : '.'}
        </p>
        {hotlineHref && (
          <a class="stops-cta" href={hotlineHref}>Gọi {contact?.hotline}</a>
        )}
      </div>
    ) : (
      <p class="empty">
        Lộ trình đón khách đang được cập nhật.
        {hotlineHref && (
          <Fragment> Vui lòng <a href={hotlineHref}>gọi {contact?.hotline}</a> để được hướng dẫn điểm đón.</Fragment>
        )}
      </p>
    )}
  </Section>
</BaseLayout>

<style>
  .preview-flag {
    margin: 0 0 var(--s5);
    padding: var(--s3) var(--s4);
    border: 1px dashed var(--c-accent);
    border-radius: var(--radius-sm);
    background: var(--c-accent-soft);
    color: var(--c-accent-strong);
    font-size: var(--fs-sm);
  }

  .preview-flag code {
    font-size: 0.95em;
  }

  .lead {
    max-width: 62ch;
    margin: 0 0 var(--s5);
    color: var(--c-text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  .stops {
    margin-top: var(--s6);
  }

  .stops-title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    margin: 0 0 var(--s4);
  }

  .stop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--c-card);
  }

  .stop {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s4);
    border-bottom: 1px solid var(--c-border);
  }

  .stop:last-child {
    border-bottom: 0;
  }

  .stop-num {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-size: var(--fs-label);
    font-weight: 700;
  }

  .stop-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .stop-name {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--c-text);
  }

  .stop-addr,
  .stop-note {
    margin: var(--s1) 0 0;
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  .stop-note {
    font-style: italic;
  }

  .stop-time {
    flex: 0 0 auto;
    align-self: center;
    padding: var(--s1) var(--s3);
    border-radius: var(--radius-pill);
    background: var(--c-primary-soft);
    color: var(--c-primary);
    font-size: var(--fs-label);
    font-weight: 600;
    white-space: nowrap;
  }

  .stops-hint {
    margin: var(--s4) 0 0;
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-body);
  }

  .stops-cta {
    display: inline-flex;
    align-items: center;
    margin-top: var(--s4);
    padding: var(--s3) var(--s5);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    font-weight: 600;
    border-radius: var(--radius-pill);
    transition: background var(--m-fast) var(--m-ease);
  }

  .stops-cta:hover {
    background: var(--c-accent-strong);
  }

  .empty {
    margin: 0;
    color: var(--c-text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  @media (max-width: 640px) {
    .stop {
      flex-wrap: wrap;
    }

    .stop-time {
      margin-left: calc(28px + var(--s3));
      align-self: flex-start;
    }
  }
</style>
